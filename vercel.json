{
  "buildCommand": "npm run build",
  "installCommand": "npm install",
  "framework": "nextjs",
  "crons": [
    {
      "path": "/api/deadline-checker?action=check-reminders",
      "schedule": "45-59 16 * * 1-6"
    },
    {
      "path": "/api/deadline-checker?action=check-reminders",
      "schedule": "0-59 17 * * 1-6"
    },
    {
      "path": "/api/deadline-checker?action=check-deadlines",
      "schedule": "0 18 * * 1-6"
    },
    {
      "path": "/api/deadline-checker?action=check-reminders",
      "schedule": "45 7 * * 1-6"
    },
    {
      "path": "/api/deadline-checker?action=check-reminders",
      "schedule": "0-14 8 * * 1-6"
    },
    {
      "path": "/api/deadline-checker?action=check-deadlines",
      "schedule": "15 8 * * 1-6"
    },
    {
      "path": "/api/deadline-checker?action=check-reminders",
      "schedule": "45-59 15 * * 6"
    },
    {
      "path": "/api/deadline-checker?action=check-reminders",
      "schedule": "0-59 16 * * 6"
    },
    {
      "path": "/api/deadline-checker?action=check-deadlines",
      "schedule": "0 17 * * 6"
    },
    {
      "_comment": "Emergency alerts that nobody answered. Runs all day and all night, because emergencies do not keep office hours, and because escalation to the CMD is time-based: six hours unanswered. A checker that only ran on weekday afternoons would let a Saturday night alert age past escalation unnoticed.",
      "path": "/api/deadline-checker?action=check-emergency-alerts",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/maintenance/prune-location-pings",
      "schedule": "30 2 * * *"
    },
    {
      "path": "/api/maintenance/detect-delays",
      "schedule": "*/5 5-18 * * *"
    },
    {
      "path": "/api/maintenance/preop-alerts",
      "schedule": "*/5 4-18 * * *"
    }
  ]
}
