# =============================================================================
# ORM behind nginx on the hospital LAN, reached by name instead of by IP.
# -----------------------------------------------------------------------------
# Installed by scripts/local-server/setup-hostname.sh, which substitutes
# __SERVER_NAME__ and __UPSTREAM_PORT__. Edit this template, not the copy in
# /etc/nginx, or the next run will overwrite your changes.
# =============================================================================

server {
    listen 80;
    listen [::]:80;
    server_name __SERVER_NAME__;

    # Consent forms and imprest documents are held as base64 data URLs, so
    # request bodies are far larger than nginx's 1 MB default. One scanned
    # consent exceeds it easily, and the failure is a 413 that reads as the app
    # rejecting the upload rather than the proxy in front of it.
    client_max_body_size 64m;

    # PDF generation and the heavier reports are slow by nature.
    proxy_read_timeout 300s;
    proxy_send_timeout 300s;

    # ---- Emergency display: Server-Sent Events ------------------------------
    # This endpoint holds a long-lived stream open. nginx buffers proxied
    # responses by default, which would withhold each announcement until a
    # buffer filled or the connection closed — so the emergency board would
    # connect successfully, look healthy, and display nothing. Buffering must be
    # off here, and the read timeout must not cut the stream every 5 minutes.
    location = /api/emergency-display/stream {
        proxy_pass http://127.0.0.1:__UPSTREAM_PORT__;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";

        proxy_buffering off;
        proxy_cache off;
        chunked_transfer_encoding off;
        proxy_read_timeout 24h;
    }

    # ---- Everything else ----------------------------------------------------
    location / {
        proxy_pass http://127.0.0.1:__UPSTREAM_PORT__;
        proxy_http_version 1.1;

        # Host must be passed through unchanged. NextAuth and any absolute URL
        # the app builds derive from it, and a rewritten Host produces redirects
        # back to the wrong origin — which costs the session.
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header Connection "";
    }

    # Next.js fingerprints these filenames, so the BROWSER can cache them hard.
    # No proxy_cache here on purpose: without a proxy_cache_path zone defined in
    # the http block, cache directives are silently inert, and a setting that
    # looks like it is doing something is worse than none.
    location /_next/static/ {
        proxy_pass http://127.0.0.1:__UPSTREAM_PORT__;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Connection "";
        add_header Cache-Control "public, max-age=31536000, immutable";
    }
}
