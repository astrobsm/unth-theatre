  subStore         TheatreSubStore @relation(fields: [subStoreId], references: [id], onDelete: Cascade)
  theatreNumber    String
  theatreName      String?
  ownerRole        String // owner sub-store role
  itemName         String
  faultType        String // FAULTY, BROKEN, EXPIRED, MISSING, OTHER
  severity         String          @default("MEDIUM") // LOW | MEDIUM | HIGH | CRITICAL
  description      String
  status           String          @default("REPORTED") // REPORTED | ACKNOWLEDGED | IN_PROGRESS | RESOLVED
  reportedById     String
  reportedAt       DateTime        @default(now())
  acknowledgedById String?
  acknowledgedAt   DateTime?
  resolvedById     String?
  resolvedAt       DateTime?
  resolution       String?
  alertsSentTo     String? // JSON: array of userIds notified
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([subStoreId])
  @@index([status])
  @@map("sub_store_item_faults")
}

// Sub-store consumable usage log - tracks items used during surgeries
model SubStoreUsageLog {
  id String @id @default(uuid())

  // Sub-store item reference
  subStoreId String
  subStore   TheatreSubStore @relation(fields: [subStoreId], references: [id])

  // Theatre info
  theatreNumber String
  theatreName   String?

  // Surgery/Case info
  surgeryId           String?
  patientName         String?
  patientFolderNumber String?
  procedureName       String?

  // Usage details
  itemName            String
  quantityUsed        Int
  quantityReturned    Int    @default(0)
  quantityWasted      Int    @default(0)
  netQuantityConsumed Int? // Calculated: used - returned

  // Waste tracking
  wasteReason String?

  // Staff
  usedById   String
  usedBy     User   @relation("UsageLoggedBy", fields: [usedById], references: [id])
  usedByName String

  // Timing
  usedAt     DateTime  @default(now())
  returnedAt DateTime?

  // Verification
  verifiedById String?
  verifiedBy   User?     @relation("UsageVerifiedBy", fields: [verifiedById], references: [id])
  verifiedAt   DateTime?

  // Notes
  usageNotes  String?
  returnNotes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("sub_store_usage_logs")
}

// Restock requests from scrub nurse to theatre manager
model SubStoreRestockRequest {
  id String @id @default(uuid())

  // Request reference
  requestNumber String @unique

  // Theatre/Store info
  theatreNumber String
  theatreName   String?

  // Urgency
  urgency String @default("NORMAL") // LOW, NORMAL, HIGH, CRITICAL

  // Status
  status String @default("PENDING") // PENDING, APPROVED, FULFILLED, PARTIALLY_FULFILLED, REJECTED

  // Requested By (Scrub Nurse)
  requestedById String
  requestedBy   User     @relation("RestockRequester", fields: [requestedById], references: [id])
  requestedAt   DateTime @default(now())
  requestNotes  String?

  // Items requested (JSON array)
  itemsRequested String // JSON: [{itemName, quantity, currentStock, reason}]

  // Approval (Theatre Manager)
  approvedById    String?
  approvedBy      User?     @relation("RestockApprover", fields: [approvedById], references: [id])
  approvedAt      DateTime?
  approvalNotes   String?
  rejectionReason String?

  // Fulfillment
  fulfilledById    String?
  fulfilledBy      User?     @relation("RestockFulfiller", fields: [fulfilledById], references: [id])
  fulfilledAt      DateTime?
  itemsFulfilled   String? // JSON: [{itemName, quantityFulfilled}]
  fulfillmentNotes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("sub_store_restock_requests")
}

model StockTransfer {
  id String @id @default(uuid())

  transferDate DateTime @default(now())

  // Transfer type
  transferType String @default("MAIN_TO_SUBSTORE") // MAIN_TO_SUBSTORE, SUBSTORE_TO_SUBSTORE

  // Source (main store or another sub-store)
  fromMainStore       Boolean @default(true)
  sourceInventoryId   String? // Main store inventory item ID (when from main store)
  fromSubStoreId      String? // Source sub-store ID (for inter-substore transfers)
  sourceTheatreNumber String? // Source theatre number (for inter-substore transfers)

  // Destination (sub-store)
  toSubStoreId      String
  toSubStore        TheatreSubStore @relation(fields: [toSubStoreId], references: [id])
  destTheatreNumber String? // Destination theatre number

  itemName            String
  quantityTransferred Int
  unit                String

  // Authorization
  requestedById String
  requestedBy   User   @relation("TransferRequester", fields: [requestedById], references: [id])

  approvedById String?
  approvedBy   User?     @relation("TransferApprover", fields: [approvedById], references: [id])
  approvedAt   DateTime?

  issuedById String?
  issuedBy   User?     @relation("TransferIssuer", fields: [issuedById], references: [id])
  issuedAt   DateTime?

  receivedById String?
  receivedBy   User?     @relation("TransferReceiver", fields: [receivedById], references: [id])
  receivedAt   DateTime?

  status String // REQUESTED, APPROVED, ISSUED, RECEIVED, CANCELLED

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("stock_transfers")
}

model PreoperativeInvestigation {
  id String @id @default(uuid())

  // Patient and surgery details
  surgeryId String
  surgery   Surgery @relation(fields: [surgeryId], references: [id])

  patientId String
  patient   Patient @relation(fields: [patientId], references: [id])

  // Investigation details
  testName     String // FBC, U&E, Chest X-ray, etc.
  testCategory String // HEMATOLOGY, BIOCHEMISTRY, RADIOLOGY, MICROBIOLOGY, etc.

  urgency InvestigationUrgency
  status  InvestigationStatus  @default(REQUESTED)

  // Requester
  requestedById String
  requestedBy   User     @relation("InvestigationRequester", fields: [requestedById], references: [id])
  requestedAt   DateTime @default(now())

  requestReason String? // Clinical indication

  // Laboratory processing
  sampleCollected     Boolean   @default(false)
  sampleCollectedAt   DateTime?
  sampleCollectedById String?
  sampleCollectedBy   User?     @relation("SampleCollector", fields: [sampleCollectedById], references: [id])

  receivedByLabAt  DateTime?
  processedByLabAt DateTime?

  // Results
  resultsAvailable   Boolean   @default(false)
  resultsAvailableAt DateTime?
  resultValue        String? // Test result
  resultUnit         String?
  referenceRange     String?

  abnormalResult Boolean @default(false)
  criticalResult Boolean @default(false)

  // Verification
  verifiedById String?
  verifiedBy   User?     @relation("ResultsVerifier", fields: [verifiedById], references: [id])
  verifiedAt   DateTime?

  // Report
  reportAttachment String? // File path or URL

  labComments      String?
  clinicalComments String?

  // Surgery readiness impact
  clearedForSurgery Boolean @default(false)

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Sync metadata, maintained by the capture trigger in the sync migration.
  /// Declared here ONLY so `prisma migrate diff` does not read these columns as
  /// drift and generate a DROP for them. Application code must never write
  /// them: the trigger owns them.
  syncVersion Int     @default(0) @map("sync_version")
  syncOrigin  String? @map("sync_origin")
  syncHlc     String? @map("sync_hlc")

  @@map("preoperative_investigations")
}

model TheatreMeal {
  id String @id @default(uuid())

  mealDate DateTime @default(now())
  mealType String // BREAKFAST, LUNCH, DINNER, SNACK

  // Auto-generated from logged-in staff
  staffMemberName String
  staffMemberRole String
  staffMemberId   String?
  staffMember     User?   @relation(fields: [staffMemberId], references: [id])

  // Meal status
  mealRequested Boolean   @default(true)
  mealServed    Boolean   @default(false)
  mealServedAt  DateTime?

  // Special requirements
  dietaryRestrictions String? // Vegetarian, Halal, Allergies, etc.
  specialRequest      String?

  // Cafeteria tracking
  preparedById String?
  preparedBy   User?   @relation("MealPreparer", fields: [preparedById], references: [id])

  confirmed   Boolean   @default(false)
  confirmedAt DateTime?

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Sync metadata, maintained by the capture trigger in the sync migration.
  /// Declared here ONLY so `prisma migrate diff` does not read these columns as
  /// drift and generate a DROP for them. Application code must never write
  /// them: the trigger owns them, and an app-supplied value would break the
  /// version chain conflict detection depends on.
  syncVersion Int     @default(0) @map("sync_version")
  syncOrigin  String? @map("sync_origin")
  syncHlc     String? @map("sync_hlc")

  @@map("theatre_meals")
}

// ============================================
// OXYGEN CONTROL ROOM MODULE
// ============================================

model OxygenReadinessReport {
  id String @id @default(uuid())

  reportDate DateTime @default(now())
  shiftType  String // MORNING, AFTERNOON, NIGHT

  // Central oxygen supply
  centralOxygenPressure Float // Pressure in PSI
  centralOxygenStatus   OxygenSupplyStatus
  cylinderBankLevel     Int // Percentage 0-100

  // Backup systems
  backupCylindersCount  Int                @default(0)
  backupCylindersStatus OxygenSupplyStatus
  manifoldSystemOk      Boolean            @default(true)
  pipelineIntegrityOk   Boolean            @default(true)

  // Theatre-specific oxygen availability
  theatre1OxygenOk Boolean @default(false)
  theatre1Pressure Float? // Pressure at theatre outlet
  theatre2OxygenOk Boolean @default(false)
  theatre2Pressure Float?
  theatre3OxygenOk Boolean @default(false)
  theatre3Pressure Float?
  theatre4OxygenOk Boolean @default(false)
  theatre4Pressure Float?

  // Recovery room oxygen
  recoveryRoomOxygenOk Boolean @default(false)
  recoveryRoomPressure Float?

  // Alarm systems
  alarmSystemFunctional Boolean @default(true)
  lowPressureAlarmOk    Boolean @default(true)
  highPressureAlarmOk   Boolean @default(true)

  // Shortage prediction
  predictedShortage     Boolean @default(false)
  shortageEstimatedTime String? // E.g., "6 hours", "2 days"
  shortageReason        String?

  // Maintenance
  lastMaintenanceDate DateTime?
  nextMaintenanceDate DateTime?
  maintenanceRequired Boolean   @default(false)
  maintenanceDetails  String?

  // Overall status
  overallReadiness String // READY, PARTIALLY_READY, NOT_READY, CRITICAL
  criticalIssues   String?

  actionTaken     String?
  recommendations String?
  notes           String?

  // Reporting
  reportedById String
  reportedBy   User   @relation(fields: [reportedById], references: [id])

  verifiedById String?
  verifiedBy   User?     @relation("OxygenReportVerifier", fields: [verifiedById], references: [id])
  verifiedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("oxygen_readiness_reports")
}

model OxygenAlert {
  id String @id @default(uuid())

  alertDate DateTime            @default(now())
  alertType String // DEPLETION, LOW_PRESSURE, SYSTEM_FAILURE, CYLINDER_EMPTY
  severity  OxygenAlertSeverity
  status    OxygenAlertStatus   @default(ACTIVE)

  // Location
  location         String // Specific theatre or location
  affectedTheatres String? // Comma-separated theatre numbers

  // Alert details
  currentPressure Float? // Current oxygen pressure
  normalPressure  Float? // Expected normal pressure
  oxygenLevel     Float? // Percentage or volume

  description     String // Detailed description
  immediateRisk   Boolean  @default(false) // Is there an active surgery at risk?
  activeSurgeryId String? // Link to affected surgery
  activeSurgery   Surgery? @relation(fields: [activeSurgeryId], references: [id])

  // Alert trigger
  triggeredById String
  triggeredBy   User   @relation("OxygenAlertTriggerer", fields: [triggeredById], references: [id])
  triggerReason String // Why alert was raised

  // Response tracking
  acknowledgedById String?
  acknowledgedBy   User?     @relation("OxygenAlertAcknowledger", fields: [acknowledgedById], references: [id])
  acknowledgedAt   DateTime?

  respondedById  String?
  respondedBy    User?     @relation("OxygenAlertResponder", fields: [respondedById], references: [id])
  respondedAt    DateTime?
  responseAction String? // Action taken

  resolvedById    String?
  resolvedBy      User?     @relation("OxygenAlertResolver", fields: [resolvedById], references: [id])
  resolvedAt      DateTime?
  resolutionNotes String?

  // Impact assessment
  surgeriesAffected Int  @default(0)
  patientsAffected  Int  @default(0)
  downtime          Int? // Minutes of oxygen unavailability

  // Follow-up
  preventativeMeasures String?
  rootCause            String?

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("oxygen_alerts")
}

// ============================================
// DISCIPLINARY QUERY SYSTEM
// Auto-generated queries for deadline non-compliance
// ============================================

enum DisciplinaryQueryStatus {
  ISSUED
  ACKNOWLEDGED
  RESPONDED
  ESCALATED
  RESOLVED
  DISMISSED
}

enum DisciplinaryQueryType {
  READINESS_LATE
  THEATRE_SETUP_LATE
  ROSTER_NOT_SUBMITTED
  DUTY_ABANDONMENT
  PROTOCOL_VIOLATION
  OTHER
}

model DisciplinaryQuery {
  id                String                  @id @default(uuid())
  referenceNumber   String                  @unique
  recipientId       String
  recipientName     String
  recipientRole     String
  recipientUnit     String
  queryType         DisciplinaryQueryType
  subject           String
  description       String
  deadlineTime      DateTime
  deadlineType      String
  evidence          String?
  status            DisciplinaryQueryStatus @default(ISSUED)
  recipientResponse String?
  respondedAt       DateTime?
  escalatedTo       String?
  escalatedAt       DateTime?
  escalationReason  String?
  resolvedAt        DateTime?
  resolution        String?
  issuedById        String?
  issuedByName      String                  @default("Office of the Chief Medical Director")
  issuedByTitle     String                  @default("University of Nigeria Teaching Hospital, Ituku Ozalla")
  recipient         User                    @relation("QueryRecipient", fields: [recipientId], references: [id])
  issuedBy          User?                   @relation("QueryIssuer", fields: [issuedById], references: [id])
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  @@map("disciplinary_queries")
}

// ========================
// Emergency Team Availability
// ========================

enum EmergencyTeamRole {
  SURGEON
  ANAESTHETIST
  SCRUB_NURSE
  CIRCULATING_NURSE
  ANAESTHETIC_TECHNICIAN
  PORTER
  RECOVERY_ROOM_NURSE
  THEATRE_STORE_KEEPER
  BIOMEDICAL_ENGINEER
  CLEANER
  BLOODBANK_STAFF
  PHARMACIST
}

enum AvailabilityStatus {
  AVAILABLE
  EN_ROUTE
  ARRIVED
  UNAVAILABLE
  ON_ANOTHER_CASE
}

model EmergencyTeamAvailability {
  id                 String             @id @default(uuid())
  emergencyBookingId String
  userId             String
  userName           String
  teamRole           EmergencyTeamRole
  status             AvailabilityStatus @default(AVAILABLE)

  // Geo-location
  latitude            Float?
  longitude           Float?
  locationTimestamp   DateTime?
  estimatedArrivalMin Int? // Estimated minutes to arrive
  distanceKm          Float? // Calculated distance to hospital

  // Timestamps
  respondedAt DateTime  @default(now())
  arrivedAt   DateTime?

  // Notes
  notes String?

  /// A label the device supplies for itself, so an acknowledgement can be
  /// traced to a handset. Added for the response-monitoring board; nullable
  /// because every acknowledgement recorded before it existed has none.
  deviceLabel String?

  // Audit
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  emergencyBooking EmergencySurgeryBooking @relation(fields: [emergencyBookingId], references: [id])
  user             User                    @relation(fields: [userId], references: [id])

  @@unique([emergencyBookingId, userId])
  @@index([emergencyBookingId, teamRole])
  @@map("emergency_team_availability")
}

// ========================
// Emergency Pre-Anaesthetic Review & Prescription
// ========================

enum EmergencyReviewStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  APPROVED
}

enum EmergencyPrescriptionStatus {
  DRAFT
  SUBMITTED
  PHARMACIST_VIEWED
  PACKING
  PACKED
  DISPENSED
  OUT_OF_STOCK_FLAGGED
}

model EmergencyPreAnaestheticReview {
  id                 String  @id @default(uuid())
  emergencyBookingId String
  surgeryId          String?
  patientName        String
  folderNumber       String

  // Reviewer
  reviewerId   String
  reviewerName String

  // Assessment
  airwayAssessment   String? // Mallampati, Neck mobility, etc.
  asaClassification  String? // ASA I-VI
  allergies          String?
  currentMedications String?
  pastMedicalHistory String?
  lastMealTime       DateTime? // Fasting status for emergency

  // Vitals
  bloodPressure    String?
  heartRate        Int?
  oxygenSaturation Float?
  temperature      Float?
  weight           Float?
  height           Float?
  bmi              Float?

  // Emergency-Specific
  estimatedBloodLoss String?
  coagulationStatus  String?
  hemoglobinLevel    Float?
  crossMatchStatus   String?
  ivAccess           String? // Details of IV lines
  patientNPOStatus   String? // NPO status for emergency

  // Anaesthetic Plan
  anaestheticPlan       String? // General, Regional, Combined, etc.
  specialConsiderations String?
  riskAssessment        String?
  consentObtained       Boolean @default(false)
  consentNotes          String?

  // Approval (by a consultant)
  approvedById   String?
  approvedByName String?
  approvedAt     DateTime?

  // Status
  status      EmergencyReviewStatus @default(PENDING)
  isEmergency Boolean               @default(true)

  // Audit
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  emergencyBooking EmergencySurgeryBooking @relation(fields: [emergencyBookingId], references: [id])
  reviewer         User                    @relation("EmergencyReviewer", fields: [reviewerId], references: [id])
  approvedBy       User?                   @relation("EmergencyReviewApprover", fields: [approvedById], references: [id])
  prescriptions    EmergencyPrescription[]

  @@map("emergency_pre_anaesthetic_reviews")
}

model EmergencyPrescription {
  id                 String @id @default(uuid())
  reviewId           String
  emergencyBookingId String
  patientName        String
  folderNumber       String

  // Prescriber info (carried from review)
  prescribedByName String

  // Medications
  medications    String // JSON: [{name, dose, route, frequency, timing, isEmergency}]
  fluids         String? // JSON: IV fluids
  emergencyDrugs String? // JSON: emergency drugs

  // Allergy Alerts (for pharmacist)
  allergyAlerts       String?
  specialInstructions String?

  // Urgency Flag
  isEmergency Boolean @default(true)
  urgencyNote String? @default("EMERGENCY - IMMEDIATE DISPENSING REQUIRED")

  // Pharmacist tracking
  viewedByPharmacist Boolean   @default(false)
  viewedAt           DateTime?

  packedById   String?
  packedByName String?
  packedAt     DateTime?
  packingNotes String?

  // Out-of-stock
  outOfStockItems    String? // JSON: items out of stock
  hasOutOfStockItems Boolean @default(false)

  // Status
  status EmergencyPrescriptionStatus @default(DRAFT)

  // Patient-facing anaesthesia drug code (emergency path). Generated when the
  // anaesthetist creates this prescription; the patient presents it to pharmacy.
  anaesthesiaDrugCode String? @unique

  // Audit
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  review           EmergencyPreAnaestheticReview @relation(fields: [reviewId], references: [id])
  emergencyBooking EmergencySurgeryBooking       @relation(fields: [emergencyBookingId], references: [id])
  packedBy         User?                         @relation("EmergencyPrescriptionPacker", fields: [packedById], references: [id])

  /// Sync metadata, maintained by the capture trigger in the sync migration.
  /// Declared here ONLY so `prisma migrate diff` does not read these columns as
  /// drift and generate a DROP for them. Application code must never write
  /// them: the trigger owns them.
  syncVersion Int     @default(0) @map("sync_version")
  syncOrigin  String? @map("sync_origin")
  syncHlc     String? @map("sync_hlc")

  @@map("emergency_prescriptions")
}

// ==========================================
// CALL FOR PATIENT MODULE
// ==========================================

enum CallUpStatus {
  INVITED
  REJECTED
  PATIENT_EN_ROUTE
  PATIENT_ARRIVED
  CANCELLED
}

model PatientCallUp {
  id String @id @default(uuid())

  // Surgery reference
  surgeryId String
  surgery   Surgery @relation(fields: [surgeryId], references: [id])

  // Patient info (denormalized for call-up note)
  patientName   String
  folderNumber  String
  ward          String?
  age           Int?
  gender        String?
  diagnosis     String?
  procedureName String
  surgicalUnit  String

  // Theatre info
  theatreName String
  theatreId   String?

  // Assigned staff (from roster/allocation for the theatre)
  assignedNurseName  String?
  assignedNurseId    String?
  assignedPorterName String?
  assignedPorterId   String?

  // Surgeon info
  surgeonName String

  // Status
  status CallUpStatus @default(INVITED)

  // Invite
  invitedAt     DateTime @default(now())
  invitedById   String
  invitedBy     User     @relation("CallUpInviter", fields: [invitedById], references: [id])
  invitedByName String

  // Reject (if rejected)
  rejectedAt      DateTime?
  rejectedById    String?
  rejectedBy      User?     @relation("CallUpRejecter", fields: [rejectedById], references: [id])
  rejectedByName  String?
  rejectionReason String?

  // Patient arrival tracking
  patientEnRouteAt DateTime?
  patientArrivedAt DateTime?

  // Theatre porter ward-pickup tracking
  // (handwritten by ward nurse on the printout, then transcribed in the holding area)
  theatrePorterArrivedAtWardTime DateTime? // Time the theatre porter arrived at the ward
  theatrePorterDepartedWardTime  DateTime? // Time the theatre porter left the ward with the patient
  wardNurseName                  String? // Ward nurse who handed over the patient (from printout)
  wardNurseSignaturePresent      Boolean   @default(false) // Holding-area nurse confirms signature is on the printout
  wardEntriesNotes               String? // Optional notes (delays, escort, etc.)
  wardEntriesRecordedById        String? // Holding-area nurse who transcribed the entries
  wardEntriesRecordedByName      String?
  wardEntriesRecordedAt          DateTime?

  // Call-up note reference number
  callUpNoteNumber String @unique @default(uuid())

  // First-case-of-the-day punctuality tracking. The target time to invite the
  // first case of a team for the day is 07:00; after 07:15 a reason is required.
  isFirstCaseOfDay   Boolean @default(false)
  sendingMinutesLate Int? // minutes past 07:00 at invite time (negative = early)
  lateSendingReason  String?

  // Forced invite of a patient who was NOT cleared at the pre-operative visit.
  // Requires an override reason recorded by the inviter.
  forcedUncleared       Boolean @default(false)
  forcedUnclearedReason String?
  forcedUnclearedById   String?
  forcedUnclearedByName String?

  // Audit
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([surgeryId])
  @@index([status])
  @@index([invitedAt])
  @@map("patient_call_ups")
}

// Daily record of the holding-area nurse(s) in charge / responsible for sending
// the first cases of the day. Displayed on the Call for Patient page.
model DailyFirstCaseSending {
  id             String   @id @default(uuid())
  dateKey        String   @unique // yyyy-mm-dd (local day)
  nurses         String   @db.Text // JSON array of { name, phone, userId? }
  notes          String?
  recordedById   String?
  recordedByName String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("daily_first_case_sending")
}

// Hospital wards, editable by admins. Seeded from the built-in ward list on
// first use; the app merges these with the static defaults so custom wards
// (e.g. new private rooms) appear in every ward dropdown.
model Ward {
  id        String   @id @default(uuid())
  name      String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Sync metadata, maintained by the capture trigger in the sync migration.
  /// Declared here ONLY so `prisma migrate diff` does not read these columns as
  /// drift and generate a DROP for them. Application code must never write
  /// them: the trigger owns them, and an app-supplied value would break the
  /// version chain conflict detection depends on.
  syncVersion Int     @default(0) @map("sync_version")
  syncOrigin  String? @map("sync_origin")
  syncHlc     String? @map("sync_hlc")

  @@map("wards")
}

// Native mobile push tokens (Firebase Cloud Messaging). One row per device so
// the server can deliver real-time push notifications to the installed Android
// (and iOS) apps even when they are closed.
model DeviceToken {
  id         String   @id @default(uuid())
  token      String   @unique
  platform   String   @default("android") // android | ios | web
  userId     String? // owning user (plain id — no FK so tokens survive user edits)
  userRole   String?
  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId])
  @@index([userRole])
  @@map("device_tokens")
}

// ==========================================
// PRE-OPERATIVE VISIT MODULE
// ==========================================

enum PreOpVisitStatus {
  PENDING
  VISITED
  CLEARED
  NOT_CLEARED
  DEFERRED
}

enum PaymentStatus {
  NOT_PAID
  PARTIALLY_PAID
  FULLY_PAID
  WAIVED
  UNKNOWN
}

enum ConsentStatus {
  NOT_OBTAINED
  OBTAINED
  REFUSED
  PENDING
}

enum NPOStatus {
  NPO_COMPLIANT
  NOT_FASTING
  UNKNOWN
  PARTIALLY_COMPLIANT
}

enum EmotionalReadiness {
  READY
  ANXIOUS
  VERY_ANXIOUS
  REFUSED
  NEEDS_COUNSELLING
  UNKNOWN
}

model PreOperativeVisit {
  id String @id @default(uuid())

  // Surgery reference
  surgeryId String
  surgery   Surgery @relation(fields: [surgeryId], references: [id])

  // Patient info (denormalized for display)
  patientName  String
  folderNumber String
  ward         String?
  age          Int?
  gender       String?

  // Patient clinical history
  allergies         String? // Known drug/other allergies (null/empty = none recorded)
  previousSurgeries String? // Past surgical history, if any
  comorbidities     String? // Co-existing medical conditions, if any

  // Booked surgery details
  procedureName String
  surgicalUnit  String
  scheduledDate DateTime
  scheduledTime String
  surgeonName   String

  // Visit details
  visitDate     DateTime @default(now())
  visitedById   String
  visitedBy     User     @relation("PreOpVisitor", fields: [visitedById], references: [id])
  visitedByName String

  // Assessment fields
  patientAvailableInWard Boolean @default(false)
  patientLocationNotes   String? // If patient not in ward

  surgicalFeePaymentStatus PaymentStatus @default(UNKNOWN)
  paymentNotes             String?

  consentStatus ConsentStatus @default(PENDING)
  consentNotes  String?

  surgicalItemsAvailable Boolean @default(false)
  itemsAvailabilityNotes String? // List of missing items

  preAnaestheticReviewDone Boolean @default(false)
  preAnaestheticNotes      String?

  npoStatus    NPOStatus @default(UNKNOWN)
  npoNotes     String?
  lastMealTime String?

  investigationsComplete Boolean @default(false)
  investigationNotes     String? // Pending/abnormal results
  pendingInvestigations  String? // JSON list of pending investigations

  patientEmotionalReadiness EmotionalReadiness @default(UNKNOWN)
  emotionalReadinessNotes   String?

  // Blood readiness
  bloodReady Boolean @default(false)
  bloodNotes String?

  // IV line
  ivLineSecured Boolean @default(false)
  ivLineNotes   String?

  // Skin preparation
  skinPrepDone  Boolean @default(false)
  skinPrepNotes String?

  // Overall status
  overallStatus PreOpVisitStatus @default(PENDING)
  overallNotes  String?          @db.Text

  // Signature / confirmation
  nurseSignature String?

  // Audit
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  /// Sync metadata, maintained by the capture trigger in the sync migration.
  /// Declared here ONLY so `prisma migrate diff` does not read these columns as
  /// drift and generate a DROP for them. Application code must never write
  /// them: the trigger owns them.
  syncVersion Int      @default(0) @map("sync_version")
  syncOrigin  String?  @map("sync_origin")
  syncHlc     String?  @map("sync_hlc")

  @@index([surgeryId])
  @@index([visitDate])
  @@index([overallStatus])
  @@map("pre_operative_visits")
}

// ==================== MEDICATION TRACKING & RECONCILIATION ====================

// Track when anaesthetist collects medications from pharmacy
model MedicationCollection {
  id             String @id @default(uuid())
  prescriptionId String
  surgeryId      String

  // Collection Info
  collectedById   String // Anaesthetist who collected
  collectedByName String
  collectedAt     DateTime @default(now())

  // Dispensing pharmacist
  dispensedById   String // Pharmacist who dispensed
  dispensedByName String

  // Items collected (JSON: array of { drugName, dosage, quantityDispensed })
  itemsCollected String // JSON

  // Signature
  anaesthetistSignature Boolean @default(false)
  pharmacistSignature   Boolean @default(false)

  notes String?

  // Audit
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  prescription AnestheticPrescription @relation(fields: [prescriptionId], references: [id])
  surgery      Surgery                @relation("SurgeryMedicationCollections", fields: [surgeryId], references: [id])
  collectedBy  User                   @relation("MedicationCollector", fields: [collectedById], references: [id])
  dispensedBy  User                   @relation("MedicationDispenser", fields: [dispensedById], references: [id])

  @@map("medication_collections")
}

// Track individual drug usage during surgery (linked to anesthesia chart)
model MedicationUsageRecord {
  id             String @id @default(uuid())
  prescriptionId String
  surgeryId      String

  // Drug details
  drugName String
  dosage   String
  route    String

  // Quantity tracking
  quantityDispensed    Int // How many units were given to anaesthetist
  quantityAdministered Int @default(0) // How many used during surgery
  quantityWasted       Int @default(0) // Broken/contaminated
  quantityRemaining    Int @default(0) // Must be returned

  // Administration log (JSON array of { time, amount, administeredBy, notes })
  administrationLog String? // JSON

  // Status
  isFullyUsed      Boolean   @default(false)
  isReturnRequired Boolean   @default(false)
  isReturned       Boolean   @default(false)
  returnedAt       DateTime?
  returnedQuantity Int?

  // Administered by
  administeredById   String?
  administeredByName String?

  // Audit
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  prescription AnestheticPrescription @relation(fields: [prescriptionId], references: [id])
  surgery      Surgery                @relation("SurgeryMedicationUsage", fields: [surgeryId], references: [id])

  @@map("medication_usage_records")
}

// Post-surgery medication reconciliation
model MedicationReconciliation {
  id             String @id @default(uuid())
  prescriptionId String @unique
  surgeryId      String @unique

  // Reconciliation Details
  reconciledById   String // Usually anaesthetist or admin
  reconciledByName String
  reconciledAt     DateTime @default(now())

  // Summary
  totalDrugsDispensed Int
  totalDrugsUsed      Int
  totalDrugsToReturn  Int
  totalDrugsReturned  Int @default(0)
  totalDrugsWasted    Int @default(0)

  // Reconciliation items (JSON: array of { drugName, dispensed, used, remaining, returned, status })
  reconciliationItems String // JSON

  // Status
  status ReconciliationStatus @default(PENDING_RETURN)

  // Return tracking
  returnDeadline      DateTime? // Deadline for returning medications
  returnReminder1Sent Boolean   @default(false)
  returnReminder2Sent Boolean   @default(false)
  queryIssuedAt       DateTime?
  queryReason         String?
  queryResolvedAt     DateTime?
  queryResolution     String?

  notes String?

  // Audit
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  prescription      AnestheticPrescription     @relation(fields: [prescriptionId], references: [id])
  surgery           Surgery                    @relation("SurgeryReconciliation", fields: [surgeryId], references: [id])
  reconciledBy      User                       @relation("ReconciliationUser", fields: [reconciledById], references: [id])
  medicationReturns MedicationReturn[]
  nonReturnQueries  MedicationNonReturnQuery[]

  @@map("medication_reconciliations")
}

// Track medication returns to pharmacy
model MedicationReturn {
  id               String @id @default(uuid())
  reconciliationId String
  prescriptionId   String
  surgeryId        String

  // Return details
  returnedById   String // Anaesthetist returning
  returnedByName String
  returnedAt     DateTime @default(now())

  // Received by pharmacist
  receivedById   String // Pharmacist receiving
  receivedByName String
  receivedAt     DateTime?

  // Items returned (JSON: array of { drugName, quantityReturned, condition, pharmacistNotes })
  itemsReturned String // JSON

  // Pharmacist verification
  pharmacistVerified Boolean @default(false)
  pharmacistNotes    String?

  // Discrepancies
  hasDiscrepancy   Boolean @default(false)
  discrepancyNotes String?

  // Audit
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  reconciliation MedicationReconciliation @relation(fields: [reconciliationId], references: [id])
  prescription   AnestheticPrescription   @relation(fields: [prescriptionId], references: [id])
  surgery        Surgery                  @relation("SurgeryMedicationReturns", fields: [surgeryId], references: [id])
  returnedBy     User                     @relation("MedicationReturner", fields: [returnedById], references: [id])
  receivedBy     User                     @relation("MedicationReceiver", fields: [receivedById], references: [id])

  @@map("medication_returns")
}

// Additional medication requests during surgery (emergency top-up)
model AdditionalMedicationRequest {
  id             String @id @default(uuid())
  prescriptionId String // Original prescription
  surgeryId      String

  // Requested by anaesthetist
  requestedById   String
  requestedByName String
  requestedAt     DateTime @default(now())

  // Medications requested (JSON: array of { drugName, dosage, route, quantity, reason })
  medicationsRequested String // JSON

  // Urgency
  urgency MedicationUrgency @default(EMERGENCY)
  reason  String // Clinical reason for additional meds

  // Status
  status AdditionalMedRequestStatus @default(PENDING)

  // Pharmacist response
  acknowledgedById   String?
  acknowledgedByName String?
  acknowledgedAt     DateTime?

  // Packing
  packedById   String?
  packedByName String?
  packedAt     DateTime?

  // Collection
  collectedAt     DateTime?
  collectedByName String?

  // Alert
  alertSentAt          DateTime?
  walkieTalkieNotified Boolean   @default(false)

  notes           String?
  pharmacistNotes String?

  // Audit
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  prescription   AnestheticPrescription @relation(fields: [prescriptionId], references: [id])
  surgery        Surgery                @relation("SurgeryAdditionalMedRequests", fields: [surgeryId], references: [id])
  requestedBy    User                   @relation("AdditionalMedRequester", fields: [requestedById], references: [id])
  acknowledgedBy User?                  @relation("AdditionalMedAcknowledger", fields: [acknowledgedById], references: [id])
  packedBy       User?                  @relation("AdditionalMedPacker", fields: [packedById], references: [id])

  @@map("additional_medication_requests")
}

// Non-return query tracking
model MedicationNonReturnQuery {
  id               String @id @default(uuid())
  reconciliationId String
  prescriptionId   String
  surgeryId        String

  // Query target
  queriedUserId   String // Anaesthetist who hasn't returned meds
  queriedUserName String

  // Query details
  issuedById   String // Admin/pharmacist who raised query
  issuedByName String
  issuedAt     DateTime @default(now())

  // Items not returned (JSON: array of { drugName, quantityExpected, quantityReturned, deficit })
  unreturvedItems String // JSON

  // Deadlines
  responseDeadline DateTime

  // Response
  status       QueryStatus @default(PENDING)
  responseText String? // Anaesthetist's response/explanation
  respondedAt  DateTime?

  // Resolution
  resolvedById   String?
  resolvedByName String?
  resolvedAt     DateTime?
  resolution     String? // "RETURNED", "JUSTIFIED_USAGE", "ESCALATED", "WRITTEN_OFF"

  // Escalation
  isEscalated Boolean   @default(false)
  escalatedTo String? // HOD, CMD, etc.
  escalatedAt DateTime?

  // Audit
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  reconciliation MedicationReconciliation @relation(fields: [reconciliationId], references: [id])
  prescription   AnestheticPrescription   @relation(fields: [prescriptionId], references: [id])
  surgery        Surgery                  @relation("SurgeryMedicationQueries", fields: [surgeryId], references: [id])
  queriedUser    User                     @relation("QueriedUser", fields: [queriedUserId], references: [id])
  issuedBy       User                     @relation("QueryIssuer", fields: [issuedById], references: [id])

  @@map("medication_non_return_queries")
}

enum ReconciliationStatus {
  PENDING_RETURN
  PARTIALLY_RETURNED
  FULLY_RETURNED
  QUERY_ISSUED
  QUERY_RESOLVED
  CLOSED
}

enum AdditionalMedRequestStatus {
  PENDING
  ACKNOWLEDGED
  PACKING
  PACKED
  COLLECTED
  CANCELLED
}

enum QueryStatus {
  PENDING
  RESPONDED
  UNDER_REVIEW
  RESOLVED
  ESCALATED
}

// =============================================
// EMERGENCY LAB WORKUP MODULE
// =============================================

enum EmergencyLabRequestStatus {
  REQUESTED
  NOTIFIED
  ACKNOWLEDGED
  SAMPLE_COLLECTION_DISPATCHED
  SAMPLE_COLLECTED
  SAMPLE_RECEIVED_AT_LAB
  PROCESSING
  RESULTS_READY
  RESULTS_VERIFIED
  RESULTS_VIEWED
  CANCELLED
}

enum EmergencyLabPriority {
  CRITICAL
  URGENT
  ROUTINE
}

enum EmergencyLabTestCategory {
  HEMATOLOGY
  BIOCHEMISTRY
  COAGULATION
  BLOOD_GAS
  CROSS_MATCH
  URINALYSIS
  MICROBIOLOGY
  SEROLOGY
  RADIOLOGY
  ECG
  OTHER
}

model EmergencyLabRequest {
  id String @id @default(uuid())

  // Link to emergency booking / surgery
  emergencyBookingId String?
  emergencyBooking   EmergencySurgeryBooking? @relation("EmergencyLabRequests", fields: [emergencyBookingId], references: [id])
  surgeryId          String?
  surgery            Surgery?                 @relation("EmergencyLabWorkupSurgery", fields: [surgeryId], references: [id])

  // Patient Info
  patientName  String
  folderNumber String
  age          Int?
  gender       String?
  ward         String?
  diagnosis    String?

  // Requesting details
  requestedById   String
  requestedBy     User     @relation("EmergencyLabRequester", fields: [requestedById], references: [id])
  requestedByName String
  requestedAt     DateTime @default(now())

  // Priority
  priority           EmergencyLabPriority @default(CRITICAL)
  clinicalIndication String // Why the investigation is needed

  // Status
  status EmergencyLabRequestStatus @default(REQUESTED)

  // Voice/Push Notification
  voiceNotificationSent   Boolean   @default(false)
  voiceNotificationSentAt DateTime?
  pushNotificationSent    Boolean   @default(false)
  pushNotificationSentAt  DateTime?

  // Lab Acknowledgement
  acknowledgedById String?
  acknowledgedBy   User?     @relation("EmergencyLabAcknowledger", fields: [acknowledgedById], references: [id])
  acknowledgedAt   DateTime?

  // Notes
  specialInstructions String?
  notes               String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  labTests         EmergencyLabTest[]
  labNotifications EmergencyLabNotification[]

  @@index([emergencyBookingId])
  @@index([surgeryId])
  @@index([status])
  @@index([priority])
  @@map("emergency_lab_requests")
}

model EmergencyLabTest {
  id String @id @default(uuid())

  emergencyLabRequestId String
  emergencyLabRequest   EmergencyLabRequest @relation(fields: [emergencyLabRequestId], references: [id], onDelete: Cascade)

  // Test details
  testName     String // FBC, U&E, PT/INR, ABG, etc.
  testCategory EmergencyLabTestCategory

  // Sample Collection
  sampleCollected     Boolean   @default(false)
  sampleCollectedAt   DateTime?
  sampleCollectedById String?
  sampleCollectedBy   User?     @relation("LabSampleCollector", fields: [sampleCollectedById], references: [id])
  sampleType          String? // Blood, Urine, Swab, etc.
  sampleBarcode       String?

  // Lab Processing
  receivedAtLabAt     DateTime?
  receivedByLabId     String?
  receivedByLab       User?     @relation("LabSampleReceiver", fields: [receivedByLabId], references: [id])
  processingStartedAt DateTime?

  // Results
  status           EmergencyLabRequestStatus @default(REQUESTED)
  resultValue      String? // The actual result
  resultUnit       String? // mg/dL, mmol/L, etc.
  referenceRange   String? // Normal range
  abnormalResult   Boolean                   @default(false)
  criticalResult   Boolean                   @default(false)
  resultNotes      String? // Lab scientist comments
  resultAttachment String? // URL or path to result document

  // Result entry
  resultEnteredById String?
  resultEnteredBy   User?     @relation("LabResultEnterer", fields: [resultEnteredById], references: [id])
  resultEnteredAt   DateTime?

  // Verification
  resultVerifiedById String?
  resultVerifiedBy   User?     @relation("LabResultVerifier", fields: [resultVerifiedById], references: [id])
  resultVerifiedAt   DateTime?

  // Viewed by surgeon/anaesthetist
  viewedBySurgeon        Boolean   @default(false)
  viewedBySurgeonAt      DateTime?
  viewedByAnaesthetist   Boolean   @default(false)
  viewedByAnaesthetistAt DateTime?

  // Turnaround time tracking
  turnaroundMinutes Int? // Total time from request to result

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([emergencyLabRequestId])
  @@index([status])
  @@map("emergency_lab_tests")
}

// ============================================================================
// FEEDBACK MODULE
// Two streams:
//  1. Staff/user feedback — suggestions to improve Theatre Management and/or
//     the application. Submitted by logged-in users.
//  2. Patient feedback — patients and their relatives share their experience
//     during the surgical journey, via a public shareable link / QR code.
// ============================================================================

enum FeedbackCategory {
  THEATRE_MANAGEMENT // improvements to how the theatre is run
  APPLICATION // improvements to the ORM app itself
}

model StaffFeedback {
  id       String           @id @default(uuid())
  category FeedbackCategory
  title    String?
  message  String
  rating   Int? // optional 1-5 satisfaction rating

  // Author (logged-in staff). Stored as plain fields so we do not need to
  // back-relate to the large User model.
  authorId   String?
  authorName String?
  authorRole String?

  // Triage
  status     String  @default("OPEN") // OPEN | IN_REVIEW | ACTIONED | CLOSED
  adminNotes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@index([status])
  @@map("staff_feedback")
}

model PatientFeedback {
  id String @id @default(uuid())

  // Identity (optional — patients may stay anonymous)
  patientName  String?
  folderNumber String?
  phoneNumber  String?
  relationship String? // e.g. "Patient", "Relative", "Caregiver"

  // Experience ratings (1-5)
  overallRating        Int?
  staffCourtesyRating  Int?
  cleanlinessRating    Int?
  waitTimeRating       Int?
  communicationRating  Int?
  painManagementRating Int?

  // Which stage of the journey
  journeyStage String? // e.g. Admission, Pre-op, Surgery, Recovery, Discharge

  // Free text
  whatWentWell  String?
  whatToImprove String?
  message       String?

  wouldRecommend Boolean?

  // Moderation
  status String @default("NEW") // NEW | REVIEWED | PUBLISHED | ARCHIVED

  // Metadata
  source    String? // qr | link | dashboard
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@map("patient_feedback")
}

model EmergencyLabNotification {
  id String @id @default(uuid())

  emergencyLabRequestId String
  emergencyLabRequest   EmergencyLabRequest @relation(fields: [emergencyLabRequestId], references: [id], onDelete: Cascade)

  // Notification details
  recipientId      String?
  recipientRole    String // LABORATORY_STAFF, SURGEON, ANAESTHETIST, etc.
  notificationType String // SAMPLE_COLLECT, SAMPLE_RECEIVED, RESULTS_READY, CRITICAL_RESULT

  // Voice notification
  isVoiceNotification Boolean   @default(false)
  voiceMessage        String?
  voicePlayed         Boolean   @default(false)
  voicePlayedAt       DateTime?

  // Push notification
  isPushNotification Boolean   @default(true)
  pushTitle          String?
  pushMessage        String?
  pushDelivered      Boolean   @default(false)
  pushDeliveredAt    DateTime?

  // Acknowledgement
  acknowledged     Boolean   @default(false)
  acknowledgedAt   DateTime?
  acknowledgedById String?

  sentAt DateTime @default(now())

  @@index([emergencyLabRequestId])
  @@index([recipientId])
  @@map("emergency_lab_notifications")
}

// =============================================
// PLUMBING & WATER SUPPLY MODULE
// =============================================

enum PlumbingFaultStatus {
  REPORTED
  ACKNOWLEDGED
  ASSIGNED
  IN_PROGRESS
  PARTS_ORDERED
  RESOLVED
  CLOSED
}

enum PlumbingFaultPriority {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

enum PlumbingFaultCategory {
  LEAK
  BLOCKAGE
  BURST_PIPE
  LOW_PRESSURE
  NO_WATER
  HOT_WATER_ISSUE
  DRAINAGE
  SEWAGE
  FIXTURE_DAMAGE
  VALVE_ISSUE
  TANK_ISSUE
  PUMP_FAILURE
  OTHER
}

model PlumbingFault {
  id String @id @default(uuid())

  // Fault details
  title       String
  description String
  category    PlumbingFaultCategory
  priority    PlumbingFaultPriority @default(MEDIUM)
  status      PlumbingFaultStatus   @default(REPORTED)

  // Location
  location String // Theatre 1, Scrub Area, PACU, etc.
  floor    String?
  building String?

  // Reporting
  reportedById   String
  reportedBy     User     @relation("PlumbingFaultReporter", fields: [reportedById], references: [id])
  reportedByName String
  reportedAt     DateTime @default(now())

  // Photo evidence
  photoUrl  String?
  photoUrls String? // JSON array of image URLs

  // Assignment
  assignedToId   String?
  assignedTo     User?     @relation("PlumbingFaultAssignee", fields: [assignedToId], references: [id])
  assignedToName String?
  assignedAt     DateTime?

  // Acknowledgement
  acknowledgedById String?
  acknowledgedBy   User?     @relation("PlumbingFaultAcknowledger", fields: [acknowledgedById], references: [id])
  acknowledgedAt   DateTime?

  // Resolution
  resolvedById    String?
  resolvedBy      User?     @relation("PlumbingFaultResolver", fields: [resolvedById], references: [id])
  resolvedByName  String?
  resolvedAt      DateTime?
  resolutionNotes String?
  partsUsed       String? // JSON array

  // Impact
  affectsTheatreOps Boolean @default(false)
  theatresAffected  String? // JSON array of theatre IDs

  // Escalation
  isEscalated Boolean   @default(false)
  escalatedAt DateTime?
  escalatedTo String?

  // Cost tracking
  estimatedCost Decimal? @db.Decimal(10, 2)
  actualCost    Decimal? @db.Decimal(10, 2)

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([priority])
  @@index([category])
  @@map("plumbing_faults")
}

model PlumbingWaterStatus {
  id String @id @default(uuid())

  // Status date and shift
  statusDate DateTime @default(now())
  shiftType  String // MORNING, AFTERNOON, NIGHT

  // Main water supply
  municipalWaterAvailable Boolean @default(false)
  boreholeOperational     Boolean @default(false)
  overheadTankLevel       Int     @default(0) // Percentage 0-100
  groundTankLevel         Int     @default(0) // Percentage 0-100

  // Pump status
  mainPumpOperational    Boolean @default(true)
  backupPumpOperational  Boolean @default(true)
  boosterPumpOperational Boolean @default(true)

  // Pressure readings
  mainLinePressure    String // LOW, NORMAL, HIGH
  theatreLinePressure String // LOW, NORMAL, HIGH

  // Hot water system
  hotWaterAvailable   Boolean @default(true)
  hotWaterTemperature String? // Celsius reading
  boilerOperational   Boolean @default(true)

  // Theatre-specific status
  theatre1Status          String @default("OK") // OK, LOW_PRESSURE, NO_WATER, LEAK
  theatre2Status          String @default("OK")
  theatre3Status          String @default("OK")
  theatre4Status          String @default("OK")
  scrubAreaStatus         String @default("OK")
  recoveryAreaStatus      String @default("OK")
  sterilizationAreaStatus String @default("OK")

  // Drainage
  drainageFlowing Boolean @default(true)
  drainageIssues  String?

  // Overall
  overallStatus String // OPERATIONAL, DEGRADED, CRITICAL, OFFLINE

  // Logged by
  loggedById   String
  loggedBy     User   @relation("PlumbingStatusLogger", fields: [loggedById], references: [id])
  loggedByName String

  actionRequired String?
  actionTaken    String?
  notes          String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([statusDate])
  @@index([overallStatus])
  @@map("plumbing_water_status")
}

// ============================================
// WATER SUPPLY DEPARTMENT — DAILY READINESS
// (separate department from Plumbing)
// ============================================

model WaterSupplyReadiness {
  id String @id @default(uuid())

  readinessDate DateTime @default(now()) // when the report was logged
  forDate       DateTime // the surgery day this readiness covers (typically next day)

  // Tank levels backing the assurance
  overheadTankLevel Int @default(0) // Percentage 0-100
  groundTankLevel   Int @default(0) // Percentage 0-100

  // Readiness confirmations for the next day's surgery
  restroomsWaterReady         Boolean @default(false) // toilets and all rest rooms
  scrubbingWaterReady         Boolean @default(false) // surgical scrubbing during surgery
  theatreActivitiesWaterReady Boolean @default(false) // all other theatre activities
  noShortageConfirmed         Boolean @default(false)

  overallReadiness String // READY, AT_RISK, NOT_READY
  riskDetails      String?
  actionTaken      String?
  notes            String?

  // Compliance / disciplinary tracking (must be logged before 5pm daily)
  submittedAt             DateTime @default(now())
  isLate                  Boolean  @default(false)
  disciplinaryQueryIssued Boolean  @default(false)

  loggedById   String
  loggedBy     User   @relation("WaterReadinessLogger", fields: [loggedById], references: [id])
  loggedByName String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([forDate])
  @@index([overallReadiness])
  @@map("water_supply_readiness")
}

// ============================================
// ANONYMOUS REPORTING — NO USER TRACKING
// ============================================

enum AnonymousTipCategory {
  MISCONDUCT
  DAMAGE
  LIGHTS_AC_LEFT_ON
  WASTE_OF_RESOURCES
  POLICY_VIOLATION
  UNSAFE_PRACTICE
  HARASSMENT
  NEGLIGENCE
  OTHER
}

enum SecurityReportCategory {
  THEFT
  SUSPICIOUS_ACTIVITY
  UNAUTHORIZED_ACCESS
  VANDALISM
  THREATENING_BEHAVIOR
  MISSING_EQUIPMENT
  DRUG_DIVERSION
  TRESPASSING
  OTHER
}

enum AnonymousReportStatus {
  NEW
  UNDER_REVIEW
  INVESTIGATING
  ACTION_TAKEN
  RESOLVED
  DISMISSED
}

enum ReportPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model AnonymousTip {
  id String @id @default(uuid())

  // NO user references — fully anonymous
  category AnonymousTipCategory
  priority ReportPriority        @default(MEDIUM)
  status   AnonymousReportStatus @default(NEW)

  location     String // Where the incident/issue was observed
  dateObserved DateTime @default(now()) // When it was observed
  description  String // Detailed anonymous description

  // Media evidence (photo/video as base64 data URL)
  mediaUrl      String? @db.Text // base64 data URL of uploaded image/video
  mediaType     String? // "image" or "video"
  mediaLocation String? // Where the photo/video was taken

  // Optional details
  frequencyOfOccurrence String? // e.g. "Daily", "Every night", "One-time"
  suggestedAction       String? // What the reporter thinks should be done

  // Admin response (filled by admin reviewing the tip)
  adminNotes  String?
  actionTaken String?
  resolvedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@index([status])
  @@index([priority])
  @@index([createdAt])
  @@map("anonymous_tips")
}

model SecurityReport {
  id String @id @default(uuid())

  // NO user references — fully anonymous
  category SecurityReportCategory
  priority ReportPriority         @default(HIGH)
  status   AnonymousReportStatus  @default(NEW)

  location     String // Where the security concern was observed
  dateObserved DateTime @default(now())
  description  String // Detailed description of security concern

  // Suspect details (optional, anonymous)
  suspectDescription String? // Physical description if relevant
  personsInvolved    String? // Number or vague description, no names required

  // Evidence
  evidenceDescription String? // Description of any evidence

  // Media evidence (photo/video as base64 data URL)
  mediaUrl      String? @db.Text // base64 data URL of uploaded image/video
  mediaType     String? // "image" or "video"
  mediaLocation String? // Where the photo/video was taken

  // Urgency
  isOngoing           Boolean @default(false) // Is this still happening?
  immediateRiskToLife Boolean @default(false) // Immediate danger?

  // Admin response
  adminNotes  String?
  actionTaken String?
  resolvedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@index([status])
  @@index([priority])
  @@index([isOngoing])
  @@index([createdAt])
  @@map("security_reports")
}

// ==========================================
// ANNOUNCEMENTS MODULE
// ==========================================

enum AnnouncementStatus {
  DRAFT
  SCHEDULED
  ACTIVE
  PLAYED
  EXPIRED
  CANCELLED
}

enum AnnouncementFrequency {
  ONE_TIME // Play once at scheduled time
  DAILY // Repeat every day at scheduled time
  WEEKLY // Repeat weekly on selected days
  CUSTOM_INTERVAL // Every N hours/minutes
}

model Announcement {
  id String @id @default(uuid())

  // Content
  title            String // e.g. "Morning Briefing", "Fire Drill Notice"
  description      String? // Optional note for admin reference
  audioFileName    String // Original uploaded file name
  audioData        String  @db.Text // Base64-encoded audio data
  audioMimeType    String  @default("audio/mpeg") // MIME type
  audioDurationSec Int? // Duration in seconds (optional metadata)

  // Scheduling
  scheduledDate     DateTime // First play date/time
  endDate           DateTime? // When to stop repeating (null = indefinite for repeating, or same as scheduledDate for one-time)
  frequency         AnnouncementFrequency @default(ONE_TIME)
  repeatDays        String? // JSON array of day numbers [0-6] for WEEKLY (0=Sunday)
  customIntervalMin Int? // Interval in minutes for CUSTOM_INTERVAL

  // Playback tracking
  lastPlayedAt DateTime?
  playCount    Int       @default(0)

  // Status
  status AnnouncementStatus @default(DRAFT)

  // Admin/audit
  createdById   String
  createdByName String
  updatedById   String?
  updatedByName String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  createdBy    User                   @relation("AnnouncementCreator", fields: [createdById], references: [id])
  playbackLogs AnnouncementPlayback[]

  @@index([status])
  @@index([scheduledDate])
  @@index([frequency])
  @@index([createdAt])
  @@map("announcements")
}

model AnnouncementPlayback {
  id              String   @id @default(uuid())
  announcementId  String
  playedAt        DateTime @default(now())
  playedBySystem  Boolean  @default(true) // Auto-played by scheduler vs manual
  triggeredByName String? // If manually triggered, who did it

  announcement Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)

  @@index([announcementId])
  @@index([playedAt])
  @@map("announcement_playbacks")
}

// ============================================================
// THEATRE NURSES STRUCTURED HANDOVER (WHO International Standard)
// SBAR + WHO Surgical Safety Checklist Handover Protocol
// ============================================================

enum HandoverPhase {
  SHIFT_HANDOVER // Nurse-to-nurse shift handover
  INTRA_OP_HANDOVER // During surgery team change
  POST_OP_HANDOVER // Theatre to PACU/Recovery handover
  THEATRE_TO_WARD // Recovery to ward handover
}

enum HandoverStatus {
  DRAFT
  IN_PROGRESS
  PENDING_ACKNOWLEDGEMENT
  ACKNOWLEDGED
  COMPLETED
  DISPUTED
}

model NurseHandover {
  id            String         @id @default(uuid())
  handoverPhase HandoverPhase
  status        HandoverStatus @default(DRAFT)

  // === LINK TO SURGERY / PATIENT / THEATRE ===
  surgeryId   String?
  patientId   String?
  theatreId   String?
  theatreName String? // Denormalized for display

  // === WHO SBAR STRUCTURE ===                
  // S - SITUATION
  patientName         String?
  patientFolderNumber String?
  patientAge          Int?
  patientGender       String?
  patientWard         String?
  procedurePerformed  String?
  surgeonName         String?
  anesthetistName     String?
  anesthesiaType      String? // GA, Spinal, Local, Regional, Sedation
  surgeryStartTime    DateTime?
  surgeryEndTime      DateTime?

  // B - BACKGROUND
  diagnosis           String?
  relevantHistory     String? // Comorbidities, allergies, medications
  allergies           String?
  preOpInvestigations String? // Key lab results, imaging
  asaGrade            String? // ASA Classification I-VI

  // A - ASSESSMENT (Intra-operative Events)
  estimatedBloodLoss String?
  fluidGiven         String? // Type and volume
  bloodProductsGiven String? // Units, type
  urineOutput        String?
  vitalSignsSummary  String? // BP, HR, SpO2, Temp at handover
  lastBP             String?
  lastHR             String?
  lastSpO2           String?
  lastTemp           String?
  painScore          Int? // 0-10
  consciousnessLevel String? // FULLY_AWAKE, DROWSY, SEDATED, etc.
  airwayStatus       String? // PATENT, MAINTAINED, INTUBATED, etc.

  // Intra-operative Concerns
  intraOpComplications String? // Any complications during surgery
  unexpectedEvents     String?
  implantsUsed         String?

  // === WHO SURGICAL SAFETY (Sign Out Items) ===
  instrumentCountCorrect  Boolean?
  spongeCountCorrect      Boolean?
  needleCountCorrect      Boolean?
  sharpsCountCorrect      Boolean?
  countDiscrepancy        String? // Details if any count is incorrect
  specimenCollected       Boolean?
  specimenLabel           String? // Specimen details
  specimenSentToLab       Boolean?
  equipmentProblems       Boolean?
  equipmentProblemDetails String?

  // === DRAINS / LINES / DEVICES ===
  drainsInSitu    Boolean @default(false)
  drainDetails    String? // Type, location, output
  catheterInSitu  Boolean @default(false)
  catheterDetails String?
  ivLinesInSitu   Boolean @default(false)
  ivLineDetails   String? // Type, site, fluid running
  ngTubeInSitu    Boolean @default(false)
  ngTubeDetails   String?
  woundDressing   String? // Type of dressing applied

  // R - RECOMMENDATION
  postOpOrders          String? // Medications, monitoring frequency
  oxygenRequirement     String? // O2 therapy type and flow rate
  ivFluidOrders         String? // Ongoing IV fluid plan
  painManagementPlan    String?
  antibioticPlan        String?
  dvtProphylaxis        String? // Enoxaparin, TED stockings, etc.
  dietaryInstructions   String? // NBM duration, clear fluids, etc.
  mobilityInstructions  String?
  monitoringFrequency   String? // e.g., "q15min x 1hr, then q30min x 2hr"
  investigationsOrdered String? // Post-op bloods, imaging
  followUpPlan          String? // When to review, when to escalate
  escalationCriteria    String? // When to call surgeon/anesthetist

  // === THEATRE PREPARATION STATUS ===
  theatreAssigned       Boolean?
  instrumentSetPrepared Boolean?
  sterilityConfirmed    Boolean?
  equipmentChecked      Boolean?
  implantsAvailable     Boolean?

  // === ANAESTHESIA & SAFETY ===
  consentObtained         Boolean?
  preOpChecklistCompleted Boolean?
  bloodAvailability       Boolean?
  fastingStatus           Boolean?
  fastingDetails          String? // Duration, last intake time

  // === NURSING TASKS COMPLETED/PENDING ===
  ivLineSecured           Boolean?
  medicationsAdministered Boolean?
  medicationDetails       String? // What was given, time, dose
  skinPreparation         Boolean?
  skinPrepDetails         String? // Area, method
  documentationComplete   Boolean?
  documentationNotes      String?

  // === SPECIAL NOTES / ALERTS ===
  infectionRisk           Boolean @default(false)
  infectionRiskDetails    String?
  highRiskPatient         Boolean @default(false)
  highRiskDetails         String?
  specialPositioning      Boolean @default(false)
  positioningDetails      String?
  equipmentConcerns       Boolean @default(false)
  equipmentConcernDetails String?
  specialAlerts           String? // Any other critical alerts

  // === PHOTO INTEGRATION ===
  woundImages String[] // Array of image URLs

  // === VOICE NOTES ===
  voiceNoteUrl String? // URL to voice recording

  // === SUPERVISOR VISIBILITY ===
  supervisorReviewed     Boolean   @default(false)
  supervisorReviewedById String?
  supervisorReviewedAt   DateTime?
  supervisorNotes        String?

  // === PERFORMANCE TRACKING ===
  shiftStartTime          DateTime? // When the shift started
  shiftEndTime            DateTime? // When the shift ended
  handoverDurationMinutes Int? // Auto-calculated
  delayMinutes            Int? // Any delay in starting
  delayCause              String? // Reason for delay

  // === SHIFT HANDOVER SPECIFIC ===
  pendingTasks       String? // Tasks not yet completed
  outstandingOrders  String?
  upcomingSurgeries  String? // Remaining cases for the list
  staffingConcerns   String?
  equipmentIssues    String? // Faulty equipment, missing items
  theatreCleanliness String? // Cleaning status

  // === NURSE IDENTITIES ===
  handingOverNurseId   String
  handingOverNurseName String
  receivingNurseId     String?
  receivingNurseName   String?

  // Witness (for critical handovers)
  witnessNurseId   String?
  witnessNurseName String?

  // === TIMESTAMPS ===
  handoverStartedAt   DateTime  @default(now())
  handoverCompletedAt DateTime?
  acknowledgedAt      DateTime?

  // === ACKNOWLEDGEMENT ===
  receiverNotes String? // Receiving nurse's questions/notes
  issuesRaised  Boolean @default(false)
  issueDetails  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // === RELATIONS ===
  surgery          Surgery?                @relation("HandoverSurgery", fields: [surgeryId], references: [id])
  patient          Patient?                @relation("HandoverPatient", fields: [patientId], references: [id])
  handingOverNurse User                    @relation("HandingOverNurse", fields: [handingOverNurseId], references: [id])
  receivingNurse   User?                   @relation("ReceivingNurse", fields: [receivingNurseId], references: [id])
  witnessNurse     User?                   @relation("WitnessNurse", fields: [witnessNurseId], references: [id])
  checklistItems   HandoverChecklistItem[]
  auditTrail       HandoverAuditLog[]

  @@index([handoverPhase])
  @@index([status])
  @@index([surgeryId])
  @@index([patientId])
  @@index([handingOverNurseId])
  @@index([receivingNurseId])
  @@index([handoverStartedAt])
  @@index([createdAt])
  @@map("nurse_handovers")
}

model HandoverChecklistItem {
  id            String    @id @default(uuid())
  handoverId    String
  category      String // PATIENT_ID, PROCEDURE, COUNTS, DRAINS, MEDS, SAFETY, etc.
  itemLabel     String // The checklist question/item text
  isChecked     Boolean   @default(false)
  notes         String?
  checkedById   String?
  checkedByName String?
  checkedAt     DateTime?

  handover NurseHandover @relation(fields: [handoverId], references: [id], onDelete: Cascade)

  @@index([handoverId])
  @@index([category])
  @@map("handover_checklist_items")
}

model HandoverAuditLog {
  id              String   @id @default(uuid())
  handoverId      String
  action          String // CREATED, UPDATED, SUBMITTED, ACKNOWLEDGED, DISPUTED, COMPLETED
  performedById   String
  performedByName String
  details         String? // JSON of what changed
  timestamp       DateTime @default(now())

  handover NurseHandover @relation(fields: [handoverId], references: [id], onDelete: Cascade)

  @@index([handoverId])
  @@index([timestamp])
  @@map("handover_audit_logs")
}

// ============================================================================
// Surgical Units & Day-of-Week Theatre Allocation Schedule
// ----------------------------------------------------------------------------
// Models the OPERATING THEATRE ALLOCATION SCHEDULE (Locations 1-4).
// Admins manage these from /dashboard/admin/surgical-units.
// ============================================================================
model SurgicalUnit {
  id           String   @id @default(uuid())
  name         String   @unique // e.g. "GS Unit I", "Neuro Unit III"
  subspecialty String // e.g. "General Surgery", "Neurosurgery"
  location     String // e.g. "Professor Ojukwu Theatre Complex", "Eye Theatre", "A&E", "Cardiothoracic Centre"
  active       Boolean  @default(true)
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  schedules SurgicalUnitSchedule[]

  @@index([location])
  @@index([subspecialty])
  @@map("surgical_units")
}

model SurgicalUnitSchedule {
  id          String   @id @default(uuid())
  unitId      String
  dayOfWeek   Int // 0 = Sunday, 1 = Monday, ... 6 = Saturday
  theatreId   String // TheatreSuite.id (matched by id; soft reference)
  theatreName String // Cached name for quick display (e.g., "Theatre 3", "Suite 1")
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  unit SurgicalUnit @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@unique([unitId, dayOfWeek, theatreId])
  @@index([dayOfWeek])
  @@index([theatreId])
  @@map("surgical_unit_schedules")
}

// ============================================================================
// THEATRE RADIO SERVICE & ASSISTANT
// ============================================================================

// Scheduled or recurring broadcast definition (welcome msg, rules, music slot)
model RadioBroadcast {
  id            String    @id @default(uuid())
  title         String
  category      String // WELCOME | RULES | MUSIC | ANNOUNCEMENT | CUSTOM
  message       String? // text content for TTS (nullable when audioUrl is used)
  audioUrl      String? // optional pre-recorded audio
  voice         String? // preferred voice hint (e.g. "en-GB-female")
  priority      Int       @default(50) // 1=lowest, 100=emergency override
  daysOfWeek    String    @default("0,1,2,3,4,5,6") // CSV of DOW
  timeOfDay     String? // "HH:mm" 24h, null = on-demand only
  intervalMins  Int? // if set, replays every N minutes during active window
  startDate     DateTime?
  endDate       DateTime?
  active        Boolean   @default(true)
  createdById   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  lastTriggered DateTime?

  @@index([active])
  @@index([category])
  @@map("radio_broadcasts")
}

// A single announcement instance queued/played by the radio service
model RadioAnnouncement {
  id               String    @id @default(uuid())
  broadcastId      String? // links back to RadioBroadcast (optional)
  category         String // WELCOME | RULES | MUSIC | EMERGENCY | WORKFLOW | STAFF_REQUEST | CONFIRMATION | CUSTOM
  title            String
  message          String // text to speak
  audioUrl         String?
  priority         Int       @default(50) // 100 = emergency override
  location         String? // e.g. "Theatre 3"
  specialty        String? // e.g. "Cardiothoracic"
  urgency          String? // LOW | MEDIUM | HIGH | CRITICAL
  triggerSource    String // SYSTEM | MANUAL | SCHEDULED | EVENT
  triggeredById    String?
  status           String    @default("PENDING") // PENDING | PLAYING | PLAYED | ACKNOWLEDGED | EXPIRED | CANCELLED
  requireAck       Boolean   @default(false)
  ackCode          String? // staff confirmation code (optional)
  repeatUntilAck   Boolean   @default(false)
  repeatEverySec   Int       @default(30)
  lastPlayedAt     DateTime?
  acknowledgedAt   DateTime?
  acknowledgedById String?
  metadata         String? // JSON blob (event-specific data)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  acks        RadioAcknowledgment[]
  /// Sync metadata, maintained by the capture trigger in the sync migration.
  /// Declared here ONLY so `prisma migrate diff` does not read these columns as
  /// drift and generate a DROP for them. Application code must never write
  /// them: the trigger owns them, and an app-supplied value would break the
  /// version chain conflict detection depends on.
  syncVersion Int                   @default(0) @map("sync_version")
  syncOrigin  String?               @map("sync_origin")
  syncHlc     String?               @map("sync_hlc")

  @@index([status])
  @@index([priority])
  @@index([category])
  @@index([createdAt])
  @@map("radio_announcements")
}

// Audit log of acknowledgments (who/when responded)
model RadioAcknowledgment {
  id             String   @id @default(uuid())
  announcementId String
  userId         String
  userName       String?
  userRole       String?
  responseSecs   Int? // seconds from announcement creation to ack
  codeUsed       String?
  notes          String?
  createdAt      DateTime @default(now())

  announcement RadioAnnouncement @relation(fields: [announcementId], references: [id], onDelete: Cascade)

  @@index([announcementId])
  @@index([userId])
  @@map("radio_acknowledgments")
}

// AI assistant conversation log (lightweight)
model AssistantInteraction {
  id          String   @id @default(uuid())
  userId      String?
  userRole    String?
  question    String
  answer      String
  channel     String   @default("TEXT") // TEXT | VOICE
  contextPath String?
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
  @@map("assistant_interactions")
}

// ============================================================================
// SURGICAL CONSUMABLE & DRUG/DRESSING CATALOGS (admin-editable, scalable)
// Used during surgery booking to plan what the consumable-pack-provider
// pre-packs the night before, and what pharmacy packs for theatre.
// ============================================================================

enum SurgicalConsumableCategory {
  GLOVES // Disposable surgical gloves (sized variants below)
  GOWNS_DRAPES
  SUTURES
  SYRINGES_NEEDLES
  CATHETERS_TUBING
  DRESSING_PACKS
  SKIN_PREP
  CLEANING_SOLUTION // Theatre cleaning / disinfection solutions
  STERILE_DRESSINGS
  IRRIGATION
  DIATHERMY
  SUCTION
  ANAESTHESIA_AIRWAY
  PPE
  OTHER
}

model SurgicalConsumableTemplate {
  id              String                     @id @default(uuid())
  name            String
  category        SurgicalConsumableCategory @default(OTHER)
  size            String? // e.g. "6.5", "7.0", "Large", "500 ml"
  unit            String                     @default("piece") // piece, pair, pack, ml, L
  specialty       String? // Subspecialty hint, null = applies to all
  defaultQuantity Int                        @default(1)
  isActive        Boolean                    @default(true)
  sortOrder       Int                        @default(0)
  notes           String?
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt

  surgeryRequests SurgeryConsumableRequest[]

  @@index([category])
  @@index([specialty])
  @@map("surgical_consumable_templates")
}

enum SurgicalDrugDressingType {
  ANTIBIOTIC
  ANALGESIC
  ANAESTHETIC_ADJUNCT
  IV_FLUID
  WOUND_DRESSING_AGENT // Sofratulle, honey gauze, HERA wound gel, povidone iodine etc.
  ANTISEPTIC // Wound-Clex, hydrogen peroxide, chlorhexidine
  HAEMOSTATIC
  OTHER
}

model SurgicalDrugDressingTemplate {
  id              String                   @id @default(uuid())
  name            String
  type            SurgicalDrugDressingType @default(OTHER)
  defaultDosage   String? // e.g. "1 g IV stat"
  defaultRoute    String? // IV, IM, PO, Topical
  defaultQuantity Int                      @default(1)
  unit            String                   @default("vial")
  specialty       String? // Subspecialty hint, null = applies to all
  isControlled    Boolean                  @default(false)
  isActive        Boolean                  @default(true)
  sortOrder       Int                      @default(0)
  notes           String?
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt

  surgeryRequests SurgeryDrugDressingRequest[]

  @@index([type])
  @@index([specialty])
  @@map("surgical_drug_dressing_templates")
}

// ============================================================================
// PER-SURGERY PLANS captured at booking time
// ============================================================================

enum SurgeryPackStatus {
  REQUESTED
  PACKING
  PACKED
  DELIVERED
  CANCELLED
}

model SurgeryConsumableRequest {
  id              String                     @id @default(uuid())
  surgeryId       String
  templateId      String?
  name            String // Snapshot at time of booking
  category        SurgicalConsumableCategory @default(OTHER)
  size            String?
  unit            String                     @default("piece")
  quantity        Int                        @default(1)
  notes           String?
  status          SurgeryPackStatus          @default(REQUESTED)
  requestedById   String? // User who created/booked this request
  requestedByName String? // Snapshot of requester name at booking time
  packedById      String?
  packedByName    String?
  packedAt        DateTime?
  packNotes       String?
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt

  surgery     Surgery                     @relation("SurgeryConsumableRequests", fields: [surgeryId], references: [id])
  template    SurgicalConsumableTemplate? @relation(fields: [templateId], references: [id])
  packedBy    User?                       @relation("ConsumablePackedBy", fields: [packedById], references: [id])
  requestedBy User?                       @relation("ConsumableRequestedBy", fields: [requestedById], references: [id])

  @@index([surgeryId])
  @@index([status])
  @@map("surgery_consumable_requests")
}

model SurgeryDrugDressingRequest {
  id           String                   @id @default(uuid())
  surgeryId    String
  templateId   String?
  name         String // Snapshot at time of booking
  type         SurgicalDrugDressingType @default(OTHER)
  dosage       String?
  route        String?
  quantity     Int                      @default(1)
  unit         String                   @default("vial")
  notes        String?
  status       SurgeryPackStatus        @default(REQUESTED)
  packedById   String?
  packedByName String?
  packedAt     DateTime?
  packNotes    String?
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt

  surgery  Surgery                       @relation("SurgeryDrugDressingRequests", fields: [surgeryId], references: [id])
  template SurgicalDrugDressingTemplate? @relation(fields: [templateId], references: [id])
  packedBy User?                         @relation("DrugDressingPackedBy", fields: [packedById], references: [id])

  @@index([surgeryId])
  @@index([status])
  @@map("surgery_drug_dressing_requests")
}

// ============================================================================
// SURGICAL PACKS — reusable, named bundles a surgeon applies at booking.
// A CONSUMABLE pack expands into SurgeryConsumableRequest rows (to the pack
// providers); a PHARMACY pack expands into SurgeryDrugDressingRequest rows (to
// pharmacy). Keyed by subspecialty. Authored/curated by admins/pharmacists;
// only `isActive` packs are offered at booking. The mandatory base pack is
// separate (a code constant) and always attaches regardless of these.
// ============================================================================
enum SurgicalPackKind {
  CONSUMABLE
  PHARMACY
}

model SurgicalPack {
  id            String           @id @default(uuid())
  name          String
  subspecialty  String // e.g. "General Surgery", "Obstetrics & Gynaecology"
  kind          SurgicalPackKind
  description   String?
  isActive      Boolean          @default(false) // draft until an admin activates it
  sortOrder     Int              @default(0)
  createdById   String?
  createdByName String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  items SurgicalPackItem[]

  @@index([subspecialty, kind, isActive])
  @@map("surgical_packs")
}

model SurgicalPackItem {
  id        String  @id @default(uuid())
  packId    String
  name      String
  quantity  Int     @default(1)
  unit      String  @default("piece")
  // Consumable-pack fields (ignored for pharmacy packs)
  category  String? // a SurgicalConsumableCategory value
  size      String?
  // Pharmacy-pack fields (ignored for consumable packs)
  drugType  String? // a SurgicalDrugDressingType value
  dosage    String?
  route     String?
  notes     String?
  sortOrder Int     @default(0)

  pack SurgicalPack @relation(fields: [packId], references: [id], onDelete: Cascade)

  @@index([packId])
  @@map("surgical_pack_items")
}

// ============================================================================
// POST-OP PRESCRIPTION PHARMACY HAND-OFF
// Surgeon writes post-op meds → pharmacy is notified → packs → radio
// announces patient to pay bill → on payment, second radio announces pickup.
// ============================================================================

enum PostOpPrescriptionStatus {
  DRAFT
  SENT_TO_PHARMACY
  PACKING
  PACKED
  AWAITING_PAYMENT // Bill announced, waiting for patient to pay
  PAID // Bill paid, ready for pickup
  COLLECTED // Patient picked up medications
  CANCELLED
}

model PostOpPrescription {
  id           String  @id @default(uuid())
  surgeryId    String
  patientId    String
  patientName  String
  folderNumber String?

  prescribedById   String
  prescribedByName String
  prescribedAt     DateTime @default(now())

  // Medications: JSON array [{drugName, dosage, route, frequency, duration, quantity, isControlled}]
  medications String

  // Notes from surgeon
  notes String?

  status PostOpPrescriptionStatus @default(DRAFT)

  // Pharmacy
  receivedAt   DateTime? // When pharmacy first opened it
  packedById   String?
  packedByName String?
  packedAt     DateTime?
  packNotes    String?

  // Billing / pickup
  totalCost             Decimal?  @db.Decimal(10, 2)
  billAnnouncedAt       DateTime? // First radio call
  billPaidAt            DateTime?
  billPaidConfirmedById String?
  pickupAnnouncedAt     DateTime? // Second radio call
  collectedAt           DateTime?
  collectedByName       String? // Patient or relative

  // Audit
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  surgery      Surgery @relation("PostOpPrescriptionsSurgery", fields: [surgeryId], references: [id])
  patient      Patient @relation("PostOpPrescriptionsPatient", fields: [patientId], references: [id])
  prescribedBy User    @relation("PostOpPrescribedBy", fields: [prescribedById], references: [id])
  packedBy     User?   @relation("PostOpPackedBy", fields: [packedById], references: [id])
  /// Sync metadata, maintained by the capture trigger in the sync migration.
  /// Declared here ONLY so `prisma migrate diff` does not read these columns as
  /// drift and generate a DROP for them. Application code must never write
  /// them: the trigger owns them.
  syncVersion  Int     @default(0) @map("sync_version")
  syncOrigin   String? @map("sync_origin")
  syncHlc      String? @map("sync_hlc")

  @@index([surgeryId])
  @@index([status])
  @@map("postop_prescriptions")
}

// ============================================
// MEAL MENU & ORDERING (Cafeteria Manager)
// ============================================

enum MealItemCategory {
  BREAKFAST
  LUNCH
  DINNER
  SNACK
  BEVERAGE
  COMBO
}

enum MealAvailability {
  FREE_FOR_ON_DUTY
  PAID
}

enum MealOrderType {
  FREE
  PAID
}

enum MealPaymentStatus {
  NOT_REQUIRED
  PENDING_VERIFICATION
  VERIFIED
  REJECTED
  REFUNDED
}

enum MealOrderStatus {
  PLACED
  CONFIRMED
  PREPARING
  READY
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

/// Menu item published by the Theatre Cafeteria Manager.
/// FREE items are dispensed only to qualified on-duty staff.
/// PAID items can be ordered by any authenticated user with proof of payment.
model MealMenuItem {
  id            String           @id @default(uuid())
  name          String
  description   String?
  category      MealItemCategory
  availability  MealAvailability
  price         Decimal          @default(0) @db.Decimal(10, 2)
  currency      String           @default("NGN")
  imageUrl      String?
  isActive      Boolean          @default(true)
  /// Optional max servings the kitchen can prepare today (null = unlimited)
  dailyCapacity Int?
  /// Optional preparation time in minutes
  prepTimeMin   Int?

  createdById String
  createdBy   User   @relation("MealMenuItemCreator", fields: [createdById], references: [id])

  orderItems MealOrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([availability, isActive])
  @@index([category])
  @@map("meal_menu_items")
}

/// A meal order placed by any authenticated user (staff or otherwise).
/// FREE orders require the requester to be eligible (on-duty per roster
/// or surgical team today). PAID orders require payment evidence upload
/// before the kitchen will prepare them.
model MealOrder {
  id String @id @default(uuid())

  requesterId   String
  requester     User   @relation("MealOrderRequester", fields: [requesterId], references: [id])
  requesterName String // snapshot in case user is removed
  requesterRole String

  orderType   MealOrderType
  orderStatus MealOrderStatus @default(PLACED)

  // Totals
  totalAmount Decimal @default(0) @db.Decimal(10, 2)
  currency    String  @default("NGN")

  // Delivery
  deliveryLocation String // e.g. "Theatre 3 lounge", "PACU", "Holding bay"
  deliveryNotes    String?
  preferredTime    DateTime?

  // Payment (only relevant when orderType = PAID)
  paymentStatus           MealPaymentStatus @default(NOT_REQUIRED)
  paymentReference        String? // bank reference / pos receipt id provided by user
  paymentMethod           String? // e.g. "Bank Transfer", "POS", "Cash"
  paymentEvidenceFileName String?
  paymentEvidenceMimeType String?
  paymentEvidenceData     Bytes?
  paymentUploadedAt       DateTime?
  paymentVerifiedAt       DateTime?
  paymentVerifiedById     String?
  paymentVerifiedBy       User?             @relation("MealOrderPaymentVerifier", fields: [paymentVerifiedById], references: [id])
  paymentRejectionReason  String?

  // Fulfilment
  confirmedAt   DateTime?
  preparedAt    DateTime?
  readyAt       DateTime?
  deliveredAt   DateTime?
  deliveredById String?
  deliveredBy   User?     @relation("MealOrderDeliveredBy", fields: [deliveredById], references: [id])

  // Eligibility snapshot (for FREE orders) — captured at placement time
  eligibilitySource String? // "ROSTER" | "SURGICAL_TEAM" | "MANUAL_OVERRIDE"
  eligibilityNotes  String?

  cancelledAt        DateTime?
  cancellationReason String?

  items MealOrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([requesterId, createdAt])
  @@index([orderStatus, createdAt])
  @@index([paymentStatus])
  @@map("meal_orders")
}

model MealOrderItem {
  id String @id @default(uuid())

  orderId String
  order   MealOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  menuItemId String
  menuItem   MealMenuItem @relation(fields: [menuItemId], references: [id])

  // Snapshot fields so historic orders survive menu edits / deletions
  nameSnapshot         String
  categorySnapshot     MealItemCategory
  availabilitySnapshot MealAvailability
  unitPrice            Decimal          @default(0) @db.Decimal(10, 2)
  quantity             Int              @default(1)
  lineTotal            Decimal          @default(0) @db.Decimal(10, 2)
  notes                String?

  createdAt DateTime @default(now())

  @@index([orderId])
  @@index([menuItemId])
  @@map("meal_order_items")
}

// ===========================================================================
// SCRUB MANAGEMENT MODULE
// Color-coded, serial-numbered scrub sets signed out by theatre staff, with a
// laundry workflow (receive → confirm → ready), missing-item alerts, daily
// reports, and a laundry shift roster (morning/night) with a manager.
// ===========================================================================

enum ScrubColor {
  GREEN // Surgeons
  BLUE // Anaesthetists / Consultant Anaesthetists
  MAROON // Scrub & Recovery Room Nurses
  TEAL // Anaesthetic Technicians
  GREY // Porters & Support Staff
  BLACK // General / Other
}

enum ScrubSetStatus {
  AVAILABLE // unassigned, in central pool
  RESERVE // assigned to a staff member, kept as spare
  IN_USE // signed out / currently worn
  IN_CLEANING // sent to laundry
  MISSING // not returned / lost
  RETIRED // damaged or decommissioned
}

enum ScrubTxnStatus {
  ISSUED
  RETURNED
  OVERDUE
  LOST
}

enum ScrubLaundryStatus {
  RECEIVED
  IN_PROGRESS
  READY
  INCOMPLETE
}

enum ScrubShiftType {
  MORNING
  NIGHT
}

enum ScrubGarment {
  SET // legacy / combined top+pants tracked as one
  TOP // scrub top only (shelf side: tops)
  PANTS // scrub pants only (shelf side: pants)
}

model ScrubSet {
  id           String         @id @default(uuid())
  serialNumber String         @unique
  garment      ScrubGarment   @default(SET) // TOP or PANTS for shelf-separated stock
  color        ScrubColor
  size         String         @default("M") // S | M | L | XL | XXL
  status       ScrubSetStatus @default(AVAILABLE)

  // Owner — each staff member is allocated >= 3 sets (in-use / cleaning / reserve)
  ownerId   String?
  ownerName String?
  ownerRole String?

  // Current holder of a signed-out set (normally the owner)
  currentHolderId   String?
  currentHolderName String?

  condition     String?
  retiredAt     DateTime?
  retiredReason String?

  transactions ScrubTransaction[]
  laundryItems ScrubLaundryItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
  @@index([status])
  @@index([color])
  @@map("scrub_sets")
}

model ScrubTransaction {
  id String @id @default(uuid())

  scrubSetId   String
  scrubSet     ScrubSet   @relation(fields: [scrubSetId], references: [id])
  serialNumber String // snapshot
  color        ScrubColor

  // Who signed it out
  userId   String
  userName String
  userRole String?

  status ScrubTxnStatus @default(ISSUED)

  issuedAt     DateTime @default(now())
  issuedById   String?
  issuedByName String?

  returnedAt     DateTime?
  returnedById   String?
  returnedByName String?

  dueBack DateTime? // expected return (end of shift)
  notes   String?

  // Clean theatre footwear issued together with the scrub set. Each pair is
  // serial/size tracked and must come back with the scrub.
  footwearSerial     String?
  footwearSize       String?
  footwearIssued     Boolean   @default(false)
  footwearReturned   Boolean   @default(false)
  footwearReturnedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, issuedAt])
  @@index([scrubSetId])
  @@index([status])
  @@map("scrub_transactions")
}

model ScrubLaundryBatch {
  id        String             @id @default(uuid())
  batchDate DateTime           @default(now()) // operating day this batch serves
  shift     ScrubShiftType     @default(MORNING)
  status    ScrubLaundryStatus @default(RECEIVED)

  receivedById   String?
  receivedByName String?
  managerId      String?
  managerName    String?

  expectedCount Int @default(0)
  receivedCount Int @default(0)
  readyCount    Int @default(0)
  missingCount  Int @default(0)

  readyForNextDay Boolean   @default(false)
  readyReportedAt DateTime?
  notes           String?

  items ScrubLaundryItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([batchDate, shift])
  @@index([status])
  @@map("scrub_laundry_batches")
}

model ScrubLaundryItem {
  id String @id @default(uuid())

  batchId String
  batch   ScrubLaundryBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  scrubSetId   String?
  scrubSet     ScrubSet?  @relation(fields: [scrubSetId], references: [id])
  serialNumber String
  color        ScrubColor

  received   Boolean   @default(false)
  receivedAt DateTime?
  ready      Boolean   @default(false)
  readyAt    DateTime?
  missing    Boolean   @default(false)
  condition  String?

  createdAt DateTime @default(now())

  @@index([batchId])
  @@index([serialNumber])
  @@map("scrub_laundry_items")
}

model ScrubAlert {
  id           String    @id @default(uuid())
  type         String // MISSING_ITEM | OVERDUE_RETURN | LOW_INVENTORY | INCOMPLETE_BATCH
  severity     String    @default("MEDIUM") // LOW | MEDIUM | HIGH | CRITICAL
  message      String
  serialNumber String?
  scrubSetId   String?
  userId       String?
  userName     String?
  resolved     Boolean   @default(false)
  resolvedAt   DateTime?
  resolvedById String?
  createdAt    DateTime  @default(now())

  @@index([resolved, createdAt])
  @@index([type])
  @@map("scrub_alerts")
}

model ScrubShift {
  id          String         @id @default(uuid())
  shiftDate   DateTime
  shiftType   ScrubShiftType
  managerId   String?
  managerName String?
  staffIds    String         @default("[]") // JSON array of laundry staff user ids
  staffNames  String         @default("[]") // JSON array of laundry staff names

  targetStaffCount   Int @default(0) // 4–5 (morning) | 2 (night)
  theatreStaffServed Int @default(300)

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([shiftDate, shiftType])
  @@index([shiftDate])
  @@map("scrub_shifts")
}

// Self-declared scrub & footwear sizes for a staff member, keyed by their
// staff code. Filled in via a public, no-login page so staff can record their
// sizes once. When a scrub-care provider enters the staff code at pickup, the
// stored sizes (plus the role-based scrub colour) are shown so the right scrub
// set and footwear can be handed over quickly.
model StaffScrubProfile {
  id        String @id @default(uuid())
  staffCode String @unique

  // Snapshot of the matched user (resolved from staffCode when available)
  fullName String?
  role     String?

  scrubSize    String // legacy single size (kept = top size for back-compat)
  topSize      String? // scrub top size (shelf side: tops)
  pantsSize    String? // scrub pants size (shelf side: pants)
  footwearSize String // EU shoe size, e.g. 42

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([staffCode])
  @@map("staff_scrub_profiles")
}

// Daily handout of a scrub top + pants (+ footwear) to a staff member, with the
// exact serial codes entered by the scrub-care provider at pickup.
model ScrubPickup {
  id        String @id @default(uuid())
  staffCode String

  // Snapshot of who collected
  fullName String?
  role     String?
  color    String? // role-based scrub colour at time of pickup

  topSerial      String? // serial code of the scrub top handed out
  pantsSerial    String? // serial code of the scrub pants handed out
  footwearSerial String?

  topSize      String?
  pantsSize    String?
  footwearSize String?

  // Who issued it (scrub-care provider)
  pickedUpById   String?
  pickedUpByName String?
  pickedUpAt     DateTime @default(now())

  returned   Boolean   @default(false)
  returnedAt DateTime?
  notes      String?

  createdAt DateTime @default(now())

  @@index([staffCode, pickedUpAt])
  @@index([pickedUpAt])
  @@map("scrub_pickups")
}

// ===========================================================================
// IMPREST MANAGEMENT AND RETIREMENT SYSTEM
// ---------------------------------------------------------------------------
// Merged from the standalone imprest monorepo (apps/api/prisma/schema.prisma).
// Staff identity is the theatre `User`; imprest carries no second account
// table. Every table is mapped with an `imprest_` prefix.
//
// Design rules inherited from the source schema, and preserved here:
//   • MONEY IS BIGINT KOBO — no floating point currency anywhere.
//   • NOTHING IS HARD DELETED — deletedAt/deletedById/deletionReason.
//   • OPTIMISTIC CONCURRENCY — `version` on every synchronisable row.
//   • DENORMALISED WITNESS FIELDS — a printed retirement must still read
//     correctly years later, after vendors are renamed or staff transfer.
// ===========================================================================

/// Nigerian Civil Service quarterly imprest cycle. The standing imprest is
/// released once per quarter and must be fully retired before the next is issued.
enum Quarter {
  Q1
  Q2
  Q3
  Q4
}

enum ImprestStatus {
  DRAFT
  ACTIVE
  PARTIALLY_RETIRED
  FULLY_RETIRED
  CLOSED
  CANCELLED
}

enum ExpenditureStatus {
  DRAFT
  POSTED
  QUERIED
  RETIRED
  VOIDED
}

enum PaymentMethod {
  CASH
  TRANSFER
  POS
  CHEQUE
}

enum WorkflowStage {
  PREPARED
  SUBMITTED
  ACCOUNTS_REVIEW
  INTERNAL_AUDIT
  CHIEF_ACCOUNTANT_REVIEW
  MEDICAL_DIRECTOR_REVIEW
  APPROVED
  COMPLETED
  RETURNED
  REJECTED
  /// Pre-reconfiguration stages, kept so existing rows remain readable.
  ACCOUNT_OFFICER_REVIEW
  CHAIRMAN_REVIEW
  FINANCE_REVIEW
  CLOSED
}

enum ApprovalDecision {
  APPROVE
  REJECT
  QUERY
}

enum RetirementStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  RETURNED
  QUERIED
  APPROVED
  REJECTED
  COMPLETED
  /// Retained so historical rows keep their meaning; superseded by
  /// UNDER_REVIEW and COMPLETED respectively.
  IN_REVIEW
  CLOSED
}

enum AttachmentKind {
  RECEIPT
  INVOICE
  PAYMENT_VOUCHER
  DELIVERY_NOTE
  WAYBILL
  QUOTATION
  APPROVAL_LETTER
  BANK_SLIP
  OTHER
}

enum SignatureKind {
  PREPARER
  OFFICER
  WITNESS
  APPROVER
  CERTIFIER
}

enum DocumentType {
  IMPREST_REGISTER
  CASH_BOOK
  EXPENSE_REGISTER
  RETIREMENT_FORM
  APPROVAL_SHEET
  RECEIPT_REGISTER
  SUMMARY_REPORT
  VENDOR_REGISTER
  AUDIT_REPORT
  PAYMENT_VOUCHER
}

enum AuditAction {
  CREATE
  UPDATE
  SOFT_DELETE
  RESTORE
  SUBMIT
  APPROVE
  REJECT
  QUERY
  CLOSE
  /// Administrative unlock of an approved retirement. Always carries a reason.
  REOPEN
  CANCEL
  LOGIN
  LOGIN_FAILED
  LOGOUT
  PASSWORD_CHANGE
  TWO_FACTOR_ENABLED
  TWO_FACTOR_DISABLED
  EXPORT
  PRINT
  UPLOAD
  SYNC
  PERMISSION_DENIED
}

enum AuditEntity {
  USER
  IMPREST
  EXPENDITURE
  ATTACHMENT
  RETIREMENT
  APPROVAL
  VENDOR
  CATEGORY
  BUDGET_HEAD
  DEPARTMENT
  SETTING
  SESSION
  DOCUMENT
}

enum ImprestNotificationType {
  PENDING_RETIREMENT
  LATE_RETIREMENT
  APPROVAL_NEEDED
  RECEIPT_MISSING
  BUDGET_EXHAUSTED
  RETIREMENT_COMPLETED
  EXPENDITURE_QUERIED
  IMPREST_RECEIVED
}

enum NotificationSeverity {
  INFO
  WARNING
  CRITICAL
}

enum SyncMutationState {
  PENDING
  APPLIED
  REJECTED
  CONFLICT
}

enum ConflictResolution {
  SERVER
  CLIENT
  MANUAL
}

model Department {
  id       String  @id @default(uuid()) @db.Uuid
  code     String  @unique
  name     String
  office   String?
  isActive Boolean @default(true)

  // The imprest system no longer owns user accounts, so a department does not
  // list members here — theatre staff belong to a department on the User record.
  imprests        Imprest[]
  roleAssignments ImprestRoleAssignment[]

  version        Int       @default(1)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  createdById    String?
  updatedById    String?
  deletedAt      DateTime?
  deletedById    String?
  deletionReason String?

  @@index([deletedAt])
  @@index([updatedAt])
  @@map("imprest_departments")
}

model BudgetHead {
  id          String  @id @default(uuid()) @db.Uuid
  code        String  @unique
  name        String
  description String?
  isActive    Boolean @default(true)

  voteCodes    VoteCode[]
  imprests     Imprest[]
  expenditures Expenditure[]
  categories   ExpenseCategory[]

  version        Int       @default(1)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  createdById    String?
  updatedById    String?
  deletedAt      DateTime?
  deletedById    String?
  deletionReason String?

  @@index([deletedAt])
  @@index([updatedAt])
  @@map("imprest_budget_heads")
}

model VoteCode {
  id       String  @id @default(uuid()) @db.Uuid
  code     String  @unique
  name     String
  isActive Boolean @default(true)

  budgetHeadId String?     @db.Uuid
  budgetHead   BudgetHead? @relation(fields: [budgetHeadId], references: [id], onDelete: SetNull)

  imprests     Imprest[]
  expenditures Expenditure[]

  version        Int       @default(1)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  createdById    String?
  updatedById    String?
  deletedAt      DateTime?
  deletedById    String?
  deletionReason String?

  @@index([budgetHeadId])
  @@index([deletedAt])
  @@index([updatedAt])
  @@map("imprest_vote_codes")
}

model CostCentre {
  id       String  @id @default(uuid()) @db.Uuid
  code     String  @unique
  name     String
  isActive Boolean @default(true)

  imprests Imprest[]

  version        Int       @default(1)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  createdById    String?
  updatedById    String?
  deletedAt      DateTime?
  deletedById    String?
  deletionReason String?

  @@index([deletedAt])
  @@index([updatedAt])
  @@map("imprest_cost_centres")
}

model ExpenseCategory {
  id        String  @id @default(uuid()) @db.Uuid
  name      String
  /// Seeded categories cannot be removed, only deactivated.
  isSystem  Boolean @default(false)
  isActive  Boolean @default(true)
  sortOrder Int     @default(100)

  parentId String?           @db.Uuid
  parent   ExpenseCategory?  @relation("ImprestCategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children ExpenseCategory[] @relation("ImprestCategoryTree")

  defaultBudgetHeadId String?     @db.Uuid
  defaultBudgetHead   BudgetHead? @relation(fields: [defaultBudgetHeadId], references: [id], onDelete: SetNull)

  expenditures    Expenditure[] @relation("ImprestExpenditureCategory")
  subExpenditures Expenditure[] @relation("ImprestExpenditureSubcategory")

  version        Int       @default(1)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  createdById    String?
  updatedById    String?
  deletedAt      DateTime?
  deletedById    String?
  deletionReason String?

  @@unique([name, parentId])
  @@index([parentId])
  @@index([deletedAt])
  @@index([updatedAt])
  @@map("imprest_expense_categories")
}

model FinancialYear {
  id        String   @id @default(uuid()) @db.Uuid
  label     String   @unique
  startDate DateTime @db.Date
  endDate   DateTime @db.Date
  isCurrent Boolean  @default(false)
  isClosed  Boolean  @default(false)

  imprests  Imprest[]
  sequences DocumentSequence[]

  version        Int       @default(1)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  createdById    String?
  updatedById    String?
  deletedAt      DateTime?
  deletedById    String?
  deletionReason String?

  @@index([isCurrent])
  @@index([updatedAt])
  @@map("imprest_financial_years")
}

model Vendor {
  id            String  @id @default(uuid()) @db.Uuid
  name          String
  phone         String?
  address       String?
  /// Encrypted at rest — see services/crypto.service.ts.
  tin           String?
  bankName      String?
  accountNumber String?
  isActive      Boolean @default(true)

  expenditures Expenditure[]

  version        Int       @default(1)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  createdById    String?
  updatedById    String?
  deletedAt      DateTime?
  deletedById    String?
  deletionReason String?

  stockBatches StockBatch[] @relation("StockBatchVendor")

  invoiceLines    InvoiceLine[]    @relation("InvoiceLineVendor")
  revenueAccounts RevenueAccount[] @relation("RevenueAccountVendor")

  @@unique([name, phone])
  @@index([name])
  @@index([deletedAt])
  @@index([updatedAt])
  @@map("imprest_vendors")
}

model Signature {
  id   String        @id @default(uuid()) @db.Uuid
  kind SignatureKind

  /// PNG data URL captured from mouse, touch or stylus.
  imageData           String
  signedByName        String
  signedByDesignation String
  signedAt            DateTime @default(now())

  signedById String?
  signedBy   User?   @relation(fields: [signedById], references: [id], onDelete: SetNull)

  /// SHA-256 over the signed payload — binds the mark to the document state.
  contentHash String

  expenditureId String?      @db.Uuid
  expenditure   Expenditure? @relation(fields: [expenditureId], references: [id], onDelete: Cascade)
  retirementId  String?      @db.Uuid
  retirement    Retirement?  @relation(fields: [retirementId], references: [id], onDelete: Cascade)
  approval      Approval?

  ipAddress String?
  userAgent String?

  createdAt DateTime @default(now())

  @@index([expenditureId])
  @@index([retirementId])
  @@index([signedById])
  @@map("imprest_signatures")
}

model Imprest {
  id             String  @id @default(uuid()) @db.Uuid
  imprestNumber  String  @unique
  voucherNumber  String?
  approvalNumber String?

  /// Which quarter's standing imprest this is. One active imprest per quarter,
  /// and the next cannot be raised until this one is retired and approved.
  quarter                Quarter?
  /// Treasury voucher on which Hospital Management released the funds — quoted
  /// on the retirement so Accounts can trace the release.
  treasuryVoucherNumber  String?
  /// Set when the retirement is submitted, and when Management approves it.
  retirementDate         DateTime? @db.Date
  approvalDate           DateTime? @db.Date
  /// False until this imprest is fully retired and approved. The gate on
  /// releasing the next quarter's funds.
  eligibleForNextQuarter Boolean   @default(false)

  financialYearId String        @db.Uuid
  financialYear   FinancialYear @relation(fields: [financialYearId], references: [id])

  departmentId String     @db.Uuid
  department   Department @relation(fields: [departmentId], references: [id])
  office       String?

  dateApproved DateTime  @db.Date
  dateReceived DateTime? @db.Date

  /// Kobo.
  amountApproved BigInt
  /// Kobo.
  amountReceived BigInt @default(0)

  receivingOfficerId String
  receivingOfficer   User   @relation("ImprestImprestReceivingOfficer", fields: [receivingOfficerId], references: [id])

  purpose       String
  fundingSource String?

  budgetHeadId String?     @db.Uuid
  budgetHead   BudgetHead? @relation(fields: [budgetHeadId], references: [id], onDelete: SetNull)
  voteCodeId   String?     @db.Uuid
  voteCode     VoteCode?   @relation(fields: [voteCodeId], references: [id], onDelete: SetNull)
  costCentreId String?     @db.Uuid
  costCentre   CostCentre? @relation(fields: [costCentreId], references: [id], onDelete: SetNull)

  expectedRetirementDate DateTime      @db.Date
  status                 ImprestStatus @default(DRAFT)

  /// Rollups maintained inside the same transaction as expenditure writes, so
  /// a list screen never has to aggregate the whole ledger to show a balance.
  totalExpenditure BigInt @default(0)
  totalRetired     BigInt @default(0)
