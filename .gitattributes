# Shell scripts MUST keep LF endings. They are authored on Windows but run on
# the Ubuntu local server, and a CRLF shebang fails there with the notoriously
# unhelpful "bad interpreter: /usr/bin/env bash^M".
*.sh text eol=lf

# The Prisma schema and the migrations MUST keep LF endings too, for a
# different reason: the guardrail suite in scripts/lib-tests parses both with
# line-anchored regexes. A carriage return is a line terminator in a JS regex,
# so `.` will not consume one and `$` will not match past one. On a Windows
# checkout with core.autocrlf=true every line therefore ends in CR, the
# parsers match nothing, and the sync capture / blob / ignored-column
# guardrails all fail at once -- a red suite that looks like a broken repo
# rather than a line-ending setting, which is how a safety net stops being
# trusted.
*.prisma text eol=lf
*.sql    text eol=lf

# Treat all binary asset formats as binary to prevent line-ending
# conversion from corrupting them on Windows checkouts.
*.pdf binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.mp3 binary
*.wav binary
*.ogg binary
*.mp4 binary
*.zip binary
*.gz binary
*.tgz binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.eot binary
