// ===== NEW ENHANCED MODULES =====

// Enums for Pre-Operative Assessment Module
enum PreOpReviewStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  APPROVED
}

/// The one question the rest of the theatre needs answered: may this patient
/// have this anaesthetic today. Two values, because the prose it replaced was
/// read two ways by two people.
enum AnaestheticFitness {
  FIT
  NOT_FIT
}

/// COMPLETED and VERIFIED are deliberately distinct. The person who does the
/// work says COMPLETED; somebody checking says VERIFIED. Collapsed into one,
/// the only evidence a correction happened is the word of whoever was asked
/// to do it.
enum OptimisationStatus {
  OUTSTANDING
  IN_PROGRESS
  COMPLETED
  VERIFIED
}

enum OptimisationPriority {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

enum PrescriptionStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  DISPENSED
  PACKED
  PARTIALLY_PACKED
  LATE_ARRIVAL
  COLLECTED // Anaesthetist has collected medications from pharmacy
  IN_USE // Medications are being used in surgery
  RECONCILED // Post-surgery reconciliation complete
  RETURNED // Unused medications returned to pharmacy
  QUERY_ISSUED // Non-return query issued to anaesthetist
  /// Withdrawn before it was acted on. Distinct from REJECTED, which is a
  /// consultant declining to approve — this is the prescriber standing it down.
  CANCELLED
  /// Replaced by a later version. The row keeps its medications exactly as
  /// they were prescribed and points at what replaced it; it is never edited.
  SUPERSEDED
}

enum MedicationUrgency {
  ROUTINE
  URGENT
  EMERGENCY
}

enum BloodRequestStatus {
  REQUESTED
  ACKNOWLEDGED
  IN_PREPARATION
  READY
  DELIVERED
  CANCELLED
}

enum EmergencyAlertStatus {
  ACTIVE
  ACKNOWLEDGED
  RESOLVED
  CANCELLED
}

enum EmergencyAlertPriority {
  CRITICAL
  HIGH
  MEDIUM
}

// Pre-Operative Anesthetic Review Model
model PreOperativeAnestheticReview {
  id String @id @default(uuid())

  // Patient & Surgery Info
  surgeryId    String @unique
  patientId    String
  patientName  String
  folderNumber String

  // Anesthetist Info
  anesthetistId           String // Resident/registrar conducting review
  anesthetistName         String
  consultantAnesthetistId String? // Consultant who will approve
  consultantName          String?

  // Review Details
  reviewDate           DateTime @default(now())
  scheduledSurgeryDate DateTime

  // Clinical Assessment
  currentMedications String? // JSON array
  allergies          String? // JSON array
  comorbidities      String? // JSON array
  previousAnesthesia String?
  lastOralIntake     DateTime?
  fastingStatus      String?

  // Physical Examination
  weight          Float?
  height          Float?
  bmi             Float?
  bloodPressure   String?
  heartRate       Int?
  respiratoryRate Int?
  temperature     Float?

  // Airway Assessment
  airwayClass  String? // Mallampati class
  neckMovement String?
  dentition    String?

  // Lab Results
  hemoglobin      Float?
  plateletCount   Int?
  ptInr           Float?
  creatinine      Float?
  sodium          Float?
  potassium       Float?
  bloodGlucose    Float?
  otherLabResults String? // JSON

  // ASA Classification
  asaClass String?

  // Anesthetic Plan
  proposedAnesthesiaType AnesthesiaType?
  anestheticPlan         String? // Detailed plan
  specialConsiderations  String?

  // Risk Assessment
  riskLevel   String? // LOW, MODERATE, HIGH
  riskFactors String? // JSON array

  // Status
  status PreOpReviewStatus @default(IN_PROGRESS)

  // Approval
  approvedAt      DateTime?
  approvedBy      String?
  approvalNotes   String?
  rejectionReason String?

  // General Notes
  /// Superseded by fitnessDecision and the optimisation requirements below,
  /// and RETAINED rather than dropped. Reviews written before that change
  /// carry real clinical prose in these columns; deleting them to tidy the
  /// model would destroy the record of what an anaesthetist actually said.
  /// The form no longer collects them. Where a value exists it is shown, read
  /// only, so an old review still reads as it was written.
  reviewNotes     String?
  recommendations String?

  /// Mandatory before a review can be completed. Nullable in the column
  /// because reviews written before this existed have no answer, and
  /// backfilling one would be inventing a clinical decision nobody made.
  fitnessDecision     AnaestheticFitness?
  fitnessDecidedAt    DateTime?
  fitnessDecidedById  String?

  /// Set when an anaesthetist has reassessed after the requirements were
  /// addressed. Without it, completing every task changes nothing — a patient
  /// declared unfit stays unfit until a person says otherwise.
  reassessedAt   DateTime?
  reassessedById String?
  reassessmentNote String? @db.Text

  optimisationRequirements AnaestheticOptimisationRequirement[] @relation("ReviewOptimisation")

  // Anaesthesia consent (WHO-aligned legal text) — signed electronically by the
  // patient/representative or an uploaded photo/scan of the signed form.
  anaesthesiaConsentText      String?   @db.Text
  anaesthesiaConsentSignature String?   @db.Text // base64 signature/scan (data URL)
  anaesthesiaConsentSignedBy  String?
  anaesthesiaConsentRelation  String? // Self / Representative relationship
  anaesthesiaConsentMethod    String? // ELECTRONIC | UPLOADED
  anaesthesiaConsentSignedAt  DateTime?

  // Was the patient physically present in the ward at the planned review time?
  patientInWardAtReview Boolean?
  patientAbsenceNote    String? // e.g. "away for imaging", "not admitted yet"

  // Audit
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  surgery               Surgery                  @relation("PreOpReviews", fields: [surgeryId], references: [id])
  patient               Patient                  @relation("PatientPreOpReviews", fields: [patientId], references: [id])
  anesthetist           User                     @relation("AnesthetistReviews", fields: [anesthetistId], references: [id])
  consultantAnesthetist User?                    @relation("ConsultantReviews", fields: [consultantAnesthetistId], references: [id])
  prescriptions         AnestheticPrescription[]

  @@map("preoperative_anesthetic_reviews")
}

/// What must be addressed before an unfit patient can proceed.
///
/// One row per thing that has to happen, because the free text it replaces
/// could not be assigned, counted, or chased. A requirement with no owner is a
/// wish, so `responsible` is recorded; a requirement with no action is a
/// category, so `action` is required in the API rather than merely present.
///
/// Rows are never deleted when a requirement stops being relevant — the status
/// moves and the history stays, in line with preserving clinical history when
/// a record is amended.
model AnaestheticOptimisationRequirement {
  id String @id @default(uuid())

  reviewId  String
  surgeryId String
  patientId String?

  /// Free-text-backed so an institution can add a category without a
  /// migration. The offered list lives in lib/anaesthesia/fitness.ts.
  category String
  action   String @db.Text

  /// Who is being asked — a person, a team, or a unit.
  responsible      String?
  targetCompletion DateTime?

  priority OptimisationPriority @default(MEDIUM)
  status   OptimisationStatus   @default(OUTSTANDING)

  raisedById String
  raisedAt   DateTime @default(now())

  /// Claimed done, and separately confirmed. Both carry who and when.
  completedById String?
  completedAt   DateTime?
  verifiedById  String?
  verifiedAt    DateTime?

  notes String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  review PreOperativeAnestheticReview @relation("ReviewOptimisation", fields: [reviewId], references: [id], onDelete: Cascade)

  @@index([surgeryId])
  @@index([reviewId])
  @@index([status])
  @@map("anaesthetic_optimisation_requirements")
}

// Anesthetic Prescription Model
model AnestheticPrescription {
  id String @id @default(uuid())

  // Link to Pre-Op Review
  preOpReviewId String
  surgeryId     String
  patientId     String
  patientName   String

  // Prescriber Info
  prescribedById   String // Anesthetist who created prescription
  prescribedByName String
  prescriptionDate DateTime @default(now())

  // Approval Info
  approvedById    String? // Consultant anesthetist
  approvedByName  String?
  approvedAt      DateTime?
  rejectionReason String?

  // Pharmacist Info
  packedById   String? // Pharmacist who packed medications
  packedByName String?
  packedAt     DateTime?
  packingNotes String?

  // Prescription Details
  medications    String // JSON array of medications with doses, routes, timing
  fluids         String? // IV fluids
  emergencyDrugs String? // Emergency medications

  // Timing
  scheduledSurgeryDate DateTime
  urgency              MedicationUrgency @default(ROUTINE)

  // Status
  status PrescriptionStatus @default(DRAFT)

  /// An amendment is a NEW ROW, never an edit. The previous version keeps its
  /// medications exactly as prescribed, is marked SUPERSEDED, and points at
  /// what replaced it — so pharmacy can always answer "what was I asked for,
  /// and by whom, at the moment I packed this". An overwritten row cannot.
  version            Int       @default(1)
  /// Both ends of the link are stored so the chain can be walked either way.
  supersedesId       String?
  supersededById     String?
  supersededAt       DateTime?
  amendedById        String?
  amendedByName      String?
  amendedAt          DateTime?
  /// Read by pharmacy before re-packing, so the API requires it.
  amendmentReason    String?   @db.Text
  cancelledById      String?
  cancelledAt        DateTime?
  cancellationReason String?   @db.Text

  // Special Instructions
  specialInstructions String?
  allergyAlerts       String? // Highlighted allergies

  // Late Arrival Tracking
  isLateArrival        Boolean   @default(false)
  lateArrivalFlaggedAt DateTime?
  approvalDeadline     DateTime? // Default: 6 PM day before surgery

  // Out-of-Stock Tracking
  outOfStockItems      String? // JSON: items that are out of stock
  hasOutOfStockItems   Boolean   @default(false)
  outOfStockNotifiedAt DateTime?

  // Individual medication packing status
  medicationPackingStatus String? // JSON: per-medication packed/not-packed/out-of-stock

  // Notes
  prescriptionNotes String?
  pharmacistNotes   String?

  // Audit
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  preOpReview       PreOperativeAnestheticReview @relation(fields: [preOpReviewId], references: [id])
  surgery           Surgery                      @relation("SurgeryPrescriptions", fields: [surgeryId], references: [id])
  patient           Patient                      @relation("PatientPrescriptions", fields: [patientId], references: [id])
  prescribedBy      User                         @relation("PrescribedBy", fields: [prescribedById], references: [id])
  approvedBy        User?                        @relation("ApprovedBy", fields: [approvedById], references: [id])
  packedBy          User?                        @relation("PackedBy", fields: [packedById], references: [id])
  prescriptionItems PrescriptionMedicationItem[]

  // Medication Tracking Relations
  medicationCollections    MedicationCollection[]
  medicationUsageRecords   MedicationUsageRecord[]
  medicationReconciliation MedicationReconciliation?
