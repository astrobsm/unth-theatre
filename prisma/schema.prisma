// ---------------------------------------------------------------------------
// Imprest duty assignment
// ---------------------------------------------------------------------------
// The imprest system originally carried its own accounts with their own role
// column. Identity is now the theatre `User`, but an imprest duty is NOT the
// same thing as a clinical role: the cashier may be a nurse, the account officer
// may be an administrator, and the approval chain is driven by the imprest duty
// alone. So the duty lives here, assigned per user, leaving `User.role`
// untouched.
//
// A user with no row here has no imprest access at all — access is granted
// deliberately, not inherited from a clinical role.

enum ImprestRole {
  ADMINISTRATOR
  CHIEF_ACCOUNTANT
  MEDICAL_DIRECTOR
  CHAIRMAN
  ACCOUNT_OFFICER
  CASHIER
  INTERNAL_AUDITOR
  HOSPITAL_MANAGEMENT
  FINANCE
  VIEW_ONLY_AUDITOR
}

model ImprestRoleAssignment {
  id     String      @id @default(uuid())
  userId String
  user   User        @relation("ImprestRoleAssignments", fields: [userId], references: [id], onDelete: Cascade)
  role   ImprestRole

  /// Designation as it should appear on printed vouchers and approval sheets —
  /// a witness field, so a reprint years later still names the office correctly.
  designation String?

  /// Which imprest department this duty applies to. Null = all departments.
  departmentId String?     @db.Uuid
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  isActive     Boolean   @default(true)
  assignedAt   DateTime  @default(now())
  assignedById String?
  revokedAt    DateTime?
  revokedById  String?

  @@unique([userId, role, departmentId])
  @@index([userId])
  @@index([role])
  @@map("imprest_role_assignments")
}

// ============================================================================
// THEATRE SUPPLY CHAIN — batch-level stock, movement and reservation
// ----------------------------------------------------------------------------
// Extends the existing InventoryItem rather than replacing it. InventoryItem
// stays what it has always been: the CATALOGUE entry — "Vicryl 2/0", one row,
// one name, one category. What it could never express is the physical reality
// underneath: two lots of the same suture with different expiry dates, one of
// them owned by a vendor on consignment and one by the hospital, half of one
// lot already held for tomorrow's list.
//
// StockBatch is that physical lot. StockMovement is the append-only record of
// every hand it passes through — nothing is ever deleted, and a batch's running
// counters can always be recomputed from its movements (see lib/stock/reconcile,
// which reports drift rather than trusting the counters).
//
// ID TYPES MATTER HERE. User, Surgery and InventoryItem are TEXT ids; the
// imprest Vendor is @db.Uuid. A foreign key between the two types is rejected
// by Postgres — that mistake cost a rolled-back migration on the imprest work,
// so every relation below is annotated with the type it has to match.
//
// Money is integer kobo, never a float and never Decimal — the same rule the
// imprest module follows. A theatre invoice can carry forty lines, and rounding
// twice per line is how a bill stops reconciling.
// ============================================================================

/// Who owns the stock right now. Consignment stock stays the vendor's property
/// until it is consumed; that transfer of ownership is the billable event.
enum StockOwner {
  HOSPITAL
  VENDOR
  CSSD
  THEATRE
}

enum StockBatchStatus {
  AVAILABLE
  RESERVED
  ISSUED
  RETURNED
  QUARANTINED
  EXPIRED
  DISPOSED
  LOST
}

/// Every way stock can move. Append-only: a mistake is corrected with a
/// compensating ADJUST movement, never by editing history.
enum StockMovementType {
  RECEIVE
  RESERVE
  RELEASE_RESERVATION
  ISSUE
  RETURN
  CONSUME
  TRANSFER
  ADJUST
  QUARANTINE
  EXPIRE
  DISPOSE
  OWNERSHIP_TRANSFER
}

enum StockReservationStatus {
  RESERVED
  PARTIALLY_ISSUED
  ISSUED
  CONSUMED
  RELEASED
  CANCELLED
}

/// The Theatre Supply Unit's physical stores. Seeded, but editable — a hospital
/// may have no cold chain store, and may add others.
model StockLocation {
  id            String  @id @default(uuid())
  code          String  @unique
  name          String
  description   String?
  /// Controlled drugs require a witness to issue from this store.
  isControlled  Boolean @default(false)
  /// Emergency stock cannot be drawn for an elective case without authorisation.
  isEmergency   Boolean @default(false)
  /// Vendor consignment: stock here belongs to a vendor until it is consumed.
  isConsignment Boolean @default(false)
  /// Cold chain stores record the range they must stay within.
  minTempC      Float?
  maxTempC      Float?

  isActive  Boolean @default(true)
  sortOrder Int     @default(0)

  batches StockBatch[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, sortOrder])
  @@map("stock_locations")
}

/// One physical lot of one catalogue item.
model StockBatch {
  id String @id @default(uuid())

  /// TEXT id — matches InventoryItem.id.
  itemId String
  item   InventoryItem @relation(fields: [itemId], references: [id])

  /// TEXT id — matches StockLocation.id.
  locationId String?
  location   StockLocation? @relation(fields: [locationId], references: [id])

  batchNumber     String
  lotNumber       String?
  expiryDate      DateTime? @db.Date
  manufactureDate DateTime? @db.Date

  manufacturer String?
  brand        String?

  /// Ownership. VENDOR stock is consignment: it becomes the hospital's only on
  /// consumption, which is what makes it billable and settleable.
  owner    StockOwner @default(HOSPITAL)
  /// @db.Uuid — matches the imprest Vendor.id, NOT the TEXT ids above.
  vendorId String?    @db.Uuid
  vendor   Vendor?    @relation("StockBatchVendor", fields: [vendorId], references: [id])

  /// All kobo. purchasePrice is what it cost; sellingPrice is what the patient
  /// is billed; vendorPrice is what the vendor is owed once it is consumed.
  purchasePrice Int @default(0)
  sellingPrice  Int @default(0)
  hospitalPrice Int @default(0)
  vendorPrice   Int @default(0)

  /// Running counters, derived from StockMovement and reconcilable against it.
  quantityReceived Int @default(0)
  quantityReserved Int @default(0)
  quantityIssued   Int @default(0)
  quantityReturned Int @default(0)
  quantityUsed     Int @default(0)
  quantityDamaged  Int @default(0)
  quantityExpired  Int @default(0)
  quantityDisposed Int @default(0)

  minimumLevel Int?
  maximumLevel Int?
  reorderLevel Int?

  shelfLocation      String?
  storageTemperature String?

  /// Scanning. barcode is what a keyboard-wedge scanner types; qrPayload is what
  /// a camera reads. Both unique, so a scan can never resolve to two batches.
  barcode   String? @unique
  qrPayload String? @unique

  status StockBatchStatus @default(AVAILABLE)

  notes String?

  movements    StockMovement[]
  reservations StockReservation[]

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?
  deletedAt   DateTime?

  @@unique([itemId, batchNumber, locationId])
  @@index([itemId, status])
  @@index([expiryDate])
  @@index([owner, vendorId])
  @@index([locationId])
  @@index([deletedAt])
  @@map("stock_batches")
}

/// Append-only movement log. Nothing here is ever updated or deleted.
model StockMovement {
  id String @id @default(uuid())

  batchId String
  batch   StockBatch @relation(fields: [batchId], references: [id])

  type     StockMovementType
  /// Always positive; the type says which way it goes.
  quantity Int

  /// The case this movement was for, when there is one.
  /// TEXT id — matches Surgery.id.
  surgeryId String?
  surgery   Surgery? @relation("StockMovementSurgery", fields: [surgeryId], references: [id])

  reservationId String?
  reservation   StockReservation? @relation(fields: [reservationId], references: [id])

  fromLocationId String?
  toLocationId   String?

  /// Ownership before and after — the pair that evidences a consignment
  /// transfer at the moment of consumption.
  ownerBefore StockOwner?
  ownerAfter  StockOwner?

  /// TEXT id — matches User.id.
  actorId   String?
  actor     User?   @relation("StockMovementActor", fields: [actorId], references: [id], onDelete: SetNull)
  actorName String?

  /// Controlled drugs need a second pair of eyes. The witness name is
  /// denormalised so the register still reads correctly after a transfer.
  witnessId   String?
  witnessName String?

  reason String?
  notes  String?

  /// What the scanner actually read, kept verbatim for dispute resolution.
  scannedCode String?

  occurredAt  DateTime @default(now())
  createdAt   DateTime @default(now())
  /// Sync metadata, maintained by the capture trigger in the sync migration.
  /// Declared here ONLY so `prisma migrate diff` does not read these columns as
  /// drift and generate a DROP for them. Application code must never write
  /// them: the trigger owns them, and an app-supplied value would break the
  /// version chain conflict detection depends on.
  syncVersion Int      @default(0) @map("sync_version")
  syncOrigin  String?  @map("sync_origin")
  syncHlc     String?  @map("sync_hlc")

  @@index([batchId, occurredAt])
  @@index([surgeryId])
  @@index([type, occurredAt])
  @@index([reservationId])
  @@map("stock_movements")
}

/// Stock held for a specific case. Reserved stock is still physically present
/// in the store but is no longer available to anyone else.
model StockReservation {
  id String @id @default(uuid())

  /// TEXT id — matches Surgery.id.
  surgeryId String
  surgery   Surgery @relation("StockReservationSurgery", fields: [surgeryId], references: [id])

  batchId String
  batch   StockBatch @relation(fields: [batchId], references: [id])

  quantityReserved Int
  quantityIssued   Int @default(0)
  quantityReturned Int @default(0)
  quantityUsed     Int @default(0)
  /// Issued, then discarded rather than used — a dropped vial, a contaminated
  /// pack. Kept apart from quantityUsed because the patient is billed for what
  /// was USED; waste is the hospital's loss, and merging the two would quietly
  /// charge patients for breakages.
  quantityWasted   Int @default(0)

  status StockReservationStatus @default(RESERVED)

  /// Where this line came from — a pack template, a prescription, or added by
  /// hand. Kept so the theatre list can explain why an item is on the trolley.
  sourceKind String?
  sourceId   String?

  /// Price captured at reservation, in kobo. The patient is billed what was
  /// agreed when the case was booked, not what the price later became.
  unitPriceAtReservation Int @default(0)

  /// TEXT id — matches User.id.
  requestedById String?
  requestedBy   User?   @relation("StockReservationRequester", fields: [requestedById], references: [id], onDelete: SetNull)

  movements StockMovement[]

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  releasedAt DateTime?

  @@index([surgeryId, status])
  @@index([batchId])
  @@map("stock_reservations")
}

// ============================================================================
// THEATRE BILLING — tariffs, one invoice per surgery, revenue distribution
// ----------------------------------------------------------------------------
// ORM had no billing layer at all before this: no invoice, no price list, no
// concept of a payment. So this is new ground rather than an extension, and it
// is built to the two decisions that shape everything else.
//
// ONE INVOICE PER SURGERY. Invoice.surgeryId is UNIQUE. A patient having two
// procedures gets two invoices, and a single procedure can never accumulate
// two competing bills. Everything chargeable — theatre, anaesthesia,
// consumables, drugs, CSSD, implants, recovery — is a line on that one
// invoice, which is what "everything paid once" actually means in practice.
//
// PRICES ARE VERSIONED BY EFFECTIVE DATE. A Tariff row is never edited to
// change a price and never deleted. Superseding it closes the old row
// (effectiveTo) and opens a new one. A bill raised last quarter must still
// reprice to what it charged, or it stops reconciling the moment somebody
// updates a price list.
//
// MONEY IS INTEGER KOBO throughout, matching imprest and the stock module.
// Percentages are BASIS POINTS (1% = 100bp) for the same reason: a revenue
// split stored as a float cannot be made to sum back to the invoice total.
//
// ID TYPES: Surgery, Patient and User are TEXT; the imprest Vendor is @db.Uuid.
// Every relation below is annotated with the type it must match.
// ============================================================================

/// What is being priced. Drives both the tariff catalogue and how a line is
/// routed when revenue is distributed.
enum ChargeKind {
  PROCEDURE
  THEATRE
  ANAESTHESIA
  CONSUMABLE
  DRUG
  IMPLANT
  CSSD
  RECOVERY
  LABORATORY
  BLOOD
  OXYGEN
  EMERGENCY
  // Added for the surgery estimate: an inpatient episode is priced per day,
  // and post-operative services are neither theatre nor drugs. PROCEDURE
  // remains the surgeon's professional fee and ANAESTHESIA the anaesthetist's,
  // which is why those two are not duplicated here.
  ADMISSION
  NURSING
  POSTOP_SERVICE
  OTHER
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  CANCELLED
  REFUNDED
}

enum PaymentMethodKind {
  CASH
  TRANSFER
  POS
  CHEQUE
  WAIVER
  NHIS
  HMO
}

/// Where money is owed to once an invoice is paid.
enum RevenueAccountKind {
  HOSPITAL
  VENDOR
  CSSD
  PHARMACY
  LABORATORY
  BLOOD_BANK
  DEPARTMENT
  THEATRE
}

enum DistributionStatus {
  PENDING
  SETTLED
  CANCELLED
}

/// A price, valid over a period. Never edited in place — see the header.
model Tariff {
  id String @id @default(uuid())

  /// Stable key for this charge, e.g. "THEATRE-MAJOR" or an item id.
  code String
  name String
  kind ChargeKind

  /// TEXT id — matches InventoryItem.id. Set when the tariff prices a stock item.
  itemId String?
  item   InventoryItem? @relation("TariffItem", fields: [itemId], references: [id])

  /// Set when the tariff prices a procedure drawn from the surgical pack library.
  surgicalPackId String?

  /// Kobo.
  amount Int

  /// The window this price applies to. effectiveTo null means "still current".
  /// Superseding writes effectiveTo on the old row rather than changing amount.
  effectiveFrom DateTime  @db.Date
  effectiveTo   DateTime? @db.Date

  /// Why the price changed. An unexplained price rise is what an auditor asks about.
  reason String?

  notes String?

  /// TEXT id — matches User.id.
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  invoiceLines InvoiceLine[]

  @@index([code, effectiveFrom])
  @@index([kind, effectiveFrom])
  @@index([itemId])
  @@map("tariffs")
}

/// One bill for one surgery.
model Invoice {
  id            String @id @default(uuid())
  invoiceNumber String @unique

  /// UNIQUE — one invoice per surgery, by decision. TEXT id.
  surgeryId String  @unique
  surgery   Surgery @relation("InvoiceSurgery", fields: [surgeryId], references: [id])

  /// TEXT id — matches Patient.id. Denormalised name so a printed bill still
  /// reads correctly after a record is corrected.
  patientId   String?
  patientName String?

  status InvoiceStatus @default(DRAFT)

  /// All kobo. subtotal less discount plus tax equals total.
  subtotal   Int @default(0)
  discount   Int @default(0)
  tax        Int @default(0)
  total      Int @default(0)
  amountPaid Int @default(0)

  discountReason String?

  issuedAt DateTime?
  dueAt    DateTime?
  paidAt   DateTime?

  cancelledAt  DateTime?
  cancelReason String?

  notes String?

  lines         InvoiceLine[]
  payments      Payment[]
  distributions RevenueDistribution[]

  /// TEXT ids — match User.id.
  createdById String?
  issuedById  String?
  version     Int       @default(1)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  @@index([status])
  @@index([patientId])
  @@index([issuedAt])
  @@map("invoices")
}

model InvoiceLine {
  id        String  @id @default(uuid())
  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  kind        ChargeKind
  description String

  quantity  Int @default(1)
  /// Kobo, as charged. Captured onto the line so a later price change cannot
  /// alter a bill that has already been raised.
  unitPrice Int
  lineTotal Int

  /// Where the line came from, so every charge can be traced to the thing that
  /// caused it — a consumed reservation, a tariff, or a hand-added charge.
  sourceKind String?
  sourceId   String?

  tariffId String?
  tariff   Tariff? @relation(fields: [tariffId], references: [id])

  /// Set when the line bills consignment stock, so settlement knows who is owed.
  /// @db.Uuid — matches Vendor.id.
  vendorId String? @db.Uuid
  vendor   Vendor? @relation("InvoiceLineVendor", fields: [vendorId], references: [id])

  createdAt DateTime @default(now())

  @@index([invoiceId])
  @@index([kind])
  @@index([vendorId])
  @@map("invoice_lines")
}

model Payment {
  id        String  @id @default(uuid())
  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id])

  /// Kobo.
  amount Int
  method PaymentMethodKind @default(CASH)

  /// Bank teller number, POS reference, cheque number — whatever proves it.
  reference       String?
  /// Scan of the teller slip, as a data URL, matching how the app handles other
  /// evidence so it queues offline like everything else.
  evidenceDataUrl String?

  receivedAt     DateTime @default(now())
  /// TEXT id — matches User.id.
  receivedById   String?
  receivedByName String?

  notes String?

  /// Reversal, rather than deletion. A payment that is removed leaves a hole
  /// nobody can explain; a reversed one explains itself.
  reversedAt     DateTime?
  reversalReason String?

  createdAt DateTime @default(now())

  @@index([invoiceId])
  @@index([receivedAt])
  @@map("invoice_payments")
}

/// A destination money is owed to. Editable — no account is hardcoded.
model RevenueAccount {
  id   String             @id @default(uuid())
  code String             @unique
  name String
  kind RevenueAccountKind

  /// Set when this account belongs to a vendor. @db.Uuid — matches Vendor.id.
  vendorId String? @db.Uuid
  vendor   Vendor? @relation("RevenueAccountVendor", fields: [vendorId], references: [id])

  bankName      String?
  accountNumber String?

  isActive Boolean @default(true)

  rules         RevenueRule[]
  distributions RevenueDistribution[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([kind, isActive])
  @@map("revenue_accounts")
}

/// What share of a charge goes where. Effective-dated like tariffs, so a bill
/// raised under last year's rules still explains its own split.
model RevenueRule {
  id String @id @default(uuid())

  kind ChargeKind

  accountId String
  account   RevenueAccount @relation(fields: [accountId], references: [id])

  /// Basis points: 1% = 100, 100% = 10000. Integer so the shares of an integer
  /// total can be made to sum back to it exactly.
  shareBasisPoints Int

  effectiveFrom DateTime  @db.Date
  effectiveTo   DateTime? @db.Date

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([kind, effectiveFrom])
  @@index([accountId])
  @@map("revenue_rules")
}

/// The computed split for one invoice. Written when the invoice is paid, so it
/// records what was actually distributed rather than what the rules would say
/// today.
model RevenueDistribution {
  id        String  @id @default(uuid())
  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  accountId String
  account   RevenueAccount @relation(fields: [accountId], references: [id])

  kind ChargeKind

  /// Kobo. The shares across an invoice sum EXACTLY to its total — see
  /// lib/billing/revenue, which allocates the rounding remainder rather than
  /// letting it evaporate.
  amount Int

  /// The basis points applied, kept so the figure can be re-derived.
  shareBasisPoints Int

  status DistributionStatus @default(PENDING)

  settledAt     DateTime?
  settlementRef String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([invoiceId])
  @@index([accountId, status])
  @@map("revenue_distributions")
}

// ============================================================================
// STAFF LOCATION — where somebody was, and when
// ----------------------------------------------------------------------------
// The availability board already carried a status, a free-text place ("Theatre
// 3") and a timestamp. What it could not answer is the question an emergency
// actually asks: who is NEAREST, and is that information still worth anything?
//
// Two things are added.
//
// A COORDINATE on the current snapshot, so the board can sort by distance from
// a theatre rather than by a typed room name that may be hours stale.
//
// A PING HISTORY, because a single snapshot forgets. "At each time the staff
// updates his location" is a trail, not a value — and a trail is what lets a
// manager see that someone marked themselves available from the car park.
//
// PRIVACY. A position is recorded ONLY when a staff member actively sets their
// own status. There is no background tracking, no polling for position, and
// nothing is captured while the app merely sits open. The act of publishing
// your availability IS the consent, and the UI says so plainly at the point of
// capture. Anything else would be surveillance rather than a workforce board.
// ============================================================================

/// How a position was obtained. A typed room name and a satellite fix deserve
/// different confidence, and merging them would flatter the weaker one.
enum StaffLocationSource {
  GPS
  NETWORK
  MANUAL
}

/// One publication of "here is where I am, and what I am doing".
/// Append-only: a position is never edited, only superseded by a newer ping.
model StaffLocationPing {
  id String @id @default(uuid())

  /// TEXT id — matches User.id.
  userId String
  user   User   @relation("StaffLocationPings", fields: [userId], references: [id], onDelete: Cascade)

  /// The availability status published with this position.
  status String

  /// The free-text place the person typed, e.g. "Theatre 3". Kept alongside the
  /// coordinate because a room name is often more useful to a human than a pair
  /// of decimals, and it survives when no fix was available.
  locationLabel String?
  note          String?

  latitude  Float?
  longitude Float?
  /// Metres. A fix good to 2,000m says almost nothing and should be shown as such.
  accuracyM Float?
  source    StaffLocationSource @default(MANUAL)

  /// When the position was taken by the device, which is not necessarily when
  /// it reached the server — a ping queued offline can arrive much later.
  capturedAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@index([userId, capturedAt])
  @@index([capturedAt])
  @@map("staff_location_pings")
}

// ============================================================================
// THEATRE OPERATIONS INTELLIGENCE — delays, escalations, unexplained cases
// ----------------------------------------------------------------------------
// Three tables, and the distinction between them is the whole design.
//
// A DELAY RECORD is somebody explaining what is holding a case up. It is the
// good outcome: the theatre saw a problem and said so. It carries a category,
// a narrative and optional evidence, and it SUPPRESSES the unexplained flag.
//
// An ESCALATION is the consequence — the department that can fix it being told,
// and being expected to acknowledge and close. It exists so "we told CSSD at
// 09:20" is a fact rather than a recollection.
//
// An UNEXPLAINED CASE is the absence of the first one at forty-five minutes.
// Note what it does NOT have: a subject. There is no staffId, no "responsible
// officer", no attribution of any kind. It records that a CASE ran late with
// nothing said, and routes to Quality Assurance. Who — if anyone — was at
// fault is a judgement for people with the facts, and this schema deliberately
// gives the software no column in which to record an accusation.
//
// GEOFENCE. Section 12 asks for GPS validation "without continuously tracking
// movement". So the coordinate is checked against the hospital boundary and
// then DISCARDED: only inside/outside and the theatre are kept. The audit
// question is "was this person actually here?", and that is answerable without
// building a map of where everybody stood all day.
// ============================================================================

enum DelayStageRecorded {
  WARNING
  UNEXPLAINED
}

enum EscalationStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
  CANCELLED
}

enum UnexplainedReviewStatus {
  PENDING_REVIEW
  REVIEWED_NO_ACTION
  REVIEWED_SYSTEM_ISSUE
  REVIEWED_REFERRED
}

/// Somebody explaining what is holding a case up. The good outcome.
model TheatreDelayRecord {
  id String @id @default(uuid())

  /// TEXT id — matches Surgery.id.
  surgeryId String
  surgery   Surgery @relation("SurgeryDelayRecords", fields: [surgeryId], references: [id], onDelete: Cascade)

  /// A code from lib/theatreOps/delays. Stored as text rather than an enum so
  /// the taxonomy can grow without a migration — it is a classification, not a
  /// state machine, and an unknown code degrades to "Other" rather than failing.
  categoryCode  String
  categoryGroup String?

  narrative String

  /// How late the case was when this was recorded.
  minutesLateAtRecord Int?

  /// TEXT id — matches User.id. WHO REPORTED the problem, which is not the
  /// same as who caused it and must never be read as such.
  reportedById   String?
  reportedBy     User?   @relation("DelayReporter", fields: [reportedById], references: [id], onDelete: SetNull)
  reportedByName String?

  /// Evidence, as data URLs, matching how the app handles other media so it
  /// queues offline like everything else.
  photoDataUrls String[]

  /// Presence, not position — see the header. The coordinate is validated and
  /// discarded; only the verdict is kept.
  withinGeofence Boolean?
  theatreName    String?
  deviceLabel    String?

  escalations TheatreEscalation[]

  recordedAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([surgeryId, recordedAt])
  @@index([categoryCode])
  @@index([recordedAt])
  @@map("theatre_delay_records")
}

/// The department being told, and being expected to close it.
model TheatreEscalation {
  id String @id @default(uuid())

  delayRecordId String
  delayRecord   TheatreDelayRecord @relation(fields: [delayRecordId], references: [id], onDelete: Cascade)

  /// TEXT id — matches Surgery.id. Denormalised so the queue can be read
  /// per theatre without joining through the delay record.
  surgeryId String

  /// The role notified. A role rather than a person: the CSSD supervisor on
  /// duty is whoever is on duty, and addressing an individual would leave the
  /// escalation unread on their day off.
  notifiedRole String

  status EscalationStatus @default(OPEN)

  /// TEXT ids — match User.id.
  acknowledgedById   String?
  acknowledgedByName String?
  acknowledgedAt     DateTime?

  resolvedById   String?
  resolvedByName String?
  resolvedAt     DateTime?
  resolutionNote String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([notifiedRole, status])
  @@index([surgeryId])
  @@index([status, createdAt])
  @@map("theatre_escalations")
}

/// A case that ran late with nothing said. Deliberately subject-less.
model TheatreUnexplainedDelay {
  id String @id @default(uuid())

  /// UNIQUE — one record per surgery. A case is either unexplained or it is
  /// not; raising a second would double-count it in every report.
  surgeryId String  @unique
  surgery   Surgery @relation("SurgeryUnexplainedDelay", fields: [surgeryId], references: [id], onDelete: Cascade)

  stage DelayStageRecorded @default(UNEXPLAINED)

  /// How late the case was when the threshold passed.
  minutesLate Int

  /// Emergencies are measured from booking rather than a scheduled time.
  isEmergency Boolean @default(false)

  /// NOTE the absence of any "responsible person" column. This records that a
  /// CASE was unexplained. Attribution is a human judgement made with the facts
  /// in front of you, and the software is given no place to record an
  /// accusation it is not entitled to make.
  reviewStatus UnexplainedReviewStatus @default(PENDING_REVIEW)

  /// TEXT id — matches User.id. The reviewer, not a subject.
  reviewedById   String?
  reviewedByName String?
  reviewedAt     DateTime?
  reviewNotes    String?

  /// Set when the committee judges the delay was avoidable. A conclusion
  /// reached by people, never by a timer.
  judgedAvoidable Boolean?

  detectedAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([reviewStatus, detectedAt])
  @@index([detectedAt])
  @@map("theatre_unexplained_delays")
}

/// The 60-minute preoperative alert, recorded once per case.
///
/// This table exists for exactly one reason: the alert job runs every five
/// minutes, and without a unique anchor a case due in an hour would be
/// announced twelve times before it started. `surgeryId` is UNIQUE, so the
/// second attempt is a no-op however often the schedule fires.
///
/// It doubles as evidence. "Nobody told us" is the commonest account of a late
/// start, and this row records who was told, when, and how far ahead.
model TheatrePreopAlert {
  id String @id @default(uuid())

  /// UNIQUE — one alert per case. See above; this is the whole point.
  surgeryId String  @unique
  surgery   Surgery @relation("SurgeryPreopAlert", fields: [surgeryId], references: [id], onDelete: Cascade)

  /// The scheduled start the alert was sent against, as understood at the
  /// time. If the case is later moved, this still says what was announced.
  scheduledStart DateTime

  /// How far ahead the alert actually went out. Normally 56-60; smaller for a
  /// case added to the list at short notice.
  minutesBefore Int

  /// Who was notified. Stored as a JSON array of user ids so a dispute about
  /// whether someone was told has an answer.
  recipientIds   String? @db.Text
  recipientCount Int     @default(0)

  /// Whether each channel actually went out. A push failure must not stop the
  /// row being written, or the next run would alert all over again.
  announced    Boolean @default(false)
  wardNotified Boolean @default(false)
  pushSent     Boolean @default(false)

  sentAt    DateTime @default(now())
  createdAt DateTime @default(now())

  @@index([sentAt])
  @@map("theatre_preop_alerts")
}

/// What a team member said when asked whether they are coming.
///
/// Delayed and Unavailable are first-class answers, not failures to respond.
/// A system that only records "present" teaches people to tick present and
/// sort it out later, which is exactly the information a coordinator needed an
/// hour earlier.
enum TeamCheckInStatus {
  PRESENT
  EN_ROUTE
  DELAYED
  UNAVAILABLE
  REPLACED
}

/// How a device fix compared against the hospital site.
///
/// Note that NO_FIX and IMPRECISE are not judgements about the person. A scrub
/// nurse in a windowless theatre and someone at home produce the same silence
/// from a GPS chip.
enum CheckInFixVerdict {
  ON_SITE
  OFF_SITE
  IMPRECISE
  NO_FIX
}

/// A team member's check-in for a scheduled case.
///
/// NOTE WHAT IS NOT HERE: latitude and longitude. The check-in sends a
/// position, the server compares it against the site, and the coordinates are
/// discarded. What remains is a verdict and a distance rounded to 10 m — a
/// circle, not a point. The operational question is "are you here?", and that
/// is all this table is allowed to answer.
model SurgeryTeamCheckIn {
  id String @id @default(uuid())

  surgeryId String
  surgery   Surgery @relation("SurgeryTeamCheckIns", fields: [surgeryId], references: [id], onDelete: Cascade)

  /// TEXT id — matches User.id.
  userId   String
  userName String?

  /// What they are on this case, as the case records it ("Surgeon",
  /// "Anaesthetist"). Free text rather than an enum because the roles on a
  /// theatre list are not a fixed set and never have been.
  roleOnCase String

  status TeamCheckInStatus

  /// Required for DELAYED / UNAVAILABLE / REPLACED. "Delayed" with no reason
  /// is the same as silence to anyone trying to plan around it.
  reason String?

  /// Who is coming instead, when someone is replaced.
  replacementName String?

  /// The site check. Coordinates deliberately absent — see above.
  fixVerdict CheckInFixVerdict @default(NO_FIX)
  distanceM  Int?

  /// A label the device supplies for itself, so a check-in can be traced to a
  /// handset without that handset being a tracker.
  deviceLabel String?

  /// The theatre the case is in at the time of the check-in.
  theatre String?

  /// Expected minutes to arrival, for EN_ROUTE.
  etaMinutes Int?

  checkedInAt DateTime @default(now())
  updatedAt   DateTime @updatedAt
  /// Sync metadata, maintained by the capture trigger in the sync migration.
  /// Declared here ONLY so `prisma migrate diff` does not read these columns as
  /// drift and generate a DROP for them. Application code must never write
  /// them: the trigger owns them, and an app-supplied value would break the
  /// version chain conflict detection depends on.
  syncVersion Int      @default(0) @map("sync_version")
  syncOrigin  String?  @map("sync_origin")
  syncHlc     String?  @map("sync_hlc")

  /// One current answer per person per case. Changing your mind updates it.
  @@unique([surgeryId, userId])
  @@index([surgeryId, status])
  @@index([checkedInAt])
  @@map("surgery_team_check_ins")
}

/// Where a procedure name came from.
enum ProcedureSource {
  /// Seeded from the curated catalogue.
  CATALOGUE
  /// Added by a user at booking time through the "Other" option.
  USER_ADDED
}

/// The procedure names a surgeon picks from when booking.
///
/// Seeded with a curated catalogue per subspecialty, and OPEN: anything
/// missing can be added at booking and is then permanently available to
/// everybody. That openness is the whole point and also the risk, so:
///
///   * `slug` is a normalised comparison key (see lib/procedures/normalise),
///     and (subspecialty, slug) is UNIQUE. "Appendicectomy" typed by two
///     surgeons on two days is one row, not two.
///   * `subspecialty` MUST match surgical_units.subspecialty exactly. It is
///     the join key for the dropdown; a near-miss yields an empty picker with
///     no error, which is the worst way for this to fail.
model SurgicalProcedure {
  id String @id @default(uuid())

  /// As it is shown, in the words whoever added it used.
  name String

  /// Must match surgical_units.subspecialty exactly.
  subspecialty String

  /// Normalised key for duplicate detection. Never displayed.
  slug String

  /// Grouping inside the subspecialty, shown as an optgroup in the picker.
  category String?

  source ProcedureSource @default(CATALOGUE)

  /// Commonly done as an emergency. Affects ordering only — it never stops
  /// anybody choosing anything, because the list a theatre actually runs does
  /// not respect the distinction.
  isEmergency Boolean @default(false)

  /// Retired rather than deleted. A procedure that has been booked is part of
  /// the record of those cases, and deleting it would orphan them.
  isActive Boolean @default(true)

  /// How often it has been booked. Drives the order of the dropdown so the
  /// twenty operations a theatre actually does are not buried under four
  /// hundred it does once a year.
  usageCount Int       @default(0)
  lastUsedAt DateTime?

  /// Who added it, for a user-added entry. Null for the seeded catalogue.
  createdById   String?
  createdByName String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([subspecialty, slug])
  @@index([subspecialty, isActive])
  @@index([usageCount])
  @@map("surgical_procedures")
}

// ============================================================================
// SURGERY ESTIMATE & COSTING
// ----------------------------------------------------------------------------
// What a planned operation is expected to cost the patient, itemised.
//
// It deliberately introduces NO new price masters. Prices already live in
// `Tariff`, which is effective-dated (effectiveFrom/effectiveTo), stores kobo,
// and supersedes by writing a new row rather than mutating an old one. Adding
// SurgicalProcedurePrice / InvestigationPrice / MaterialPrice tables would
// duplicate it and create two answers to "what did this cost in August".
//
// Bundles likewise reuse `SurgicalPack` — 55 already seeded across 11
// subspecialties, consumable and ANAESTHESIA:: alike.
//
// THE ONE RULE THIS SCHEMA EXISTS TO ENFORCE: an estimate never changes
// because a price changed afterwards. Every line carries a SNAPSHOT of the
// price it was built from, so the document handed to a patient in August still
// reads the same in September. The tariff id is kept for provenance, not for
// display — nothing renders by joining back to a live price.
// ============================================================================

enum EstimateStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  ISSUED
  REVISED
  EXPIRED
  CANCELLED
  SUPERSEDED
}

enum EstimateSection {
  PREOP_INVESTIGATION
  SURGICAL_MATERIAL
  ANAESTHESIA_MATERIAL
  SURGICAL_FEE
  ANAESTHESIA_FEE
  THEATRE
  ADMISSION
  POSTOP_MEDICATION
  POSTOP_MONITORING
  OTHER_POSTOP
}

enum EstimateAdmissionType {
  DAY_CASE
  INPATIENT
}

model SurgeryEstimate {
  id             String @id @default(uuid())
  /// Shown to the patient. Never expose the uuid on a printed document.
  estimateNumber String @unique

  /// TEXT id — matches Surgery.id. Null while an estimate is drafted ahead of
  /// a booking; set when it is attached to one.
  surgeryId String?
  /// TEXT id — matches Patient.id.
  patientId String

  status         EstimateStatus @default(DRAFT)
  /// 1 for the first, incrementing per revision. See supersedesId.
  revision       Int            @default(1)
  /// The estimate this one replaces. The original is kept and marked
  /// SUPERSEDED rather than edited, so what the patient was first told
  /// remains readable.
  supersedesId   String?
  revisionReason String?

  // ---- Clinical context, snapshotted -------------------------------------
  // Copied rather than joined: a patient renamed or a procedure re-coded must
  // not silently alter a document already handed over.
  patientName     String
  folderNumber    String?
  procedureName   String
  diagnosis       String?
  subspecialty    String?
  unit            String?
  surgeonName     String?
  anaesthesiaType String?
  surgeryType     String? // ELECTIVE | EMERGENCY, as at estimate time
  plannedDate     DateTime?

  admissionType    EstimateAdmissionType @default(INPATIENT)
  /// Drives the admission calculation: daily charge x this.
  expectedStayDays Int                   @default(0)

  // ---- Money, in kobo, computed on the SERVER ----------------------------
  // Integers throughout, as everywhere else in this schema. A float here is a
  // rounding error that reaches a patient.
  subtotalKobo Int @default(0)
  /// Not assumed to equal the total; deposit policy is configurable.
  depositKobo  Int @default(0)
  totalKobo    Int @default(0)

  /// How long the quoted prices stand. Past this the estimate reads EXPIRED.
  validUntil DateTime?

  // ---- Who did what ------------------------------------------------------
  /// TEXT ids — match User.id. Names are snapshotted for the printed document.
  preparedById   String?
  preparedByName String?
  approvedById   String?
  approvedByName String?
  approvedAt     DateTime?
  issuedAt       DateTime?
  cancelledAt    DateTime?
  cancelReason   String?

  /// Recorded when the document is sent, so sharing is auditable.
  sharedToPhone String?
  sharedAt      DateTime?

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lines SurgeryEstimateLine[]

  @@index([patientId, createdAt])
  @@index([surgeryId])
  @@index([status, createdAt])
  @@map("surgery_estimates")
}

model SurgeryEstimateLine {
  id         String          @id @default(uuid())
  estimateId String
  estimate   SurgeryEstimate @relation(fields: [estimateId], references: [id], onDelete: Cascade)

  section EstimateSection
  /// Which master this came from, for reporting. Matches the Tariff vocabulary.
  kind    ChargeKind

  // ---- The snapshot ------------------------------------------------------
  // These are what the document renders. The ids below are provenance only.
  description   String
  unit          String @default("each")
  quantity      Int    @default(1)
  unitPriceKobo Int
  totalKobo     Int

  /// TEXT ids — the masters this line was built from. Kept so an auditor can
  /// trace a figure, NOT so the line can be re-priced later.
  tariffId           String?
  inventoryItemId    String?
  surgicalPackId     String?
  investigationId    String?
  medicationName     String?
  /// The tariff window in force when this line was priced.
  priceEffectiveFrom DateTime?

  // ---- Computed quantities ------------------------------------------------
  // For post-op medications and monitoring, quantity is usually derived
  // (frequency x days). Both the inputs and the result are stored: the result
  // because it is what was charged, the inputs because somebody will ask how
  // "15" was arrived at.
  frequencyPerDay Int?
  durationDays    Int?

  // ---- Overrides ----------------------------------------------------------
  // An override is a person overruling the price master, so it records who and
  // why. The original is never lost.
  priceOverridden       Boolean   @default(false)
  originalUnitPriceKobo Int?
  overrideReason        String?
  /// TEXT id — matches User.id.
  overriddenById        String?
  overriddenByName      String?
  overriddenAt          DateTime?

  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([estimateId, section, sortOrder])
  @@index([kind])
  @@map("surgery_estimate_lines")
}

// ============================================================================
// SYNC LAYER — declared for Prisma's benefit only
// ----------------------------------------------------------------------------
// These tables are created and maintained by
// prisma/migrations/20260810090000_hybrid_sync_journal, in SQL, because they
// need triggers and a plpgsql clock that Prisma cannot express.
//
// They are declared here for ONE reason: `prisma migrate diff` compares the
// database against this schema, and anything it cannot see it generates a DROP
// for. Before this block, a routine `migrate diff` produced DROP TABLE for all
// seven of these plus DROP COLUMN for the sync metadata on every captured
// table — which would have destroyed replication and any unshipped work still
// sitting in the journal.
//
// Application code should not read or write these through Prisma. The worker
// and the sync routes use raw SQL deliberately, because the semantics
// (savepoints, capture suppression, FOR UPDATE on the clock) are not things an
// ORM expresses well.
// ============================================================================

/// Which node this database is, and whether capture is switched on.
model SyncNode {
  id             Boolean  @id @default(true)
  nodeId         String   @map("node_id")
  captureEnabled Boolean  @default(false) @map("capture_enabled")
  createdAt      DateTime @default(now()) @map("created_at")

  @@map("sync_node")
}

/// Hybrid logical clock state. One row.
model SyncClock {
  id       Boolean @id @default(true)
  physical BigInt  @default(0)
  counter  Int     @default(0)

  @@map("sync_clock")
}

/// Columns held back from journal payloads, with a digest instead.
model SyncOmittedColumn {
  tableName  String @map("table_name")
  columnName String @map("column_name")

  @@id([tableName, columnName])
  @@map("sync_omitted_columns")
}

/// Append-only record of every change to a captured table.
model SyncJournal {
  id            String    @id @default(uuid())
  tableName     String    @map("table_name")
  rowId         String    @map("row_id")
  op            String
  baseVersion   Int       @default(0) @map("base_version")
  newVersion    Int       @default(0) @map("new_version")
  hlc           String
  originNode    String    @map("origin_node")
  payload       Json?
  changedCols   String[]  @map("changed_cols")
  omittedCols   String[]  @map("omitted_cols")
  omittedDigest String?   @map("omitted_digest")
  createdAt     DateTime  @default(now()) @map("created_at")
  shippedAt     DateTime? @map("shipped_at")
  ackAt         DateTime? @map("ack_at")
  attempts      Int       @default(0)
  lastError     String?   @map("last_error")

  @@index([tableName, rowId, hlc])
  @@index([originNode, createdAt])
  @@map("sync_journal")
}

/// Entries received from the peer. Makes at-least-once delivery idempotent.
model SyncApplied {
  journalId String   @id @map("journal_id")
  fromNode  String   @map("from_node")
  tableName String   @map("table_name")
  rowId     String   @map("row_id")
  decision  String
  reason    String?
  appliedAt DateTime @default(now()) @map("applied_at")

  @@index([appliedAt])
  @@map("sync_applied")
}

/// The losing side of every conflict, kept in full. Nothing is discarded.
model SyncRowConflict {
  id             String    @id @default(uuid())
  tableName      String    @map("table_name")
  rowId          String    @map("row_id")
  syncClass      String    @map("sync_class")
  incoming       Json
  incomingHlc    String    @map("incoming_hlc")
  incomingNode   String    @map("incoming_node")
  localSnapshot  Json?     @map("local_snapshot")
  localHlc       String?   @map("local_hlc")
  reason         String
  status         String    @default("OPEN")
  resolvedBy     String?   @map("resolved_by")
  resolvedAt     DateTime? @map("resolved_at")
  resolutionNote String?   @map("resolution_note")
  createdAt      DateTime  @default(now()) @map("created_at")

  @@index([tableName, rowId])
  @@map("sync_conflicts")
}

/// Per-peer progress, health and retry backoff state.
model SyncState {
  peerNode          String    @id @map("peer_node")
  lastPushAt        DateTime? @map("last_push_at")
  lastPushOkAt      DateTime? @map("last_push_ok_at")
  lastPullAt        DateTime? @map("last_pull_at")
  lastPullOkAt      DateTime? @map("last_pull_ok_at")
  pullCursor        String    @default("") @map("pull_cursor")
  consecutiveErrors Int       @default(0) @map("consecutive_errors")
  nextAttemptAt     DateTime  @default(now()) @map("next_attempt_at")
  lastError         String?   @map("last_error")
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at")

  @@map("sync_state")
}

/// Entries that could not be applied yet — almost always because a parent row
/// has not arrived. Declared here only so `prisma migrate diff` sees it and
/// does not generate a DROP for it, which it did to the whole sync layer once.
model SyncDeferred {
  id          String    @id @default(uuid()) @db.Uuid
  journalId   String    @unique @map("journal_id") @db.Uuid
  fromNode    String    @map("from_node")
  tableName   String    @map("table_name")
  rowId       String    @map("row_id")
  entry       Json      @db.JsonB
  attempts    Int       @default(0)
  lastError   String?   @map("last_error")
  firstSeenAt DateTime  @default(now()) @map("first_seen_at") @db.Timestamptz(6)
  lastTryAt   DateTime? @map("last_try_at") @db.Timestamptz(6)
  resolvedAt  DateTime? @map("resolved_at") @db.Timestamptz(6)

  @@index([firstSeenAt])
  @@index([tableName, resolvedAt])
  @@map("sync_deferred")
}

/// Which theatre-team role a person was assigned to for a case.
enum TheatreTeamRole {
  SCRUB_NURSE
  CIRCULATING_NURSE
  CONSULTANT_ANAESTHETIST
  ANAESTHETIST
  ANAESTHETIC_TECHNICIAN
}

/// A person assigned to a case, in a stated role, by a named person.
///
/// TheatreAllocation already carries one column per role, which cannot express
/// "two technicians on this case" — and in practice more than one person covers a
/// category. So the team is rows, not columns: any number per role, each with its
/// own attribution.
///
/// The attribution is the point as much as the assignment. Anaesthesia is
/// assigned by the anaesthetists and technicians by the technicians, so "who put
/// me on this list" must have an answer.
model TheatreTeamAssignment {
  id        String          @id @default(uuid())
  /// TEXT id — matches Surgery.id. Not FK-constrained, matching the convention
  /// used elsewhere for soft references to surgeries.
  surgeryId String
  role      TheatreTeamRole
  /// TEXT id — matches User.id.
  userId    String
  /// Snapshotted: a rota printed today must still read correctly if the person
  /// is later renamed or leaves.
  userName  String

  assignedById   String?
  assignedByName String?
  assignedByRole String?
  assignedAt     DateTime @default(now())

  /// Set instead of deleting, so a removal is still a recorded decision.
  removedAt     DateTime?
  removedById   String?
  removedByName String?

  createdAt DateTime @default(now())

  /// The same person twice in the same role on one case is a mistake, not an
  /// intention. Withdrawn rows are excluded by the partial index below instead.
  @@unique([surgeryId, role, userId])
  @@index([surgeryId, role])
  @@index([userId, assignedAt])
  @@map("theatre_team_assignments")
}

/// Which packs a procedure needs — confirmed once by an administrator, then used
/// at every booking without guessing.
///
/// Name matching can suggest a pack but must never choose one: which pack a
/// hemicolectomy needs is a clinical judgement, and auto-requesting the wrong pack
/// is worse than requesting none because somebody opens it before noticing. So the
/// suggestion is reviewed once and stored here, and booking reads this table.
model ProcedurePackMap {
  id String @id @default(uuid())

  /// Normalised procedure name, so "Suture 2/0"-style spelling drift does not
  /// create two mappings for one operation.
  procedureKey  String
  /// As a clinician typed it, for display.
  procedureName String
  subspecialty  String?

  /// TEXT ids — match SurgicalPack.id.
  consumablePackId   String?
  pharmacyPackId     String?
  /// Snapshotted for display, so a renamed pack does not make an old mapping
  /// unreadable.
  consumablePackName String?
  pharmacyPackName   String?

  /// How the mapping came about, and whether a person has agreed to it.
  /// A mapping is NOT used at booking until confirmedAt is set.
  suggestedBasis  String?
  confirmedAt     DateTime?
  confirmedById   String?
  confirmedByName String?

  isActive  Boolean  @default(true)
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([procedureKey])
  @@index([subspecialty, isActive])
  @@map("procedure_pack_maps")
}

// ============================================================
// Conflict Resolver — structured decisions without a meeting
// ------------------------------------------------------------
// 9 models, not the specification's 17. Recommendation folds into analysis,
// publication is a status with dates, comments belong on a review, and the
// existing AuditLog and notification systems are reused rather than duplicated.
//
// The analysis is STATISTICAL, not a language model: every figure in a published
// decision can be recomputed from the stored responses and defended.
// ============================================================

enum ConflictStatus {
  DRAFT
  OPEN_FOR_RESPONSES
  RESPONSE_CLOSED
  ANALYSING
  UNDER_REVIEW
  REVISION_REQUIRED
  PENDING_APPROVAL
  APPROVED
  PUBLISHED
  IMPLEMENTED
  CLOSED
  ARCHIVED
  CANCELLED
}

enum ConflictUrgency {
  CRITICAL
  HIGH
  NORMAL
  LOW
}

/// How much of a respondent's identity is retained.
///
/// This must be settled BEFORE any response exists: an anonymous decision stores
/// `responded` on the stakeholder row and never a link from answer to person, and
/// that cannot be retrofitted once answers are in the table.
enum ConflictAnonymity {
  IDENTIFIED
  CONFIDENTIAL
  ANONYMOUS
}

enum ConflictQuestionType {
  SINGLE_CHOICE
  MULTI_CHOICE
  YES_NO
  LIKERT
  RATING
  RANKING
  SHORT_TEXT
  LONG_TEXT
  NUMERIC
  PERCENTAGE
}

enum ConflictStakeholderRole {
  STAKEHOLDER
  CHAIR
  REVIEWER
  OBSERVER
}

model ConflictDecision {
  id     String @id @default(uuid())
  /// Shown on the published decision, e.g. "CR-2026-000124".
  number String @unique

  title            String
  problemStatement String            @db.Text
  decisionRequired String            @db.Text
  category         String
  urgency          ConflictUrgency   @default(NORMAL)
  status           ConflictStatus    @default(DRAFT)
  anonymity        ConflictAnonymity @default(IDENTIFIED)

  opensAt  DateTime?
  closesAt DateTime?

  /// Quorum as a percentage of those invited. Null means none required.
  quorumPercent Int?

  /// Version of the PUBLISHED decision. Amending publishes a new version and
  /// leaves the old one readable — a policy people acted on is never rewritten.
  version      Int     @default(1)
  supersedesId String?

  publishedAt   DateTime?
  effectiveFrom DateTime?
  reviewDueAt   DateTime?

  createdById   String?
  createdByName String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  stakeholders ConflictStakeholder[]
  questions    ConflictQuestion[]
  responses    ConflictResponse[]
  evidence     ConflictEvidence[]
  analyses     ConflictAnalysis[]
  reviews      ConflictReview[]
  approvals    ConflictApproval[]

  @@index([status, closesAt])
  @@index([category, publishedAt])
  @@map("conflict_decisions")
}

model ConflictStakeholder {
  id         String           @id @default(uuid())
  decisionId String
  decision   ConflictDecision @relation(fields: [decisionId], references: [id], onDelete: Cascade)

  /// TEXT id — matches User.id.
  userId   String
  userName String
  userRole String?
  role     ConflictStakeholderRole @default(STAKEHOLDER)

  /// Set when they answer. On an ANONYMOUS decision this is the ONLY record that
  /// they took part — there is no link from their answers back to here.
  responded   Boolean   @default(false)
  respondedAt DateTime?

  invitedAt  DateTime  @default(now())
  remindedAt DateTime?

  @@unique([decisionId, userId])
  @@index([userId, responded])
  @@map("conflict_stakeholders")
}

model ConflictQuestion {
  id         String           @id @default(uuid())
  decisionId String
  decision   ConflictDecision @relation(fields: [decisionId], references: [id], onDelete: Cascade)

  type     ConflictQuestionType
  prompt   String               @db.Text
  helpText String?
  /// Choices, scale labels or ranking items, by type.
  options  Json?
  required Boolean              @default(true)
  order    Int                  @default(0)

  /// Show this question only when another was answered a certain way.
  showIfQuestionId String?
  showIfValue      String?

  answers ConflictAnswer[]

  @@index([decisionId, order])
  @@map("conflict_questions")
}

model ConflictResponse {
  id         String           @id @default(uuid())
  decisionId String
  decision   ConflictDecision @relation(fields: [decisionId], references: [id], onDelete: Cascade)

  /// NULL on an anonymous decision. The stakeholder row records that they
  /// responded; nothing records what they said.
  userId   String?
  userName String?
  userRole String?

  submittedAt    DateTime @default(now())
  /// Client-generated, so an offline submission cannot arrive twice.
  idempotencyKey String?  @unique

  answers ConflictAnswer[]

  @@index([decisionId, submittedAt])
  @@map("conflict_responses")
}

model ConflictAnswer {
  id         String           @id @default(uuid())
  responseId String
  response   ConflictResponse @relation(fields: [responseId], references: [id], onDelete: Cascade)
  questionId String
  question   ConflictQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  /// One shape per question type; only one is populated.
  choiceValue  String?
  choiceValues Json?
  numericValue Float?
  textValue    String? @db.Text
  ranking      Json?

  @@index([questionId])
  @@index([responseId])
  @@map("conflict_answers")
}

model ConflictEvidence {
  id         String           @id @default(uuid())
  decisionId String
  decision   ConflictDecision @relation(fields: [decisionId], references: [id], onDelete: Cascade)

  title       String
  description String?
  fileName    String?
  mimeType    String?
  /// Base64, matching how every other attachment in ORM is stored today.
  fileData    String? @db.Text
  url         String?

  addedById   String?
  addedByName String?
  addedAt     DateTime @default(now())

  @@index([decisionId])
  @@map("conflict_evidence")
}

model ConflictAnalysis {
  id         String           @id @default(uuid())
  decisionId String
  decision   ConflictDecision @relation(fields: [decisionId], references: [id], onDelete: Cascade)

  /// Bumped on each recomputation; earlier analyses are kept, never overwritten.
  version Int @default(1)

  /// Computed, not generated: per-question distributions, consensus strength,
  /// disagreement clusters, minority positions.
  statistics Json

  respondedCount Int
  invitedCount   Int
  quorumMet      Boolean @default(false)

  /// Written by a PERSON from the computed findings. The module structures and
  /// pre-fills these; it does not write prose, because a model's summary in a
  /// permanent institutional record cannot be traced to source responses.
  executiveSummary String? @db.Text
  keyArguments     String? @db.Text
  risks            String? @db.Text
  recommendation   String? @db.Text
  rationale        String? @db.Text
  conditions       String? @db.Text

  generatedAt     DateTime @default(now())
  generatedById   String?
  generatedByName String?

  @@index([decisionId, version])
  @@map("conflict_analyses")
}

model ConflictReview {
  id         String           @id @default(uuid())
  decisionId String
  decision   ConflictDecision @relation(fields: [decisionId], references: [id], onDelete: Cascade)

  reviewerId   String?
  reviewerName String?
  /// COMMENT | REVISION_REQUESTED | ENDORSED | REJECTED
  outcome      String
  comment      String?  @db.Text
  createdAt    DateTime @default(now())

  @@index([decisionId, createdAt])
  @@map("conflict_reviews")
}

model ConflictApproval {
  id         String           @id @default(uuid())
  decisionId String
  decision   ConflictDecision @relation(fields: [decisionId], references: [id], onDelete: Cascade)

  /// Position in the approval chain, so a hierarchy is configurable per hospital.
  level        Int
  approverRole String?
  approverId   String?
  approverName String?
  /// PENDING | APPROVED | REJECTED
  decisionMade String    @default("PENDING")
  comment      String?   @db.Text
  decidedAt    DateTime?
  createdAt    DateTime  @default(now())

  @@unique([decisionId, level])
  @@index([decisionId])
  @@map("conflict_approvals")
}

// ============================================================
// Communications — one path out of ORM
// ------------------------------------------------------------
// Six models, not the specification's seventeen. WorkflowInstance is dropped
// deliberately: the cron checkers already recompute state each run, and storing
// instances would create a second source of truth about whether a theatre is
// ready.
//
// SENDING IS CLOUD-ONLY. The theatre server has no public inbound address, so
// webhooks can only reach Vercel — and if both nodes could send, a message queued
// locally and then synced would go out twice, once from each. The local node
// enqueues; the cloud transmits.
// ============================================================

enum CommChannel {
  IN_APP
  PUSH
  RADIO
  EMAIL
  WHATSAPP
  SMS
}

enum CommStatus {
  QUEUED
  SENDING
  SENT
  DELIVERED
  READ
  FAILED
  CANCELLED
  /// Time-sensitive and no longer worth sending — a reminder for a case that has
  /// already started helps nobody and erodes trust in the rest.
  EXPIRED
}

enum CommPriority {
  LOW
  NORMAL
  HIGH
  URGENT
  CRITICAL
}

/// How much a message may say. Classified per template so the rule cannot be
/// decided per-send by whoever is in a hurry.
enum CommSensitivity {
  /// No patient information at all — safe on any channel.
  OPERATIONAL
  /// Names a patient. Acceptable to staff, never to an external vendor.
  PATIENT_IDENTIFIED
  /// Clinical detail. Never leaves the app: the message says "log in to ORM".
  CLINICAL
}

model CommunicationTemplate {
  id      String      @id @default(uuid())
  /// Stable key the code refers to, e.g. "THEATRE_SETUP_OVERDUE".
  code    String
  channel CommChannel
  /// Bumped rather than edited in place, so a message sent last month can still
  /// be shown exactly as it was worded.
  version Int         @default(1)

  subject   String?
  body      String  @db.Text
  /// Names of the variables this body expects, for validation before sending.
  variables Json?

  sensitivity CommSensitivity @default(OPERATIONAL)

  /// WhatsApp only: Meta approves templates, and an unapproved one cannot be
  /// sent however correct it looks.
  providerTemplateId String?
  providerStatus     String?

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([code, channel, version])
  @@index([code, channel, isActive])
  @@map("communication_templates")
}

model CommunicationMessage {
  id String @id @default(uuid())

  channel  CommChannel
  priority CommPriority @default(NORMAL)
  status   CommStatus   @default(QUEUED)

  /// TEXT id — matches User.id. Null for an external recipient.
  recipientUserId  String?
  recipientName    String?
  /// Phone or email, by channel. Never both.
  recipientAddress String?

  templateCode    String?
  /// Rendered at QUEUE time, not at send time. What was queued is what goes out,
  /// even if the template changes in between.
  renderedSubject String?
  renderedBody    String  @db.Text

  /// What this is about, so a message can be traced back to the thing that
  /// caused it. Soft references, matching the convention used elsewhere.
  relatedType     String?
  relatedId       String?
  ruleId          String?
  escalationLevel Int?

  /// Prevents a duplicate when an offline queue replays or a cron re-runs.
  /// Built from event + rule + recipient + channel.
  idempotencyKey String @unique

  providerMessageId String?
  failureReason     String?
  attempts          Int       @default(0)
  queuedAt          DateTime  @default(now())
  sentAt            DateTime?
  deliveredAt       DateTime?
  /// After this, sending is pointless. See CommStatus.EXPIRED.
  expiresAt         DateTime?

  createdById   String?
  createdByName String?

  events CommunicationEvent[]

  @@index([status, priority, queuedAt])
  @@index([recipientUserId, queuedAt])
  @@index([relatedType, relatedId])
  @@map("communication_messages")
}

/// Provider receipts. Append-only and deduplicated: a webhook that arrives twice
/// must not move a message backwards from READ to DELIVERED.
model CommunicationEvent {
  id        String               @id @default(uuid())
  messageId String
  message   CommunicationMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  status          CommStatus
  /// The provider's own event id, where it has one.
  providerEventId String?
  payload         Json?
  occurredAt      DateTime   @default(now())

  @@unique([messageId, providerEventId])
  @@index([messageId, occurredAt])
  @@map("communication_events")
}

model WorkflowRule {
  id          String  @id @default(uuid())
  name        String
  description String?

  /// The ORM event or scheduled check this responds to.
  trigger    String
  /// Evaluated by a pure function, so a rule can be tested without sending.
  conditions Json?
  /// Channel, template and recipient resolution.
  actions    Json

  priority CommPriority @default(NORMAL)

  /// Off by default. A rule that sends the moment it is created is how a
  /// misconfigured loop reaches real people.
  isActive Boolean @default(false)
  /// Renders and logs without transmitting, for testing against live data.
  dryRun   Boolean @default(true)

  escalationPolicyId String?

  createdById   String?
  createdByName String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([trigger, isActive])
  @@map("workflow_rules")
}

model EscalationPolicy {
  id     String @id @default(uuid())
  name   String @unique
  /// [{ level, afterMinutes, recipients: [...], channels: [...] }]
  levels Json

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("escalation_policies")
}

model FeedbackRequest {
  id String @id @default(uuid())

  /// TEXT ids — match Patient.id / Surgery.id.
  patientId String?
  surgeryId String?

  /// SHA-256 of the token. The token itself is never stored, so a database read
  /// cannot open somebody's feedback form.
  tokenHash String   @unique
  expiresAt DateTime

  requestedById   String?
  requestedByName String?
  requestedAt     DateTime  @default(now())
  submittedAt     DateTime?
  /// The submission itself, kept separate from the request that invited it.
  responseData    Json?

  @@index([patientId])
  @@index([expiresAt, submittedAt])
  @@map("feedback_requests")
}

// ===========================================================================
// Clinical OCR & document intelligence
//
// Files are NOT here. Scans live in the document store (src/lib/documents/store.ts);
// these tables hold metadata, extracted text, confidence and a content-addressed
// reference. See docs/ocr-platform-assessment.md section 2 for why.
//
// The sync* columns are owned by the capture trigger, as everywhere else in this
// schema. Declared only so `prisma migrate diff` does not read them as drift.
// ===========================================================================

model OcrDocument {
  id             String  @id @default(uuid())
  patientId      String?
  surgeryId      String?
  documentType   String
  classifiedAuto Boolean @default(false)

  /// The original capture. Never overwritten: the spec requires it to survive
  /// every later correction, and for consent it stays the authoritative artefact.
  originalKey      String
  originalSha256   String
  originalBytes    Int
  originalMimeType String
  /// What the recogniser actually saw, kept so a disputed reading can be traced.
  processedKey     String?

  status    String @default("PENDING")
  pageCount Int    @default(1)

  /// Null until an engine has run. Nullable rather than 0 on purpose: absent
  /// confidence and zero confidence must not render the same way.
  overallConfidence Float?
  imageQualityScore Int?

  requiresReview Boolean @default(true)
  reviewReason   String?

  capturedById String
  capturedAt   DateTime  @default(now())
  verifiedById String?
  verifiedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  patient    Patient? @relation(fields: [patientId], references: [id], onDelete: Restrict)
  surgery    Surgery? @relation(fields: [surgeryId], references: [id], onDelete: Restrict)
  capturedBy User     @relation("OcrCapturedBy", fields: [capturedById], references: [id], onDelete: Restrict)
  verifiedBy User?    @relation("OcrVerifiedBy", fields: [verifiedById], references: [id], onDelete: Restrict)

  pages              OcrPage[]
  tokens             OcrToken[]
  runs               OcrProviderRun[]
  versions           OcrVersion[]
  verifications      OcrVerification[]
  qualityAssessments OcrQualityAssessment[]
  signatureRegions   OcrSignatureRegion[]

  syncVersion Int     @default(0) @map("sync_version")
  syncOrigin  String? @map("sync_origin")
  syncHlc     String? @map("sync_hlc")

  @@index([patientId])
  @@index([surgeryId])
  @@index([status])
  @@index([originalSha256, patientId])
  @@map("ocr_documents")
}

/// One row per engine run, never replaced. Provider comparison needs several
/// runs on the same document, and local vs cloud results must be shown side by
/// side rather than the later one silently overwriting the earlier.
model OcrProviderRun {
  id            String    @id @default(uuid())
  documentId    String
  provider      String
  modelVersion  String?
  startedAt     DateTime  @default(now())
  completedAt   DateTime?
  durationMs    Int?
  status        String    @default("RUNNING")
  failureReason String?
  confidence    Float?
  /// The engine's own output, untouched, kept separate from the verified
  /// transcription so the two can never be mistaken for one another.
  rawText       String?
  rawPayload    Json?
  isPrimary     Boolean   @default(false)

  document OcrDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  tokens   OcrToken[]

  syncVersion Int     @default(0) @map("sync_version")
  syncOrigin  String? @map("sync_origin")
  syncHlc     String? @map("sync_hlc")

  @@index([documentId])
  @@map("ocr_provider_runs")
}

model OcrPage {
  id          String  @id @default(uuid())
  documentId  String
  pageNumber  Int
  imageKey    String?
  width       Int?
  height      Int?
  rotation    Int     @default(0)
  confidence  Float?
  /// PRINTED | HANDWRITTEN | MIXED | UNKNOWN
  contentKind String  @default("UNKNOWN")

  document   OcrDocument          @relation(fields: [documentId], references: [id], onDelete: Cascade)
  tokens     OcrToken[]
  signatures OcrSignatureRegion[]

  syncVersion Int     @default(0) @map("sync_version")
  syncOrigin  String? @map("sync_origin")
  syncHlc     String? @map("sync_hlc")

  @@unique([documentId, pageNumber])
  @@map("ocr_pages")
}

/// The word-level record that lets the system refuse to guess. Each word keeps
/// its own confidence and its own box, so an uncertain word can be highlighted
/// and the clinician shown that exact region of the original image.
model OcrToken {
  id            String    @id @default(uuid())
  documentId    String
  pageId        String
  runId         String?
  lineIndex     Int       @default(0)
  tokenIndex    Int       @default(0)
  text          String
  confidence    Float?
  bboxX         Int?
  bboxY         Int?
  bboxW         Int?
  bboxH         Int?
  isHandwritten Boolean   @default(false)
  isUncertain   Boolean   @default(false)
  uncertainWhy  String?
  /// Alternatives OFFERED, never applied. Clinical context may identify
  /// candidates; it may never select one.
  alternatives  Json?
  isVerified    Boolean   @default(false)
  correctedText String?
  correctedById String?
  correctedAt   DateTime?

  document    OcrDocument     @relation(fields: [documentId], references: [id], onDelete: Cascade)
  page        OcrPage         @relation(fields: [pageId], references: [id], onDelete: Cascade)
  run         OcrProviderRun? @relation(fields: [runId], references: [id], onDelete: SetNull)
  correctedBy User?           @relation("OcrCorrectedBy", fields: [correctedById], references: [id], onDelete: Restrict)

  syncVersion Int     @default(0) @map("sync_version")
  syncOrigin  String? @map("sync_origin")
  syncHlc     String? @map("sync_hlc")

  @@index([documentId])
  @@index([pageId])
  @@map("ocr_tokens")
}

/// Never destroy a previous version.
model OcrVersion {
  id            String   @id @default(uuid())
  documentId    String
  versionNumber Int
  /// RAW_OCR | CLINICIAN_CORRECTION | VERIFIED
  kind          String
  text          String
  confidence    Float?
  authorId      String
  note          String?
  createdAt     DateTime @default(now())

  document      OcrDocument       @relation(fields: [documentId], references: [id], onDelete: Cascade)
  author        User              @relation("OcrVersionAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  verifications OcrVerification[]

  syncVersion Int     @default(0) @map("sync_version")
  syncOrigin  String? @map("sync_origin")
  syncHlc     String? @map("sync_hlc")

  @@unique([documentId, versionNumber])
  @@map("ocr_versions")
}

model OcrVerification {
  id                 String   @id @default(uuid())
  documentId         String
  versionId          String?
  verifiedById       String
  verifiedAt         DateTime @default(now())
  /// ACCEPTED | CORRECTED | REJECTED | MARKED_ILLEGIBLE
  outcome            String
  tokensReviewed     Int      @default(0)
  tokensCorrected    Int      @default(0)
  /// High-risk values need explicit confirmation. Keeping the count and the
  /// categories means an audit can show what the clinician was actually asked
  /// to confirm, not merely that they clicked.
  highRiskConfirmed  Int      @default(0)
  highRiskCategories String?
  note               String?
  ipAddress          String?

  document   OcrDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  version    OcrVersion? @relation(fields: [versionId], references: [id], onDelete: SetNull)
  verifiedBy User        @relation("OcrVerificationBy", fields: [verifiedById], references: [id], onDelete: Restrict)

  syncVersion Int     @default(0) @map("sync_version")
  syncOrigin  String? @map("sync_origin")
  syncHlc     String? @map("sync_hlc")

  @@index([documentId])
  @@map("ocr_verifications")
}

/// Kept per attempt, including rejected ones: how often capture fails and why
/// is what tells us whether to fix the guidance or the recogniser.
model OcrQualityAssessment {
  id              String   @id @default(uuid())
  documentId      String?
  capturedById    String
  score           Int
  sharpness       Int?
  exposure        Int?
  contrast        Int?
  glare           Int?
  skewDegrees     Float?
  resolutionPx    Int?
  cornersDetected Int?
  failedChecks    String?
  /// True when the user was warned and chose "Proceed anyway".
  proceededAnyway Boolean  @default(false)
  createdAt       DateTime @default(now())

  document   OcrDocument? @relation(fields: [documentId], references: [id], onDelete: Cascade)
  capturedBy User         @relation("OcrQualityCapturedBy", fields: [capturedById], references: [id], onDelete: Restrict)

  syncVersion Int     @default(0) @map("sync_version")
  syncOrigin  String? @map("sync_origin")
  syncHlc     String? @map("sync_hlc")

  @@map("ocr_quality_assessments")
}

/// Recorded as present and located, NEVER transcribed into clinical text.
model OcrSignatureRegion {
  id         String   @id @default(uuid())
  documentId String
  pageId     String
  /// SIGNATURE | STAMP | INITIALS
  kind       String
  bboxX      Int
  bboxY      Int
  bboxW      Int
  bboxH      Int
  confidence Float?
  createdAt  DateTime @default(now())

  document OcrDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  page     OcrPage     @relation(fields: [pageId], references: [id], onDelete: Cascade)

  syncVersion Int     @default(0) @map("sync_version")
  syncOrigin  String? @map("sync_origin")
  syncHlc     String? @map("sync_hlc")

  @@index([documentId])
  @@map("ocr_signature_regions")
}
