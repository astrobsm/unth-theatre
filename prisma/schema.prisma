model User {
  id                    String               @id @default(uuid())
  staffId               String?              @unique
  username              String               @unique
  email                 String?              @unique
  password              String
  fullName              String
  role                  UserRole
  status                UserStatus           @default(PENDING)
  phoneNumber           String?
  extension             String? // Internal theatre extension / bleep for roster contact display
  department            String?
  staffCode             String?              @unique // Code for cleaners, porters, and other staff to log duties
  // Live staff availability (P3 workforce board). A single current snapshot per
  // user; self-set or admin-overridden. AVAILABLE | BUSY | IN_THEATRE |
  // TRANSPORTING_PATIENT | PREPARING_THEATRE | CLEANING_THEATRE |
  // ON_EMERGENCY_CASE | BREAK | OFF_DUTY | ON_LEAVE | UNAVAILABLE
  availabilityStatus    String?
  availabilityNote      String? // current assignment / free note
  currentLocation       String?
  availabilityUpdatedAt DateTime?
  // Where that location actually is, when the device gave a fix. Written only
  // when the staff member publishes their OWN status — never in the background,
  // and never by an admin setting somebody else's availability.
  currentLatitude       Float?
  currentLongitude      Float?
  /// Metres. Carried so a poor fix can be shown as poor rather than trusted.
  locationAccuracyM     Float?
  /// When the DEVICE took the fix. A ping queued offline arrives much later,
  /// so this differs from availabilityUpdatedAt and is what freshness is
  /// judged against.
  locationCapturedAt    DateTime?
  locationSource        StaffLocationSource?
  resetToken            String? // Password reset token
  resetTokenExpiry      DateTime? // Reset token expiration
  isFirstLogin          Boolean              @default(true) // Track if user has logged in before
  mustChangePassword    Boolean              @default(false) // Force password change on next login
  // House Officer rotation tracking (null for non-HOs)
  rotationSpecialty     String? // SURGERY | OBSTETRICS_GYNAECOLOGY | MAXILLOFACIAL | ENT | OTHER
  rotationStartDate     DateTime?
  rotationEndDate       DateTime?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  approvedBy            String?
  approvedAt            DateTime?

  // Relations
  surgeries           Surgery[]             @relation("SurgeonSurgeries")
  assistingSurgeries  Surgery[]             @relation("AssistantSurgeries")
  anesthesiaSurgeries Surgery[]             @relation("AnesthetistSurgeries")
  teamMemberSurgeries SurgicalTeamMember[]  @relation("TeamMemberSurgeries")
  transfers           PatientTransfer[]
  cancellations       CaseCancellation[]
  maintenanceLogs     MaintenanceLog[]
  auditLogs           AuditLog[]
  whoChecklists       WHOChecklist[]        @relation("WHOChecklists")
  theatreSetups       TheatreSetup[]
  setupReturns        TheatreSetupReturn[]
  extraRequests       TheatreExtraRequest[]

  // Theatre Allocation Staff Relations
  scrubNurseAllocations                  TheatreAllocation[] @relation("ScrubNurseAllocations")
  circulatingNurseAllocations            TheatreAllocation[] @relation("CirculatingNurseAllocations")
  anaestheticTechnicianAllocations       TheatreAllocation[] @relation("AnaestheticTechnicianAllocations")
  anaesthetistConsultantAllocations      TheatreAllocation[] @relation("AnaesthetistConsultantAllocations")
  anaesthetistSeniorRegistrarAllocations TheatreAllocation[] @relation("AnaesthetistSeniorRegistrarAllocations")
  anaesthetistRegistrarAllocations       TheatreAllocation[] @relation("AnaesthetistRegistrarAllocations")
  cleanerAllocations                     TheatreAllocation[] @relation("CleanerAllocations")
  porterAllocations                      TheatreAllocation[] @relation("PorterAllocations")

  // Staff Duty Tracking Relations
  cleaningLogs         TheatreCleaningLog[]
  transportLogs        PatientTransportLog[]
  dutyLogs             StaffDutyLog[]
  technicianSetupLogs  AnesthesiaSetupLog[]  @relation("TechnicianSetupLogs")
  rosterAssignments    Roster[]
  storeKeeperCheckouts EquipmentCheckout[]   @relation("StoreKeeperCheckouts")
  reportedFaults       EquipmentFaultAlert[] @relation("ReportedFaults")

  // Pre-Operative Review & Prescription Relations
  anesthetistReviews      PreOperativeAnestheticReview[] @relation("AnesthetistReviews")
  consultantReviews       PreOperativeAnestheticReview[] @relation("ConsultantReviews")
  prescribedPrescriptions AnestheticPrescription[]       @relation("PrescribedBy")
  approvedPrescriptions   AnestheticPrescription[]       @relation("ApprovedBy")
  packedPrescriptions     AnestheticPrescription[]       @relation("PackedBy")

  // Blood Request Relations
  bloodRequestsRequested    BloodRequest[] @relation("BloodRequestedBy")
  bloodRequestsAcknowledged BloodRequest[] @relation("BloodAcknowledgedBy")
  bloodRequestsPrepared     BloodRequest[] @relation("BloodPreparedBy")

  // Emergency Alert Relations
  surgeonEmergencyAlerts     EmergencySurgeryAlert[] @relation("SurgeonEmergencyAlerts")
  anesthetistEmergencyAlerts EmergencySurgeryAlert[] @relation("AnesthetistEmergencyAlerts")
  notifications              Notification[]

  // Emergency Booking Relations
  emergencyBookingsAsSurgeon     EmergencySurgeryBooking[] @relation("EmergencyBookingSurgeon")
  emergencyBookingsAsAnesthetist EmergencySurgeryBooking[] @relation("EmergencyBookingAnesthetist")

  // CSSD Relations
  cssdInventoryUpdates      CssdInventory[]
  cssdUsageIssued           CssdUsageHistory[]     @relation("IssuedBy")
  cssdUsageReturned         CssdUsageHistory[]     @relation("ReturnedBy")
  cssdSterilizationLogs     CssdSterilizationLog[]
  cssdSterilizationVerified CssdSterilizationLog[] @relation("VerifiedBy")
  cssdReadinessReports      CssdReadinessReport[]
  cssdReadinessApproved     CssdReadinessReport[]  @relation("ApprovedBy")

  // Power House Relations
  powerHouseStatus           PowerHouseStatus[]
  powerFuelConsumption       PowerFuelConsumption[]
  powerMaintenanceLogs       PowerMaintenanceLog[]
  powerMaintenanceSupervised PowerMaintenanceLog[]  @relation("Supervisor")
  powerReadinessReports      PowerReadinessReport[]
  powerReadinessApproved     PowerReadinessReport[] @relation("ApprovedBy")

  // Incident Report Relations
  incidentsReported     IncidentReport[] @relation("IncidentReporter")
  incidentsInvestigated IncidentReport[] @relation("IncidentInvestigator")
  incidentsVerified     IncidentReport[] @relation("IncidentVerifier")

  // Laundry Relations
  laundryReadinessReports LaundryReadiness[]

  // Water Supply Relations
  waterSupplyLogs WaterSupplyLog[]

  // Theatre Sub-Store Relations
  subStoresManaged         TheatreSubStore[]        @relation("SubStoreManager")
  subStoresMorningCheck    TheatreSubStore[]        @relation("MorningCheck")
  subStoresEndOfDayCheck   TheatreSubStore[]        @relation("EndOfDayCheck")
  subStoreUsagesLogged     SubStoreUsageLog[]       @relation("UsageLoggedBy")
  subStoreUsagesVerified   SubStoreUsageLog[]       @relation("UsageVerifiedBy")
  restockRequestsRequested SubStoreRestockRequest[] @relation("RestockRequester")
  restockRequestsApproved  SubStoreRestockRequest[] @relation("RestockApprover")
  restockRequestsFulfilled SubStoreRestockRequest[] @relation("RestockFulfiller")

  // Stock Transfer Relations
  stockTransfersRequested StockTransfer[] @relation("TransferRequester")
  stockTransfersApproved  StockTransfer[] @relation("TransferApprover")
  stockTransfersIssued    StockTransfer[] @relation("TransferIssuer")
  stockTransfersReceived  StockTransfer[] @relation("TransferReceiver")

  // Pre-operative Investigation Relations
  investigationsRequested PreoperativeInvestigation[] @relation("InvestigationRequester")
  samplesCollected        PreoperativeInvestigation[] @relation("SampleCollector")
  resultsVerified         PreoperativeInvestigation[] @relation("ResultsVerifier")

  // Theatre Meal Relations
  theatreMeals  TheatreMeal[]
  mealsPrepared TheatreMeal[] @relation("MealPreparer")

  // Meal Menu / Ordering Relations
  mealMenuItemsCreated MealMenuItem[] @relation("MealMenuItemCreator")
  mealOrders           MealOrder[]    @relation("MealOrderRequester")
  mealOrdersVerified   MealOrder[]    @relation("MealOrderPaymentVerifier")
  mealOrdersDelivered  MealOrder[]    @relation("MealOrderDeliveredBy")

  // Oxygen Control Room Relations
  oxygenReadinessReports   OxygenReadinessReport[]
  oxygenReportsVerified    OxygenReadinessReport[] @relation("OxygenReportVerifier")
  oxygenAlertsTriggered    OxygenAlert[]           @relation("OxygenAlertTriggerer")
  oxygenAlertsAcknowledged OxygenAlert[]           @relation("OxygenAlertAcknowledger")
  oxygenAlertsResponded    OxygenAlert[]           @relation("OxygenAlertResponder")
  oxygenAlertsResolved     OxygenAlert[]           @relation("OxygenAlertResolver")

  // Disciplinary Query Relations
  disciplinaryQueriesReceived DisciplinaryQuery[] @relation("QueryRecipient")
  disciplinaryQueriesIssued   DisciplinaryQuery[] @relation("QueryIssuer")

  // Emergency Team Availability Relations
  emergencyTeamAvailability EmergencyTeamAvailability[]

  // Emergency Pre-Anaesthetic Review Relations
  emergencyPreAnaestheticReviews   EmergencyPreAnaestheticReview[] @relation("EmergencyReviewer")
  emergencyPreAnaestheticApprovals EmergencyPreAnaestheticReview[] @relation("EmergencyReviewApprover")
  emergencyPrescriptionsPacked     EmergencyPrescription[]         @relation("EmergencyPrescriptionPacker")

  // Announcement Relations
  announcementsCreated Announcement[] @relation("AnnouncementCreator")

  // Call for Patient Relations
  callUpsInvited  PatientCallUp[] @relation("CallUpInviter")
  callUpsRejected PatientCallUp[] @relation("CallUpRejecter")

  // Pre-Operative Visit Relations
  preOperativeVisits PreOperativeVisit[] @relation("PreOpVisitor")

  // Medication Tracking Relations
  medsCollected                     MedicationCollection[]        @relation("MedicationCollector")
  medsDispensed                     MedicationCollection[]        @relation("MedicationDispenser")
  reconciliationsPerformed          MedicationReconciliation[]    @relation("ReconciliationUser")
  medsReturned                      MedicationReturn[]            @relation("MedicationReturner")
  medsReceived                      MedicationReturn[]            @relation("MedicationReceiver")
  additionalMedRequestsMade         AdditionalMedicationRequest[] @relation("AdditionalMedRequester")
  additionalMedRequestsAcknowledged AdditionalMedicationRequest[] @relation("AdditionalMedAcknowledger")
  additionalMedRequestsPacked       AdditionalMedicationRequest[] @relation("AdditionalMedPacker")
  medQueriesReceived                MedicationNonReturnQuery[]    @relation("QueriedUser")
  medQueriesIssued                  MedicationNonReturnQuery[]    @relation("QueryIssuer")

  // Emergency Lab Workup Relations
  emergencyLabRequests     EmergencyLabRequest[] @relation("EmergencyLabRequester")
  emergencyLabAcknowledged EmergencyLabRequest[] @relation("EmergencyLabAcknowledger")
  labSamplesCollected      EmergencyLabTest[]    @relation("LabSampleCollector")
  labSamplesReceived       EmergencyLabTest[]    @relation("LabSampleReceiver")
  labResultsEntered        EmergencyLabTest[]    @relation("LabResultEnterer")
  labResultsVerified       EmergencyLabTest[]    @relation("LabResultVerifier")

  // Plumbing & Water Supply Relations
  plumbingFaultsReported     PlumbingFault[]        @relation("PlumbingFaultReporter")
  plumbingFaultsAssigned     PlumbingFault[]        @relation("PlumbingFaultAssignee")
  plumbingFaultsAcknowledged PlumbingFault[]        @relation("PlumbingFaultAcknowledger")
  plumbingFaultsResolved     PlumbingFault[]        @relation("PlumbingFaultResolver")
  plumbingWaterStatuses      PlumbingWaterStatus[]  @relation("PlumbingStatusLogger")
  waterSupplyReadinessLogs   WaterSupplyReadiness[] @relation("WaterReadinessLogger")

  // Nurse Handover Relations
  handoversGiven     NurseHandover[] @relation("HandingOverNurse")
  handoversReceived  NurseHandover[] @relation("ReceivingNurse")
  handoversWitnessed NurseHandover[] @relation("WitnessNurse")

  // Module access grants (per-user overrides issued by admins)
  moduleGrants UserModuleGrant[] @relation("UserGrants")
  grantsIssued UserModuleGrant[] @relation("GrantedByUser")

  // Pre-pack & post-op pharmacy back-relations
  consumablePacks     SurgeryConsumableRequest[]   @relation("ConsumablePackedBy")
  consumableRequested SurgeryConsumableRequest[]   @relation("ConsumableRequestedBy")
  drugDressingPacks   SurgeryDrugDressingRequest[] @relation("DrugDressingPackedBy")
  postOpRxPrescribed  PostOpPrescription[]         @relation("PostOpPrescribedBy")
  postOpRxPacked      PostOpPrescription[]         @relation("PostOpPackedBy")

  // ---------------------------------------------------------------------
  // Imprest Management and Retirement System
  // ---------------------------------------------------------------------
  // The imprest system has no accounts of its own: this IS the imprest user.
  // The duty that governs the approval chain (cashier, account officer,
  // chairman…) is assigned separately in ImprestRoleAssignment, because it is
  // independent of a clinical role — the cashier may well be a nurse.
  imprestRoles               ImprestRoleAssignment[] @relation("ImprestRoleAssignments")
  imprestsReceived           Imprest[]               @relation("ImprestImprestReceivingOfficer")
  imprestExpenditures        Expenditure[]           @relation("ImprestExpenditureOfficer")
  imprestAttachments         Attachment[]            @relation("ImprestAttachmentOwner")
  imprestRetirementsPrepared Retirement[]            @relation("ImprestRetirementPreparer")
  imprestRetirementsChecked  Retirement[]            @relation("ImprestRetirementChecker")
  imprestRetirementsApproved Retirement[]            @relation("ImprestRetirementApprover")
  imprestApprovalsActed      Approval[]              @relation("ImprestApprovalActor")
  imprestSignatures          Signature[]
  imprestSignatories         ApprovalSignatory[]
  imprestAuditLogs           ImprestAuditLog[]
  imprestNotifications       ImprestNotification[]

  stockMovements    StockMovement[]    @relation("StockMovementActor")
  stockReservations StockReservation[] @relation("StockReservationRequester")

  locationPings StaffLocationPing[] @relation("StaffLocationPings")

  delaysReported TheatreDelayRecord[] @relation("DelayReporter")

  /// Sync metadata, maintained by the capture trigger in the sync migration.
  /// Declared here ONLY so `prisma migrate diff` does not read these columns as
  /// drift and generate a DROP for them. Application code must never write
  /// them: the trigger owns them.
  syncVersion         Int                    @default(0) @map("sync_version")
  syncOrigin          String?                @map("sync_origin")
  syncHlc             String?                @map("sync_hlc")
  ocrCaptured         OcrDocument[]          @relation("OcrCapturedBy")
  ocrVerified         OcrDocument[]          @relation("OcrVerifiedBy")
  ocrTokenCorrections OcrToken[]             @relation("OcrCorrectedBy")
  ocrVersionsAuthored OcrVersion[]           @relation("OcrVersionAuthor")
  ocrVerifications    OcrVerification[]      @relation("OcrVerificationBy")
  ocrQualityCaptures  OcrQualityAssessment[] @relation("OcrQualityCapturedBy")

  @@map("users")
}

// Per-user module access grants. Each row is an admin-issued override that
// adds a module to a user's allowed set, on top of their role's defaults.
model UserModuleGrant {
  id          String   @id @default(uuid())
  userId      String
  moduleId    String
  grantedById String?
  grantedAt   DateTime @default(now())

  user        User    @relation("UserGrants", fields: [userId], references: [id], onDelete: Cascade)
  grantedBy   User?   @relation("GrantedByUser", fields: [grantedById], references: [id], onDelete: SetNull)
  /// Sync metadata, maintained by the capture trigger in the sync migration.
  /// Declared here ONLY so `prisma migrate diff` does not read these columns as
  /// drift and generate a DROP for them. Application code must never write
  /// them: the trigger owns them.
  syncVersion Int     @default(0) @map("sync_version")
  syncOrigin  String? @map("sync_origin")
  syncHlc     String? @map("sync_hlc")

  @@unique([userId, moduleId])
  @@index([userId])
  @@map("user_module_grants")
}

// Public staff onboarding form submissions. Anyone with the share link can
// submit; an admin reviews + clicks "Import" to push selected entries through
// the existing /api/users/bulk-upload pipeline.
model OnboardingSubmission {
  id                String    @id @default(uuid())
  fullName          String
  username          String
  email             String?
  role              String // Stored as plain string so the form's role list can
  // be validated independently of the Prisma enum.
  phoneNumber       String?
  department        String?
  staffCode         String?
  staffId           String?
  title             String? // Dr / Mr / Mrs / Prof / etc.
  notes             String?
  isContractStaff   Boolean   @default(false) // Contract staff are exempt from Staff ID requirement
  // House Officer rotation details (only meaningful when role = HOUSE_OFFICER)
  rotationSpecialty String? // SURGERY | OBSTETRICS_GYNAECOLOGY | MAXILLOFACIAL | ENT | OTHER
  rotationStartDate DateTime?
  rotationEndDate   DateTime?
  status            String    @default("PENDING") // PENDING | IMPORTED | REJECTED
  importedAt        DateTime?
  importedBy        String?
  importError       String?
  ipAddress         String?
  userAgent         String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  /// Sync metadata, maintained by the capture trigger in the sync migration.
  /// Declared here ONLY so `prisma migrate diff` does not read these columns as
  /// drift and generate a DROP for them. Application code must never write
  /// them: the trigger owns them.
  syncVersion       Int       @default(0) @map("sync_version")
  syncOrigin        String?   @map("sync_origin")
  syncHlc           String?   @map("sync_hlc")

  @@index([status])
  @@index([createdAt])
  @@map("onboarding_submissions")
}

model Roster {
  id             String        @id @default(uuid())
  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  staffName      String // Name from Excel upload
  staffCategory  StaffCategory // NURSES, ANAESTHETISTS, PORTERS, CLEANERS, ANAESTHETIC_TECHNICIANS, PHARMACISTS, RECOVERY_NURSES
  seniorityLevel String? // For ANAESTHETISTS / ANAESTHETIC_TECHNICIANS: CONSULTANT, SENIOR_REGISTRAR, REGISTRAR
  subRole        String? // For NURSES: SCRUB, CIRCULATING, HOLDING_AREA, SUPERVISING
  location       String? // MAIN_THEATRE | A_AND_E (defaults to MAIN_THEATRE in app)
  date           DateTime      @db.Date
  theatreId      String?
  theatre        TheatreSuite? @relation(fields: [theatreId], references: [id], onDelete: SetNull)
  shift          DutyShift // MORNING, CALL, NIGHT
  uploadedBy     String
  uploadedAt     DateTime      @default(now())
  notes          String?       @db.Text

  // Draft/publish governance (department roster pages). Existing rows default to
  // PUBLISHED so all current consumers (on-duty, booking auto-assign, meals, …)
  // keep working; only new department-page drafts are DRAFT until published.
  status         String  @default("PUBLISHED") // DRAFT | PUBLISHED
  publicationId  String? // the RosterPublication this row was published under
  version        Int? // publication version number
  // A PUBLISHED row staged for removal: stays live (visible to on-duty) until the
  // next Publish, which deletes it. Lets published rosters be edited draft-style.
  pendingRemoval Boolean @default(false)
  /// Sync metadata, maintained by the capture trigger in the sync migration.
  /// Declared here ONLY so `prisma migrate diff` does not read these columns as
  /// drift and generate a DROP for them. Application code must never write
  /// them: the trigger owns them, and an app-supplied value would break the
  /// version chain conflict detection depends on.
  syncVersion    Int     @default(0) @map("sync_version")
  syncOrigin     String? @map("sync_origin")
  syncHlc        String? @map("sync_hlc")

  @@index([date, theatreId, shift])
  @@index([staffCategory, date])
  @@index([location, date])
  @@index([status, date])
  @@map("rosters")
}

// A published snapshot of one department's roster for a period. Enables version
// history and rollback. Publishing flips that department/period's DRAFT rows to
// PUBLISHED and records an immutable JSON snapshot here; rollback recreates rows
// from a chosen version's snapshot.
// Idempotency guard for offline-queued writes. The client attaches a stable
// X-Idempotency-Key to each mutation (first attempt + every replay); routes that
// opt in store the first successful response here and return it verbatim on any
// replay, so reconnect-sync can never double-create a record.
model IdempotencyKey {
  key            String   @id
  responseStatus Int
  responseBody   String   @db.Text
  route          String?
  createdAt      DateTime @default(now())
  /// Sync metadata, maintained by the capture trigger in the sync migration.
  /// Declared here ONLY so `prisma migrate diff` does not read these columns as
  /// drift and generate a DROP for them. Application code must never write
  /// them: the trigger owns them, and an app-supplied value would break the
  /// version chain conflict detection depends on.
  syncVersion    Int      @default(0) @map("sync_version")
  syncOrigin     String?  @map("sync_origin")
  syncHlc        String?  @map("sync_hlc")

  @@index([createdAt])
  @@map("idempotency_keys")
}

