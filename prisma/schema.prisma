model Attachment {
  id       String         @id @default(uuid()) @db.Uuid
  kind     AttachmentKind @default(RECEIPT)
  fileName String
  mimeType String
  byteSize Int
  /// SHA-256 of the stored bytes — detects tampering, de-duplicates uploads.
  checksum String

  /// The imprest system stored bytes in an object store and kept only a key.
  /// This app keeps uploaded evidence as a base64 data URL in a text column —
  /// the same convention as consent scans and incident media — because that is
  /// what survives the offline queue: a data URL is JSON, so a receipt captured
  /// with no network queues and replays like any other field. `storageKey` is
  /// retained (now optional) so a later move to object storage is not blocked.
  dataUrl             String? @db.Text
  storageKey          String?
  thumbnailStorageKey String?

  expenditureId String?      @db.Uuid
  expenditure   Expenditure? @relation("ImprestAttachmentExpenditure", fields: [expenditureId], references: [id], onDelete: Cascade)
  imprestId     String?      @db.Uuid
  imprest       Imprest?     @relation("ImprestAttachmentImprest", fields: [imprestId], references: [id], onDelete: Cascade)
  retirementId  String?      @db.Uuid
  retirement    Retirement?  @relation("ImprestAttachmentRetirement", fields: [retirementId], references: [id], onDelete: Cascade)
  userId        String?
  user          User?        @relation("ImprestAttachmentOwner", fields: [userId], references: [id], onDelete: Cascade)

  width      Int?
  height     Int?
  rotation   Int       @default(0)
  capturedAt DateTime?

  /// Reserved for the OCR pipeline; the architecture is in place, extraction
  /// is a pluggable step that populates these two columns.
  ocrText        String?
  ocrProcessedAt DateTime?

  caption String?

  version        Int       @default(1)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  createdById    String?
  updatedById    String?
  deletedAt      DateTime?
  deletedById    String?
  deletionReason String?

  @@index([expenditureId])
  @@index([imprestId])
  @@index([retirementId])
  @@index([checksum])
  @@index([deletedAt])
  @@index([updatedAt])
  @@map("imprest_attachments")
}

model Retirement {
