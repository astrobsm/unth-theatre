# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local
.env

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
build-log2.txt

upload-music.log
upload-music-retry.log

# User-data exports (PII - never commit)
exports/

# Native / desktop wrappers (generated + build outputs)
/android
/ios
desktop/node_modules
desktop/release
desktop/dist

.env.test

# Local scratch: dry-run scripts and build logs, never part of the app.
.tmp-test/

# Maintenance backups: JSON snapshots of rows before destructive operations.
# Local safety net, not repository content.
.maintenance-backups/

# Tesseract OCR assets — fetched at build time by
# scripts/maintenance/fetch-tesseract-assets.js. ~10 MB of binaries that would
# otherwise sit in every clone and every diff for no benefit.
/public/tesseract/

# tesseract.js extracts training data beside the process; not source
eng.traineddata
.ocrcache-*

# Benchmark scratch — per-engine tesseract model caches
.ocr-bench-cache/

# One-off screenshot helper with machine-specific absolute paths.
scripts/retry-shots.js

# Backups of env files. These hold real database passwords, and an untracked
# one is a single "git add -A" away from being published.
.env.bak-*
.env.*.bak

# Built APKs. Binaries do not belong in git history — they would add ~4 MB
# per release for ever, and on this connection the push times out at 408.
# Published separately; see scripts/mobile/build-apk.sh.
public/downloads/*.apk

# Derived from assets/logo.png by scripts/mobile/make-icons.*, which
# build-apk.sh runs. Committing them beside their source duplicates 2.6 MB of
# binary that quietly stops matching the logo it came from.
/assets/icon.png
/assets/icon-foreground.png
/assets/icon-background.png
/assets/splash.png
/assets/splash-dark.png

# The executive-accounts input names real officers; see
# scripts/create-executive-accounts.ts. Never commit it.
executive-accounts*.json
people.json
