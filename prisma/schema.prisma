  closingRemarks String?
  closedAt       DateTime?
  cancelledAt    DateTime?

  expenditures Expenditure[]
  retirements  Retirement[]
  attachments  Attachment[]  @relation("ImprestAttachmentImprest")

  version        Int       @default(1)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  createdById    String?
  updatedById    String?
  deletedAt      DateTime?
  deletedById    String?
  deletionReason String?

  @@index([status])
  @@index([financialYearId])
  @@index([departmentId])
  @@index([receivingOfficerId])
  @@index([expectedRetirementDate])
  @@index([deletedAt])
  @@index([updatedAt])
