model Surgery {
  id                   String                 @id @default(uuid())
  patientId            String
  surgeonId            String?
  surgeonName          String? // Direct entry of surgeon name
  assistantSurgeonId   String?
  anesthetistId        String?
  scrubNurseId         String?
  theatreTechnicianId  String? // Assigned anaesthetic technician (soft ref to User.id, no FK to keep migration safe)
  subspecialty         String
  unit                 String // Surgical unit/department
  location             String? // Operating location/complex (e.g., Professor Ojukwu Theatre Complex, Eye Theatre, A&E, Cardiothoracic Centre)
  theatreId            String? // Optional FK-style id of the chosen TheatreSuite (string match, no FK to keep migration safe)
  indication           String // Clinical indication
  procedureName        String
  scheduledDate        DateTime
  scheduledTime        String
  /// Further procedures in the same operation, newline-separated. A tumour
  /// resection with a skin graft is one case with two procedures; the packs for
  /// each are merged, taking the HIGHER quantity rather than the sum.
  additionalProcedures String?
  estimatedDuration    Int                    @default(60) // Estimated duration in minutes
  status               SurgeryStatus          @default(SCHEDULED)
  surgeryType          SurgeryType            @default(ELECTIVE)
  // Operative magnitude: MAJOR | INTERMEDIATE | MINOR. Nullable so existing
  // rows migrate cleanly; captured at booking and used to scale the mandatory
  // base consumable pack (gauze bundle, glove/gown counts, etc.).
  magnitude            String?
  readinessStatus      SurgeryReadinessStatus @default(PENDING_CHECKS)

  // Anesthesia
  anesthesiaType AnesthesiaType?

  // Requirements
  needICU                 Boolean @default(false)
  needBloodTransfusion    Boolean @default(false)
  needDiathermy           Boolean @default(false)
  needStereo              Boolean @default(false)
  needMontrellMattress    Boolean @default(false)
  needStirups             Boolean @default(false)
  needPneumaticTourniquet Boolean @default(false)
  needCArm                Boolean @default(false)
  needMicroscope          Boolean @default(false)
  needSuction             Boolean @default(false)
  otherSpecialNeeds       String?
  remarks                 String?

  // ── Compulsory pre-operative safety labs & assessments (captured at booking) ──
  // Nullable in the DB so existing rows migrate cleanly; the booking form and the
  // POST /api/surgeries Zod schema enforce them as required for new bookings.
  recentHb                   Float? // Haemoglobin g/dL — sample within 48 h of surgery
  hbSampleAt                 DateTime? // When the Hb sample was drawn (drives the 48 h rule)
  potassium                  Float? // Serum K+ mmol/L
  sodium                     Float? // Serum Na+ mmol/L
  creatinine                 Float? // Serum creatinine µmol/L
  hbsAgStatus                String? // NEGATIVE | POSITIVE | PENDING | NOT_DONE
  hcvStatus                  String? // NEGATIVE | POSITIVE | PENDING | NOT_DONE
  hivStatus                  String? // NEGATIVE | POSITIVE | PENDING | NOT_DONE
  bloodPressureSystolic      Int? // mmHg
  bloodPressureDiastolic     Int? // mmHg
  // Risk assessments — bleeding & nutrition compulsory for all; pressure-sore
  // compulsory for patients older than 45 (enforced on the booking form).
  bleedingRiskLevel          String? // LOW | MODERATE | HIGH
  nutritionalStatusAtBooking String? // GOOD | FAIR | POOR
  pressureSoreRiskAtBooking  String? // LOW | MEDIUM | HIGH (age > 45)

  // Costs
  totalItemsCost   Decimal? @db.Decimal(10, 2)
  patientCharge    Decimal? @db.Decimal(10, 2)
  depositAmount    Decimal? @db.Decimal(10, 2)
  depositConfirmed Boolean  @default(false)

  // Timing
  knifeOnSkinTime DateTime?
  surgeryEndTime  DateTime?
  completedAt     DateTime?
  actualStartTime DateTime?
  actualEndTime   DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Surgical Complexity Score (captured at the end of the post-operative note).
  // complexityData holds the raw 8-criteria JSON; score is the 0-100 weighted
  // result and complexityClass the derived band (Minor/Intermediate/Major/Supermajor).
  complexityScore      Int?
  complexityClass      String?
  complexityData       String?   @db.Text
  complexityAssessedAt DateTime?
  complexityAssessedBy String?

  // Post-operative disposition planned at booking.
  // postOpDestination: where the patient goes after surgery (General Ward, ICU,
  // HDU, Day-case discharge, Other). isDayCase flags a same-day discharge case.
  postOpDestination String?
  isDayCase         Boolean @default(false)

  // Manual ordering of a unit's cases within the booked-surgery list. Lower =
  // earlier. Null falls back to scheduledTime. Surgeons/nurses set this via the
  // up/down controls on the surgery list.
  listOrder Int?

  // Unit supervising consultant (chosen from surgeons). Displayed as a caption
  // beside the theatre / unit on booked-surgery views.
  supervisingConsultantId   String?
  supervisingConsultantName String?

  // Relations
  patient               Patient                     @relation(fields: [patientId], references: [id])
  surgeon               User?                       @relation("SurgeonSurgeries", fields: [surgeonId], references: [id])
  assistantSurgeon      User?                       @relation("AssistantSurgeries", fields: [assistantSurgeonId], references: [id])
  anesthetist           User?                       @relation("AnesthetistSurgeries", fields: [anesthetistId], references: [id])
  items                 SurgeryItem[]
  whoChecklists         WHOChecklist[]
  cancellation          CaseCancellation?
  mortality             Mortality?
  consumptions          ConsumableConsumption[]
  movements             PatientMovement[]
  safetyCheck           PreoperativeSafetyCheck?
  holdingAreaAssessment HoldingAreaAssessment?
  intraOperativeRecord  IntraOperativeRecord?
  pacuAssessment        PACUAssessment?
  surgicalTiming        SurgicalTiming?
  surgicalCount         SurgicalCountChecklist?
  anesthesiaRecord      AnesthesiaMonitoringRecord?
  teamMembers           SurgicalTeamMember[]
  transportLogs         PatientTransportLog[]

  // New Relations for Enhanced Modules
  preOpReviews     PreOperativeAnestheticReview[] @relation("PreOpReviews")
  prescriptions    AnestheticPrescription[]       @relation("SurgeryPrescriptions")
  bloodRequests    BloodRequest[]                 @relation("SurgeryBloodRequests")
  emergencyAlerts  EmergencySurgeryAlert[]        @relation("EmergencyAlerts")
  cssdUsageHistory CssdUsageHistory[]

  // Pre-operative Investigation Relations
  investigations PreoperativeInvestigation[]

  // Oxygen Alert Relations
  oxygenAlerts OxygenAlert[]

  // Emergency Booking Relation
  emergencyBooking EmergencySurgeryBooking? @relation("EmergencyBookingSurgery")

  // Call for Patient Relations
  patientCallUps PatientCallUp[]

  // Pre-Operative Visit Relations
  preOperativeVisits PreOperativeVisit[]

  // Medication Tracking Relations
  medicationCollections    MedicationCollection[]        @relation("SurgeryMedicationCollections")
  medicationUsageRecords   MedicationUsageRecord[]       @relation("SurgeryMedicationUsage")
  medicationReconciliation MedicationReconciliation?     @relation("SurgeryReconciliation")
  medicationReturns        MedicationReturn[]            @relation("SurgeryMedicationReturns")
  additionalMedRequests    AdditionalMedicationRequest[] @relation("SurgeryAdditionalMedRequests")
  medicationQueries        MedicationNonReturnQuery[]    @relation("SurgeryMedicationQueries")

  // Emergency Lab Workup Relations
  emergencyLabRequests EmergencyLabRequest[] @relation("EmergencyLabWorkupSurgery")

  // Nurse Handover Relations
  nurseHandovers NurseHandover[] @relation("HandoverSurgery")

  // Booking-time pre-pack & post-op pharmacy plan
  consumableRequests   SurgeryConsumableRequest[]   @relation("SurgeryConsumableRequests")
  drugDressingRequests SurgeryDrugDressingRequest[] @relation("SurgeryDrugDressingRequests")
  postOpPrescriptions  PostOpPrescription[]         @relation("PostOpPrescriptionsSurgery")

  // Informed-consent file uploaded at booking; visible to holding-area nurse.
  // After the structured UNTH consent form is completed (electronically signed or
  // a signed paper scanned), the generated/uploaded PDF hard copy is stored here too.
  consentFileName     String?
  consentFileMimeType String?
  consentFileData     String?   @db.Text // base64-encoded file contents
  consentUploadedAt   DateTime?
  consentUploadedById String?

  // Structured UNTH consent form (procedure text, signatures, witness/doctor, etc.).
  // Stored as JSON so the form can be re-opened/edited and the PDF regenerated.
  consentFormData             String?   @db.Text
  consentSignedElectronically Boolean   @default(false)
  consentCompletedAt          DateTime?

  // ── Deferred pre-operative requirements (emergencies only) ────────────────
  // Consent and pre-op labs are mandatory. An ELECTIVE case cannot be booked
  // without them. An EMERGENCY can, because a hard block would mean theatre
  // never hears about the case at all — but only with a named clinician and a
  // reason, recorded here.
  //
  // A deferral is a debt, not a discharge: preopOutstanding holds what is still
  // missing and drives the CONSENT OUTSTANDING flag on the board and in the
  // holding area until somebody clears it.
  preopOverrideReason String?
  preopOverrideById   String?
  preopOverrideByName String?
  preopOverrideAt     DateTime?
  /// Comma-separated MissingItem values, e.g. "CONSENT,HAEMOGLOBIN".
  preopOutstanding    String?

  // Patient-facing codes generated at booking. The surgeon (or anaesthetist)
  // copies these and gives them to the patient, who presents the relevant code
  // to the provider — keying it in reveals exactly what was requested.
  consumablePackCode  String? @unique // Consumable Pack Provider keys this in
  pharmacyDrugCode    String? @unique // Pharmacy keys this in for packing
  anaesthesiaDrugCode String? @unique // Generated after the anaesthetist prescribes

  // Scrub-nurse theatre reception & between-case workflow
  caseFlow TheatreCaseFlow? @relation("SurgeryCaseFlow")

  stockMovements    StockMovement[]    @relation("StockMovementSurgery")
  stockReservations StockReservation[] @relation("StockReservationSurgery")

  invoice Invoice? @relation("InvoiceSurgery")

  delayRecords     TheatreDelayRecord[]     @relation("SurgeryDelayRecords")
  unexplainedDelay TheatreUnexplainedDelay? @relation("SurgeryUnexplainedDelay")
  preopAlert       TheatrePreopAlert?       @relation("SurgeryPreopAlert")
  teamCheckIns     SurgeryTeamCheckIn[]     @relation("SurgeryTeamCheckIns")

  /// Sync metadata, maintained by the capture trigger in the sync migration.
  /// Declared here ONLY so `prisma migrate diff` does not read these columns as
  /// drift and generate a DROP for them. Application code must never write
  /// them: the trigger owns them, and an app-supplied value would break the
  /// version chain conflict detection depends on.
  syncVersion  Int           @default(0) @map("sync_version")
  syncOrigin   String?       @map("sync_origin")
  syncHlc      String?       @map("sync_hlc")
  ocrDocuments OcrDocument[]

  @@map("surgeries")
}

// Scrub / circulating nurse theatre reception and between-case workflow.
// One row per surgery: tracks receiving the patient from the holding area,
// completing the surgery, and the between-case cleaning cycle.
model TheatreCaseFlow {
  id          String  @id @default(uuid())
  surgeryId   String  @unique
  theatreId   String?
  theatreName String?

  // 1. Patient reception (handover from holding area)
  patientReceived   Boolean   @default(false)
  patientReceivedAt DateTime?
  receivedById      String? // scrub nurse who received the patient
  porterNames       String? // JSON array of porter names who brought the patient
  porterIds         String? // JSON array of porter user ids

  // 2. Surgery completion (intra-op count/timing live in their own modules)
  surgeryCompleted     Boolean   @default(false)
  surgeryCompletedAt   DateTime?
  surgeryCompletedById String?

  // 3. Between-case cleaning cycle
  cleaningCalled        Boolean   @default(false)
  cleaningCalledAt      DateTime?
  cleaningCalledById    String?
  cleanersStarted       Boolean   @default(false)
  cleanersStartedAt     DateTime?
  cleanerNames          String? // JSON array of cleaner names
  cleanerIds            String? // JSON array of cleaner user ids
  cleaningCompleted     Boolean   @default(false)
  cleaningCompletedAt   DateTime?
  cleaningCompletedById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  surgery Surgery @relation("SurgeryCaseFlow", fields: [surgeryId], references: [id])

  @@map("theatre_case_flows")
}

model SurgicalTeamMember {
